---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DiscoveryCalendar from "../components/DiscoveryCalendar.astro";
import { recommendations, achievements } from "../data/achievements";
import { languageLevels } from "../data/languages";
import "../styles/growth-platform.css";
import "../styles/about-story.css";

const site = "https://matteoarellano.com";
const canonical = `${site}/about/`;
const title = "About Matteo Arellano | From Finance to Data, Product and Payments";
const description =
  "The story of Matteo Arellano: from Barcelona to Rotterdam School of Management, the European Investment Bank in Luxembourg, five years of finance, data and automation at Cargill, travels in Africa, and product, payments and conversion work in travel tech from Mexico City.";

/**
 * Colleague quotes are looked up from the LinkedIn recommendations, and the
 * build fails if an excerpt is not copied exactly from the original.
 */
const quote = (id: string, text: string) => {
  const rec = recommendations.find((item) => item.id === id);
  if (!rec || !rec.quote.includes(text)) {
    throw new Error(`About page quote is not an exact excerpt from ${id}`);
  }
  return { text, name: rec.name, headline: rec.headline, anchor: `/achievements/#rec-${rec.id}` };
};

type Photo = { src: string; alt: string; caption: string; width: number; height: number };

const photos: Record<string, Photo> = {
  languageExchange: {
    src: "/images/about/language-exchange.webp",
    alt: "Matteo in a Holland T-shirt with a language-exchange name tag, next to a friend at a busy evening event",
    caption: "At a language exchange evening. The name tag lists the languages you offer and the ones you want to practise.",
    width: 1400,
    height: 1050,
  },
  plantVisit: {
    src: "/images/about/cargill-plant-visit.webp",
    alt: "Matteo and a colleague in high-visibility jackets in front of a projected diagram of an oilseed crushing process",
    caption: "Safety gear on before a plant visit during my Cargill years. Seeing the crushing process in person made the numbers much easier to read.",
    width: 1000,
    height: 1333,
  },
  cityView: {
    src: "/images/about/africa-city-view.webp",
    alt: "Matteo on a rooftop above a hazy city with low buildings, palm trees and two minarets",
    caption: "Looking over the city on a hazy, dusty day while travelling in Africa.",
    width: 1280,
    height: 853,
  },
  communityProject: {
    src: "/images/about/africa-community-project.webp",
    alt: "Matteo standing between two people in organisation vests in front of a green and white school building",
    caption: "With two people from the organisation behind a community project I visited.",
    width: 1400,
    height: 787,
  },
  buildBreak: {
    src: "/images/about/africa-build-break.webp",
    alt: "Matteo in work gloves taking a selfie with a man in paint-splashed overalls at a shaded table",
    caption: "Work gloves still on, during a break on a building project.",
    width: 1400,
    height: 787,
  },
  ferry: {
    src: "/images/about/norway-ferry.webp",
    alt: "Matteo smiling on the deck of a ferry, with a rocky mountain island and the sea behind him",
    caption: "On a ferry along the Norwegian coast. I am learning Norwegian and am at A2 so far.",
    width: 1280,
    height: 960,
  },
  river: {
    src: "/images/about/river-trip.webp",
    alt: "Matteo in a life jacket giving a thumbs up on a wooden boat on a green river through the jungle",
    caption: "Life jacket on, on a river trip through the jungle.",
    width: 961,
    height: 1280,
  },
};

const chapters = [
  {
    id: "rotterdam",
    place: "Barcelona → Rotterdam",
    period: "2014–2018",
    title: "Learning how to start again somewhere new",
    paragraphs: [
      "In 2014 I left Barcelona for Rotterdam to study International Business Administration at Rotterdam School of Management, Erasmus University. It was the first time I had to build a life from nothing: a new city, a new language, a new climate and a culture where people tell you exactly what they think.",
      "I learnt Dutch, settled into a new environment and got used to working in international teams where nobody shared the same assumptions. For a few months I also taught Spanish to groups of international students, which is where I learnt to stand in front of a room and explain things simply. In 2017 I was part of the team that won the Rotterdam100, a talent programme run by the city and partner companies in which students solve real business cases.",
      "I also took every chance to study somewhere else. I did a summer course at the London School of Economics, a course on China's economic growth at Peking University in Beijing, and a financial analysis programme at St. Petersburg State University. After my bachelor's I stayed at RSM for my Master of Science in Business Administration, which I finished in 2018.",
    ],
    takeaway: "Settling into a new place is a skill, and it gets easier each time you do it.",
    photo: photos.languageExchange,
  },
  {
    id: "luxembourg",
    place: "Luxembourg",
    period: "2018–2019",
    title: "Banking, where every number is checked twice",
    paragraphs: [
      "My first jobs took me to Luxembourg. I started at the European Investment Fund in operational risk, developing risk indicators, analysing risk events, supporting portfolio reports and writing a market research report. I then joined the European Investment Bank's restructuring and resolution team, supporting the officers who handle distressed deals: credit and fundamental analysis, reviewing financial models, testing debt repayment schedules and researching insolvency rules across EU countries. I learnt to value a business and to judge whether it can pay back what it owes.",
      "It was a formal and highly regulated environment, and I learnt a lot from that. Analysis there has to be precise and documented, and every recommendation has to be clear about what it is based on.",
      "It was also where my interest in development economics started. I saw how finance can help companies and countries grow sustainably, and that stayed with me.",
    ],
    takeaway: "How to read a company through its numbers, and how to write analysis that survives review.",
  },
  {
    id: "cargill",
    place: "Schiphol & Amsterdam",
    period: "2020–2024",
    title: "Where I discovered my love for data",
    paragraphs: [
      "After a year I found an opportunity in agriculture with Cargill. I was excited to go back to the Netherlands, and I stayed with the company for almost five years. I joined as a financial management trainee at the office at Schiphol, working with traders and commercial teams across Cargill's agricultural supply chain business, and later supported the Bioindustrial business across Europe and the Middle East and North Africa.",
      "This is where I discovered how much I enjoy data, automation and technology. I automated the entire reconciliation process, built Power BI reports and ETL pipelines, and used Python and ARIMA models to forecast inventories for the trading teams. I also helped to solve product traceability challenges across global supply chains. In 2021 I also completed a data scientist track with Dataquest to go deeper into the tools.",
      "My colleagues noticed and asked me to join the financial analytics team. There I helped build Cargill's global finance data infrastructure for three enterprises, from food to grain trading to bioindustrials, which meant bringing together every region, currency and the different terms each business used for the same things. I built financial APIs that saved teams hundreds of hours, worked on a machine learning model that flags anomalies in financial transactions, and redesigned a cloud workflow so that it cost about 90% less to run. By then I was working closely with the headquarters in the United States.",
    ],
    takeaway: "Most manual work can be automated, and most messy data can be made to agree. It takes patience and good questions.",
    photo: photos.plantVisit,
    quote: quote(
      "jose-laguna",
      "Matteo's skills go beyond technical capabilities in Python and data analysis: he is an excellent problem solver, he is proactive, a good communicator, he is a change leader and a technology evangelist.",
    ),
  },
  {
    id: "mexico-family",
    place: "Mexico",
    period: "2023–2024",
    title: "Time with my grandparents",
    short: true,
    paragraphs: [
      "My grandparents lived in Mexico and they were very old. I wanted to spend time with them while I still could, so in 2023 I moved to Mexico City and continued my work with Cargill from there.",
      "That year I also taught Python, SQL and machine learning to students, more than 120 hours in total. Teaching something is still the best test I know of whether I really understand it.",
    ],
  },
  {
    id: "africa",
    place: "Africa",
    period: "2024–2025",
    title: "Seeing development up close",
    paragraphs: [
      "After almost five years at Cargill I wanted to travel, and Africa was at the top of my list. The interest in development economics that started in Luxembourg had never left me, and I wanted to see what growth and development look like away from reports and spreadsheets.",
      "I visited community projects, met the people running them and helped where I could.",
      "In the same period I kept my hands in finance and data. I worked as a financial analytics engineer for PIA Group, a Dutch company, building its management reporting and data models in dbt and SQL, and as a sustainable finance expert for Ecowater Economics, on budgets, financing and business models in water, energy and food.",
    ],
    gallery: [photos.cityView, photos.communityProject, photos.buildBreak],
  },
  {
    id: "distribusion",
    place: "Back to Mexico",
    period: "Now",
    title: "Product, payments and conversion",
    paragraphs: [
      "Then, in October 2025, an opportunity came up to join Distribusion, a travel tech company, as Senior Technical Growth Lead, and to lead a large project in Mexico. So I came back, and I am based in Mexico City today.",
      "That is where my current work started: improving products, payments and conversion, from search and location data to tracking, experiments and checkout, with GA4, Amplitude, BigQuery and SQL behind every decision. Every earlier chapter shows up in it. Banking taught me to put a value on a problem before solving it. Cargill taught me to automate, build the data and get teams to agree on it. Living in four countries taught me that customers in different markets search, decide and pay differently.",
    ],
    quote: quote(
      "angelica-garcia-patino",
      "What stands out most about him is his passion for the work and his curiosity about other areas.",
    ),
    links: [
      { label: "How I improve products", href: "/services/insights-commercial-analysis/" },
      { label: "Product research case studies", href: "/product-research/case-studies/" },
      { label: "Payment case studies", href: "/payment-solutions/case-studies/" },
    ],
  },
];

const colleagueQuotes = [
  {
    heading: "I ask why until the problem is clear",
    quote: quote(
      "abhishek-agarwal",
      'Matteo has been a great person to work with who always endeavors to drive new innovations and get into the "Why" of a question.',
    ),
  },
  {
    heading: "I dig into what others skip",
    quote: quote("sana-shakeel", "He is naturally curious, digs deeply into problems that others might overlook"),
  },
  {
    heading: "I learn fast and pass it on",
    quote: quote(
      "lucas-zarpellon",
      "Matteo is a quick learner and an excellent teacher, able to convey complex concepts clearly and deliver sustainable solutions that drive meaningful business growth.",
    ),
  },
  {
    heading: "I work well across cultures",
    quote: quote("amrita-nandy", "He is highly aware of different work cultures and excels in collaboration."),
  },
];

const glance = [
  { label: "Now", value: "Senior Technical Growth Lead at Distribusion Technologies · Founder of Yeelen · based in Mexico City" },
  { label: "Experience", value: "European Investment Fund · European Investment Bank · Cargill · PIA Group · Ecowater Economics · Distribusion" },
  { label: "Education", value: "BSc and MSc in Business Administration, Rotterdam School of Management, Erasmus University · all three CFA Program exams passed" },
  { label: "Lived in", value: "Spain · the Netherlands · Luxembourg · Mexico" },
  { label: "Studied in", value: "the Netherlands · United Kingdom · China · Russia" },
  { label: "Languages", value: "Spanish, Catalan, English, Dutch, French, Portuguese and some Norwegian" },
];

const sideProjects = [
  {
    title: "Yeelen",
    copy: "I founded Yeelen in 2026, a social enterprise that helps independent professionals, local businesses and underserved entrepreneurs build an affordable online presence and become easier to find, trust and contact. I do everything from customer research to pricing and the website, which keeps me honest about how hard growth is for a small business.",
  },
  {
    title: "Agritrack",
    copy: "I work with Agritrack on digitalising seafood traceability and compliance: catch documentation, data integration and taking manual paperwork off importers and processors.",
  },
  {
    title: "WeGoZero",
    copy: "An independent collaboration on technology and commercial thinking for the circular economy.",
    href: "/journal/2026-10-29-making-complex-business-problems-simpler-my-collaboration-with-wegozero/",
  },
];

const education = [
  { year: "2021", title: "Data Scientist track", place: "Dataquest" },
  { year: "2018", title: "Master of Science in Business Administration", place: "Rotterdam School of Management, Erasmus University · Rotterdam" },
  { year: "2017", title: "BSc in International Business Administration", place: "Rotterdam School of Management, Erasmus University · Rotterdam" },
  { year: "2017", title: "Winner of the Rotterdam100 talent programme", place: "Municipality of Rotterdam and partner companies" },
  { year: "2016", title: "China's Economic Growth, Foreign Trade and Investment (grade A)", place: "LSE–PKU Summer School, Peking University · Beijing" },
  { year: "2016", title: "Financial analysis programme", place: "Graduate School of Management, St. Petersburg State University · St. Petersburg" },
  { year: "2015", title: "Human Resource Management and Employment Relations (grade A)", place: "LSE Summer School, London School of Economics · London" },
];
// Keep in step with the education data on the recommendations page.
if (achievements.length > education.length) {
  throw new Error("About page education list is out of date with src/data/achievements.ts");
}

const allLanguages = languageLevels.flatMap((level) => level.languages.map((language) => language.name));

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": `${site}/#website` },
      mainEntity: { "@id": `${site}/#person` },
      primaryImageOfPage: { "@type": "ImageObject", url: `${site}/images/matteo-arellano-headshot.webp` },
      image: Object.values(photos).map((photo) => `${site}${photo.src}`),
    },
    {
      "@type": "Person",
      "@id": `${site}/#person`,
      name: "Matteo Arellano",
      alumniOf: [
        { "@type": "CollegeOrUniversity", name: "Rotterdam School of Management, Erasmus University" },
        { "@type": "CollegeOrUniversity", name: "London School of Economics and Political Science" },
        { "@type": "CollegeOrUniversity", name: "Peking University" },
        { "@type": "CollegeOrUniversity", name: "St. Petersburg State University" },
        { "@type": "Organization", name: "Dataquest" },
      ],
      homeLocation: { "@type": "City", name: "Mexico City" },
      hasCredential: [
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "degree",
          name: "Master of Science in Business Administration",
          recognizedBy: { "@type": "CollegeOrUniversity", name: "Rotterdam School of Management, Erasmus University" },
        },
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "degree",
          name: "BSc in International Business Administration",
          recognizedBy: { "@type": "CollegeOrUniversity", name: "Rotterdam School of Management, Erasmus University" },
        },
      ],
      award: "Winner of the Rotterdam100 (2016–2017)",
      knowsLanguage: languageLevels.flatMap((level) =>
        level.languages.map((language) => ({ "@type": "Language", name: language.name, alternateName: language.code })),
      ),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "About", item: canonical },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} image="/images/about/norway-ferry.webp">
  <Header />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="ab-page">
    <section class="ab-hero">
      <div class="growth-shell ab-hero-grid">
        <div class="ab-hero-copy">
          <span class="growth-overline">About</span>
          <h1>Hi, I'm Matteo Arellano.</h1>
          <p class="ab-lede">
            I left Barcelona to study in Rotterdam, learnt corporate finance in
            Luxembourg, discovered my love for data and automation at Cargill, and
            now work on product, payments and conversion in travel tech. I have
            lived in four countries and studied in four.
          </p>
          <p>
            Each move started with something I wanted to understand better. This
            page is the longer version of that story, with a few photos along
            the way.
          </p>
          <div class="ab-hero-actions">
            <a class="growth-primary-button" href="#availability">Say hello</a>
            <a class="growth-secondary-link" href="#story">Read the story →</a>
          </div>
        </div>
        <figure class="ab-portrait">
          <img src="/images/matteo-arellano-headshot.webp" alt="Portrait of Matteo Arellano" width="640" height="640" />
        </figure>
      </div>

      <div class="growth-shell">
        <dl class="ab-glance" aria-label="At a glance">
          {glance.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="ab-story" id="story" aria-labelledby="story-title">
      <div class="growth-shell">
        <header class="ab-section-head">
          <span class="growth-overline">The story so far</span>
          <h2 id="story-title">Six chapters, four countries</h2>
        </header>

        <ol class="ab-chapters">
          {
            chapters.map((chapter, index) => (
              <li class:list={["ab-chapter", chapter.photo && "has-photo", chapter.short && "is-short"]} id={chapter.id}>
                <div class="ab-chapter-marker" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
                <div class="ab-chapter-body">
                  <p class="ab-chapter-meta">
                    <span>{chapter.place}</span>
                    <span>{chapter.period}</span>
                  </p>
                  <h3>{chapter.title}</h3>
                  {chapter.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                  {chapter.takeaway && (
                    <p class="ab-takeaway"><strong>What I took with me:</strong> {chapter.takeaway}</p>
                  )}
                  {chapter.quote && (
                    <blockquote class="ab-quote">
                      <p>“{chapter.quote.text}”</p>
                      <footer>
                        <a href={chapter.quote.anchor}>{chapter.quote.name}</a>, {chapter.quote.headline}
                      </footer>
                    </blockquote>
                  )}
                  {chapter.links && (
                    <p class="ab-chapter-links">
                      {chapter.links.map((link) => <a href={link.href}>{link.label} →</a>)}
                    </p>
                  )}
                </div>
                {chapter.photo && (
                  <figure class="ab-photo">
                    <img src={chapter.photo.src} alt={chapter.photo.alt} width={chapter.photo.width} height={chapter.photo.height} loading="lazy" decoding="async" />
                    <figcaption>{chapter.photo.caption}</figcaption>
                  </figure>
                )}
                {chapter.gallery && (
                  <div class="ab-gallery">
                    {chapter.gallery.map((photo) => (
                      <figure class="ab-photo">
                        <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                        <figcaption>{photo.caption}</figcaption>
                      </figure>
                    ))}
                  </div>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="ab-section ab-section--soft" aria-labelledby="colleagues-title">
      <div class="growth-shell">
        <header class="ab-section-head">
          <span class="growth-overline">How I work</span>
          <h2 id="colleagues-title">In my colleagues' words</h2>
          <p>
            I could describe my working style myself, but the people I have
            worked with put it better. These lines come word for word from their
            recommendations.
          </p>
        </header>
        <div class="ab-colleagues">
          {
            colleagueQuotes.map((item) => (
              <figure class="ab-colleague">
                <h3>{item.heading}</h3>
                <blockquote><p>“{item.quote.text}”</p></blockquote>
                <figcaption>
                  <a href={item.quote.anchor}>{item.quote.name}</a>
                  <span>{item.quote.headline}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <p class="ab-more"><a class="growth-secondary-link" href="/achievements/">Read all recommendations →</a></p>
      </div>
    </section>

    <section class="ab-section" aria-labelledby="outside-title">
      <div class="growth-shell ab-outside">
        <header class="ab-section-head">
          <span class="growth-overline">Outside work</span>
          <h2 id="outside-title">Always learning something</h2>
          <p>
            Most of what I learn outside work comes from travelling and
            languages. I speak {allLanguages.length} languages at different
            levels, and the newest one is Norwegian. Learning a language is the
            quickest way I know to understand how people in a place think, and
            that habit carries straight into my work with customers in different
            markets.
          </p>
          <ul class="ab-languages" aria-label="Languages">
            {
              languageLevels.map((level) => (
                <li>
                  <strong>{level.label}</strong>
                  <span>{level.languages.map((language) => language.name).join(", ")}</span>
                </li>
              ))
            }
          </ul>
        </header>
        <div class="ab-outside-photos">
          {
            [photos.ferry, photos.river].map((photo) => (
              <figure class="ab-photo">
                <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                <figcaption>{photo.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ab-section ab-section--soft" aria-labelledby="learning-title">
      <div class="growth-shell ab-two">
        <div>
          <header class="ab-section-head">
            <span class="growth-overline">Education</span>
            <h2 id="learning-title">Studies and awards</h2>
          </header>
          <ol class="ab-education">
            {
              education.map((item) => (
                <li>
                  <span>{item.year}</span>
                  <div>
                    <strong>{item.title}</strong>
                    <em>{item.place}</em>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="ab-more"><a class="growth-secondary-link" href="/achievements/">Details and reference letters →</a></p>
        </div>
        <div>
          <header class="ab-section-head">
            <span class="growth-overline">Side projects</span>
            <h2>What I build on the side</h2>
          </header>
          <div class="ab-side">
            {
              sideProjects.map((item) => (
                <article>
                  <h3>{item.title}</h3>
                  <p>{item.copy}</p>
                  {item.href && <a href={item.href}>Read about it →</a>}
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="profile-calendar-section ab-calendar">
      <div class="growth-shell">
        <DiscoveryCalendar
          namespace="about-discovery"
          eyebrow="Let's talk"
          title="Working on something I could help with?"
          copy="Tell me what you are trying to figure out. Twenty minutes is usually enough to see whether I can be useful, and I enjoy these conversations either way."
        />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
