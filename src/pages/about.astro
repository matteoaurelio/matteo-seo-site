---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DiscoveryCalendar from "../components/DiscoveryCalendar.astro";
import "../styles/growth-platform.css";
import "../styles/profile-growth.css";

const title = "About Matteo Arellano | Technical Growth Partner";
const description =
  "Matteo Arellano combines commercial strategy, partnerships, analytics, product, data engineering and automation to help companies create new revenue and solve growth problems.";

const career = [
  {
    period: "Now",
    organisation: "Distribusion Technologies",
    title: "Growth, product & analytics",
    copy: "I work on commercial and product growth problems across transport: conversion funnels, payment acceptance, customer journeys, experimentation, analytics, partner needs and technical performance.",
  },
  {
    period: "2024–2025",
    organisation: "PIA Group Netherlands",
    title: "Financial analytics & decision systems",
    copy: "I built financial and operational reporting for management, created analytical models and data layers, and designed controls that made complex financial information easier to act on.",
  },
  {
    period: "2020–2024",
    organisation: "Cargill",
    title: "Finance → analytics → data engineering",
    copy: "I moved from finance into business intelligence, Python, data engineering and machine learning. I built APIs, pipelines and reporting systems for global teams and reduced one cloud-processing workflow's cost by about 90% through a technical redesign.",
  },
  {
    period: "2018–2019",
    organisation: "European Investment Bank & European Investment Fund",
    title: "Risk, restructuring & financial analysis",
    copy: "I started my career analysing companies, credit, operational risk, distressed transactions and repayment capacity — a foundation that still shapes how I think about commercial decisions today.",
  },
];

const capabilities = [
  {
    number: "01",
    title: "Create new commercial opportunities",
    copy: "Research markets and segments, speak with prospects, understand pain points and buying triggers, map potential partners and turn promising signals into focused outreach or pilots.",
  },
  {
    number: "02",
    title: "Find where revenue is being lost",
    copy: "Use behavioural and commercial data to identify friction in funnels, payments, customer journeys and digital experiences, then prioritise the changes most likely to improve conversion.",
  },
  {
    number: "03",
    title: "Turn data into decisions",
    copy: "Connect customer, revenue, market, product and operational data so teams can understand what is happening, why it matters and what to do next.",
  },
  {
    number: "04",
    title: "Build the system behind the growth",
    copy: "Use Python, SQL, APIs, BigQuery and automation when the bottleneck is manual work, fragmented data, recurring cost or a process that does not scale.",
  },
];

const workingStyle = [
  "I am comfortable talking to commercial teams, prospects, analysts and engineers — and translating between them.",
  "I prefer evidence over assumptions: customer conversations, behavioural data, market signals and financial impact.",
  "I can move from diagnosis into execution instead of stopping at a strategy deck.",
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://matteoarellano.com/about/"
  image="/images/matteo-arellano-visibility-signup.jpg"
>
  <Header />

  <main class="profile-page">
    <section class="profile-hero">
      <div class="growth-shell profile-hero-grid">
        <div class="profile-hero-copy">
          <span class="growth-overline">About Matteo</span>
          <h1>I work where commercial questions meet data and technology.</h1>
          <p class="profile-hero-lede">
            I help companies find new ways to grow, establish new commercial
            opportunities and generate higher revenue. When the problem is in
            the product, the funnel, the data or the underlying process, I can
            go there too.
          </p>
          <p class="profile-hero-support">
            My background spans finance, partnerships, analytics, data
            engineering, product growth and entrepreneurship. That range lets me
            understand the business question first and then use the right tools
            to solve it.
          </p>
          <div class="profile-hero-actions">
            <a class="growth-primary-button" href="#availability">Talk through an opportunity</a>
            <a class="growth-secondary-link" href="/services/">See how I can help →</a>
          </div>
        </div>

        <aside class="profile-photo-card" aria-label="Matteo Arellano profile">
          <img
            src="/images/matteo-arellano-headshot.webp"
            alt="Matteo Arellano"
          />
          <div class="profile-photo-copy">
            <span>Technical Growth Partner</span>
            <strong>Matteo Arellano</strong>
            <p>Commercial thinking, analytical depth and technical execution.</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="profile-intro-band">
      <div class="growth-shell profile-intro-grid">
        <div>
          <span class="growth-overline">What that means in practice</span>
          <h2>I do not sell one channel. I help move a commercial outcome.</h2>
        </div>
        <p>
          Sometimes that means talking to prospects and opening a new market.
          Sometimes it means fixing a conversion problem, building better
          measurement, analysing a large dataset or automating expensive work.
          The common thread is simple: the work needs to create measurable value.
        </p>
      </div>
    </section>

    <section class="profile-capability-section">
      <div class="growth-shell">
        <header class="profile-section-heading">
          <span class="growth-overline">What I bring</span>
          <h2>From commercial opportunity to execution.</h2>
          <p>
            My strongest work usually sits between functions — where the problem
            is important, but no single team or discipline has the whole answer.
          </p>
        </header>

        <div class="profile-capability-grid">
          {capabilities.map((item) => (
            <article class="profile-capability-card">
              <span>{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="profile-career-section">
      <div class="growth-shell profile-career-layout">
        <div class="profile-career-intro">
          <span class="growth-overline">Career path</span>
          <h2>The breadth is deliberate.</h2>
          <p>
            I did not start in marketing. I started by learning how companies
            make money, how risk is evaluated and how decisions are made. Then I
            moved deeper into data, engineering, product and growth.
          </p>
          <a href="/achievements/">See full experience, recommendations & education →</a>
        </div>

        <div class="profile-career-list">
          {career.map((item) => (
            <article class="profile-career-item">
              <div class="profile-career-meta">
                <span>{item.period}</span>
                <strong>{item.organisation}</strong>
              </div>
              <div>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="profile-builder-section">
      <div class="growth-shell profile-builder-grid">
        <div>
          <span class="growth-overline">I also build</span>
          <h2>Yeelen keeps me close to the realities of entrepreneurship.</h2>
        </div>
        <div>
          <p>
            I founded Yeelen to help local businesses and independent
            entrepreneurs build a stronger digital presence and become easier to
            discover online. Building something myself keeps me close to customer
            acquisition, pricing, product decisions, distribution and the daily
            constraints that smaller businesses face.
          </p>
          <p>
            That matters to my professional work too: I care about solutions that
            are useful in the real world, not only technically correct.
          </p>
        </div>
      </div>
    </section>

    <section class="profile-working-section">
      <div class="growth-shell profile-working-grid">
        <header>
          <span class="growth-overline">Working with me</span>
          <h2>Direct, curious and comfortable crossing functions.</h2>
        </header>
        <div class="profile-working-list">
          {workingStyle.map((item) => (
            <p>{item}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="profile-calendar-section">
      <div class="growth-shell">
        <DiscoveryCalendar
          namespace="about-discovery"
          eyebrow="Talk and discover together"
          title="Have a commercial opportunity or growth problem worth exploring?"
          copy="Tell me what you are trying to achieve. We can use 20 minutes to understand the context, exchange ideas and see whether there is a useful way for me to contribute."
        />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
