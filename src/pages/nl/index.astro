---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const title = "Technische SEO, organische groei en Google Ads | Matteo Arellano";
const description =
  "Ik help bedrijven meer organisch verkeer, online verkoop, betere gebruikerservaring en beter meetbare groei te realiseren met technische SEO, organische SEO en Google Ads.";
const canonical = "https://matteoarellano.com/nl/";
const photoSrc = "/images/matteo-arellano-headshot.webp";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />

  <main class="commercial-page">
    <section class="commercial-hero">
      <div class="commercial-container commercial-hero-grid">
        <div class="commercial-copy">
          <span class="commercial-kicker">Technische SEO · Organische SEO · Google Ads</span>

          <h1>Ik help bedrijven online zichtbaarheid omzetten in verkeer, verkoop en gekwalificeerde leads.</h1>

          <p>
            Ik werk met bedrijven die willen begrijpen wat hun online groei blokkeert:
            technische SEO-problemen, lage zichtbaarheid in Google, onduidelijke campagnes,
            incomplete meting of pagina’s die niet goed genoeg converteren.
          </p>

          <div class="commercial-actions">
            <a class="commercial-primary" href="/free-visibility-check/#calendar">
              Plan een eerste review
            </a>
            <a class="commercial-secondary" href="/blog/">
              Bekijk artikelen en cases
            </a>
          </div>
        </div>

        <aside class="commercial-profile-card" aria-label="Profiel van Matteo Arellano">
          <img
            src={photoSrc}
            alt="Matteo Arellano, consultant voor technische SEO en organische groei"
            width="900"
            height="900"
          />

          <div class="commercial-profile-copy">
            <strong>Matteo Arellano</strong>
            <span>Technical SEO & AI Visibility</span>
            <p>
              Ervaring in banking, finance, data, analytics engineering en SEO-projecten
              met klanten in grondtransport in LATAM, de VS en Europa.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <section class="commercial-section">
      <div class="commercial-container commercial-split">
        <div>
          <span class="commercial-eyebrow">Wat ik help bereiken</span>
          <h2>Meer duidelijkheid, meer zichtbaarheid en betere groeibeslissingen.</h2>
        </div>

        <div class="commercial-card-grid">
          <div class="commercial-card">
            <h3>Meer gekwalificeerd verkeer</h3>
            <p>
              Ik identificeer technische, content- en zoekintentie-kansen zodat je website
              beter zichtbaar kan worden voor relevante zoekopdrachten.
            </p>
          </div>

          <div class="commercial-card">
            <h3>Meer sales en leads</h3>
            <p>
              Ik bekijk SEO niet als los verkeer. Ik verbind zichtbaarheid met formulieren,
              boekingen, conversies, campagnes en echte business-signalen.
            </p>
          </div>

          <div class="commercial-card">
            <h3>Betere gebruikerservaring</h3>
            <p>
              Ik analyseer snelheid, Core Web Vitals, sitestructuur, belangrijke pagina’s
              en frictiepunten die gebruikers en zoekmachines kunnen raken.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="commercial-section commercial-soft">
      <div class="commercial-container">
        <div class="commercial-section-header">
          <span class="commercial-eyebrow">Hoe ik werk</span>
          <h2>Een methode gebaseerd op data, context en echte prioriteiten.</h2>
          <p>
            Ik begin niet met loze rankingbeloftes. Ik begin met het begrijpen van het
            bedrijf, de beschikbare data en het verschil tussen urgente problemen en ruis.
          </p>
        </div>

        <div class="commercial-process">
          <div>
            <span>01</span>
            <h3>Diagnose</h3>
            <p>
              Ik review Search Console, PageSpeed Insights, sitestructuur, analytics,
              commerciële pagina’s, content en de belangrijkste frictiepunten.
            </p>
          </div>

          <div>
            <span>02</span>
            <h3>Prioritering</h3>
            <p>
              Niet alles heeft dezelfde impact. Ik rangschik problemen op risico, kans,
              technische moeilijkheid en relatie met verkoop of leads.
            </p>
          </div>

          <div>
            <span>03</span>
            <h3>Uitvoering of begeleiding</h3>
            <p>
              Ik kan helpen met audits, aanbevelingen, documentatie voor developers,
              campagnebegeleiding of doorlopende consulting.
            </p>
          </div>

          <div>
            <span>04</span>
            <h3>Meting</h3>
            <p>
              Ik verbind zichtbaarheid met bruikbare KPI’s: organisch verkeer, leads,
              sales, conversies, paginaprestaties en kwaliteit van de vraag.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="commercial-section">
      <div class="commercial-container commercial-why-grid">
        <div class="commercial-proof">
          <span class="commercial-eyebrow">Waarom met mij werken</span>
          <h2>Ik combineer SEO, data, analytics en business-denken.</h2>

          <p>
            Voordat ik mij specialiseerde in technische SEO en organische groei, werkte ik
            in banking, finance, data en analytics engineering. Daardoor kijk ik naar een
            website niet alleen als een verzameling pagina’s, maar als een systeem voor
            meting, acquisitie en conversie.
          </p>

          <p>
            Op dit moment werk ik met echte klanten in de grondtransportsector in LATAM,
            de Verenigde Staten en Europa. Die ervaring heeft mij geleerd te werken met
            complexe websites, meerdere markten, veel pagina’s, technische teams en concrete
            commerciële doelen.
          </p>
        </div>

        <div class="commercial-values">
          <div>
            <h3>Professioneel en helder</h3>
            <p>
              Ik werk met directe communicatie, actiegerichte deliverables en begrijpelijke
              prioriteiten.
            </p>
          </div>

          <div>
            <h3>Empathisch en betrokken</h3>
            <p>
              Ik wil het bedrijf, de context, de beperkingen en wat er echt op het spel
              staat begrijpen.
            </p>
          </div>

          <div>
            <h3>Geen overdreven beloftes</h3>
            <p>
              SEO is een langetermijnspel. Het draait om zichtbaarheid, structuur,
              positionering, luisteren naar klanten en constante verbetering.
            </p>
          </div>

          <div>
            <h3>Geen lange verplichtingen</h3>
            <p>
              We kunnen starten met één proefmaand om elkaar te leren kennen, prioriteiten
              te bepalen en te zien of verdere samenwerking logisch is.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="commercial-section commercial-soft">
      <div class="commercial-container">
        <div class="commercial-section-header">
          <span class="commercial-eyebrow">Diensten</span>
          <h2>Waar ik bij kan helpen.</h2>
        </div>

        <div class="commercial-services">
          <article>
            <h3>Technische SEO</h3>
            <p>
              Technische audits, indexatie, crawlbaarheid, Core Web Vitals, redirects,
              migraties, sitearchitectuur, interne links en documentatie voor developers.
            </p>
          </article>

          <article>
            <h3>Organische SEO</h3>
            <p>
              Contentstrategie, topic clusters, servicepagina’s, FAQs, zoekintentie,
              pagina-optimalisatie en organische groeistructuur.
            </p>
          </article>

          <article>
            <h3>Google Ads en paid campaigns</h3>
            <p>
              Consulting of beheer van Google Ads-campagnes, campagnestructuur, meting,
              conversies, zoektermen en aansluiting op commerciële doelen.
            </p>
          </article>

          <article>
            <h3>Analytics en meting</h3>
            <p>
              Review van GA4, events, conversies, funnels, datakwaliteit en de verbinding
              tussen verkeer, leads, sales en beslissingen.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="commercial-container commercial-cta">
      <span class="commercial-eyebrow">Begin met duidelijkheid</span>
      <h2>Wil je weten wat je online groei blokkeert?</h2>
      <p>
        We kunnen starten met een eerste review om je situatie te begrijpen, prioritaire
        problemen te vinden en te bepalen of één proefmaand samenwerken zinvol is.
      </p>

      <div class="commercial-actions">
        <a class="commercial-primary" href="/free-visibility-check/#calendar">
          Plan een eerste review
        </a>
        <a class="commercial-secondary" href="mailto:matteo.visibility@gmail.com">
          Stuur mij een e-mail
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
