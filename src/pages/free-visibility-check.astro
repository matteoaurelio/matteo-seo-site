---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CalEmbed from '../components/CalEmbed.astro';

const title = 'Free Website Visibility Check | Technical SEO & AI Visibility';
const description =
  'Book a free 20-minute website visibility check to identify potential technical SEO, AI visibility, page experience, and conversion issues.';
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <section class="booking-hero">
      <div class="container booking-hero-grid">
        <div>
          <span class="kicker">Free website visibility check</span>
          <h1>Find what may be blocking your website’s visibility.</h1>
          <p class="lede">
            Book a focused 20-minute call and I’ll review your website before we meet
            to identify 3–5 potential issues affecting technical SEO, AI visibility,
            page experience, or conversion.
          </p>

          <div class="trust-row">
            <span class="trust-pill">Technical SEO</span>
            <span class="trust-pill">AI visibility</span>
            <span class="trust-pill">Core Web Vitals</span>
            <span class="trust-pill">Analytics</span>
          </div>
        </div>

        <div class="booking-card">
          <strong>What you get</strong>
          <p>
            A focused first diagnosis, not a generic sales call.
          </p>
          <ul>
            <li>3–5 potential visibility issues</li>
            <li>Clear explanation of what matters first</li>
            <li>Practical next-step recommendations</li>
            <li>Optional path to a full technical SEO audit</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="calendar" class="booking-section">
      <div class="container booking-grid">
        <div class="booking-copy">
          <span class="eyebrow">Best fit</span>
          <h2>A useful first look before investing in a full audit.</h2>
          <p>
            This check is designed for founders, marketers, agencies, business and website owners
            who want to understand whether organic growth, technical SEO, AI visibility, page speed,
            content structure, or analytics issues may be online sales, traffic increase and lead generation.
          </p>

          <ul>
            <li>Crawlability and indexability signals</li>
            <li>Homepage and key page structure</li>
            <li>Metadata, headings, and content clarity</li>
            <li>Core Web Vitals and page speed signals</li>
            <li>Internal linking and AI visibility readiness</li>
            <li>Obvious conversion friction</li>
          </ul>

          <div class="booking-note">
            <strong>This is not a full technical SEO audit.</strong>
            <span>
              It is a focused first diagnosis. If deeper issues appear, I can prepare
              a full audit with a prioritized roadmap and developer-ready recommendations.
            </span>
          </div>
        </div>

        <CalEmbed />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
