---
/**
 * Digital business card. Standalone on purpose: no site header or footer,
 * and nothing on the site links here. It is opened from the QR code.
 */
const cardUrl = "https://matteoarellano.com/card/";
const phoneDisplay = "+52 55 7413 6001";
const phoneTel = "+525574136001";
const email = "matteo.visibility@gmail.com";
const whatsappUrl =
  "https://wa.me/525574136001?text=" + encodeURIComponent("Hi Matteo, I came across your digital card.");
const links = [
  { href: "https://matteoarellano.com/", label: "Website", note: "Services, writing and case studies" },
  { href: "https://www.linkedin.com/in/matteoarellano", label: "LinkedIn", note: "Career and recommendations" },
  { href: "https://yeelen.page/", label: "Yeelen", note: "The social venture I founded" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#071729" />
    <title>Matteo Arellano | Digital Business Card</title>
    <meta
      name="description"
      content="Matteo Arellano, Technical Growth Partner. Call, send a WhatsApp message, email or save the contact in one tap."
    />
    <link rel="canonical" href={cardUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={cardUrl} />
    <meta property="og:title" content="Matteo Arellano | Technical Growth Partner" />
    <meta
      property="og:description"
      content="I help companies find new ways to grow and turn them into revenue."
    />
    <meta property="og:image" content="https://matteoarellano.com/images/card-preview.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        url: cardUrl,
        mainEntity: {
          "@id": "https://matteoarellano.com/#person",
          "@type": "Person",
          name: "Matteo Arellano",
          jobTitle: "Technical Growth Partner",
          email: `mailto:${email}`,
          telephone: phoneTel,
          url: "https://matteoarellano.com/",
          sameAs: ["https://www.linkedin.com/in/matteoarellano"],
        },
      })}
    />

    <style is:global>
      :root {
        color-scheme: dark;
        --ink: #071729;
        --night: #050d19;
        --navy: #0b2240;
        --gold: #e9b44c;
        --gold-soft: #f3d28f;
        --text: #ffffff;
        --muted: rgba(255, 255, 255, 0.68);
        --line: rgba(255, 255, 255, 0.12);
        --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
        --sans: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        min-height: 100dvh;
        background:
          radial-gradient(60rem 40rem at 85% -10%, rgba(233, 180, 76, 0.1), transparent 60%),
          radial-gradient(50rem 40rem at -10% 110%, rgba(32, 90, 160, 0.22), transparent 60%),
          var(--night);
        color: var(--text);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--gold-soft);
        outline-offset: 3px;
        border-radius: 10px;
      }

      .card {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 28px;
        width: min(1040px, calc(100% - 32px));
        margin: 0 auto;
        padding: max(28px, env(safe-area-inset-top)) 0 max(36px, env(safe-area-inset-bottom));
      }

      /* ---------- Identity ---------- */

      .who {
        display: grid;
        justify-items: center;
        text-align: center;
      }

      .photo {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow:
          0 0 0 3px var(--night),
          0 0 0 4px rgba(233, 180, 76, 0.7),
          0 18px 40px rgba(0, 0, 0, 0.45);
      }

      .kicker {
        margin: 22px 0 0;
        color: var(--gold);
        font-size: 0.74rem;
        font-weight: 750;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      h1 {
        margin: 10px 0 0;
        font-size: clamp(2.2rem, 9vw, 3.4rem);
        font-weight: 760;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .lede {
        max-width: 34ch;
        margin: 14px 0 0;
        color: var(--muted);
        font-size: 1.04rem;
        line-height: 1.6;
      }

      /* ---------- Primary actions ---------- */

      .actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .action {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
        min-height: 84px;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--text);
        font: inherit;
        text-align: left;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.25s var(--ease), background 0.25s var(--ease), border-color 0.25s var(--ease);
      }

      .action:hover {
        transform: translateY(-1px);
        border-color: rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.08);
      }

      .action svg {
        width: 22px;
        height: 22px;
      }

      .action strong {
        font-size: 1.02rem;
        font-weight: 700;
      }

      .action small {
        color: var(--muted);
        font-size: 0.8rem;
      }

      .action--primary {
        grid-column: 1 / -1;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 60px;
        border: 0;
        background: var(--gold);
        color: var(--navy);
        text-align: center;
      }

      .action--primary:hover {
        background: #f2c76c;
      }

      .action--primary strong {
        font-size: 1.08rem;
      }

      .phone {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 2px;
        padding: 14px 16px;
        border: 1px solid var(--line);
        border-radius: 16px;
      }

      .phone a {
        font-size: 1.12rem;
        font-weight: 650;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.01em;
        text-decoration: none;
      }

      .phone button {
        padding: 8px 12px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: transparent;
        color: var(--gold-soft);
        font: inherit;
        font-size: 0.84rem;
        font-weight: 650;
        cursor: pointer;
      }

      /* ---------- QR ---------- */

      .qr {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: 18px;
        width: 100%;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.04);
        color: var(--text);
        font: inherit;
        text-align: left;
        cursor: zoom-in;
      }

      .qr-code {
        display: block;
        width: 104px;
        height: 104px;
        padding: 10px;
        border-radius: 14px;
        background: #ffffff;
      }

      .qr-code img {
        display: block;
        width: 100%;
        height: 100%;
        image-rendering: pixelated;
      }

      .qr strong {
        display: block;
        font-size: 1.04rem;
      }

      .qr small {
        display: block;
        margin-top: 6px;
        color: var(--muted);
        font-size: 0.86rem;
        line-height: 1.5;
      }

      .qr em {
        display: inline-block;
        margin-top: 10px;
        color: var(--gold-soft);
        font-size: 0.84rem;
        font-style: normal;
        font-weight: 650;
      }

      /* ---------- Links ---------- */

      .links {
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }

      .links a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 4px;
        border-bottom: 1px solid var(--line);
        text-decoration: none;
      }

      .links strong {
        display: block;
        font-size: 1rem;
      }

      .links small {
        display: block;
        margin-top: 3px;
        color: var(--muted);
        font-size: 0.84rem;
      }

      .links span[aria-hidden] {
        color: var(--muted);
      }

      .share {
        justify-self: center;
        padding: 10px 18px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: transparent;
        color: var(--text);
        font: inherit;
        font-size: 0.92rem;
        font-weight: 650;
        cursor: pointer;
      }

      .feedback {
        min-height: 1.2em;
        margin: -16px 0 0;
        color: var(--gold-soft);
        font-size: 0.86rem;
        text-align: center;
      }

      /* ---------- Large QR (tap to enlarge) ---------- */

      .qr-full {
        width: 100%;
        max-width: none;
        height: 100%;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        background: #ffffff;
        color: var(--ink);
      }

      .qr-full[open] {
        display: grid;
        place-items: center;
      }

      .qr-full-inner {
        display: grid;
        justify-items: center;
        gap: 18px;
        padding: 24px;
        text-align: center;
      }

      .qr-full img {
        width: min(86vw, 70vh, 520px);
        height: auto;
        image-rendering: pixelated;
      }

      .qr-full p {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
      }

      .qr-full small {
        color: #5c7186;
        font-size: 0.92rem;
      }

      .qr-full button {
        margin-top: 6px;
        padding: 12px 22px;
        border: 0;
        border-radius: 999px;
        background: var(--ink);
        color: #ffffff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      /* ---------- Wider screens: identity left, actions right ---------- */

      @media (min-width: 860px) {
        .card {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          align-items: center;
          gap: 28px 64px;
          min-height: 100dvh;
          padding-block: 48px;
        }

        .who {
          justify-items: start;
          text-align: left;
        }

        .photo {
          width: 132px;
          height: 132px;
        }

        .side {
          display: grid;
          gap: 20px;
        }

        .qr-code {
          width: 140px;
          height: 140px;
        }
      }

      .side {
        display: grid;
        gap: 20px;
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </head>

  <body>
    <main class="card">
      <section class="who" aria-labelledby="name">
        <img class="photo" src="/images/card/matteo-240.webp" srcset="/images/card/matteo-240.webp 1x, /images/card/matteo-480.webp 2x" width="112" height="112" alt="Matteo Arellano" />
        <p class="kicker">Technical Growth Partner</p>
        <h1 id="name">Matteo Arellano</h1>
        <p class="lede">I help companies find new ways to grow and turn them into revenue.</p>
      </section>

      <div class="side">
        <nav class="actions" aria-label="Contact Matteo">
          <a class="action action--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a9.7 9.7 0 0 0-8.3 14.7L2.4 22l5.4-1.4A9.8 9.8 0 1 0 12 2Zm0 17.7a7.7 7.7 0 0 1-3.9-1.1l-.3-.2-3.2.8.9-3.1-.2-.3A7.8 7.8 0 1 1 12 19.7Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.3 6.3 0 0 1-3.1-2.7c-.2-.3 0-.4.1-.5l.6-.7c.1-.2.2-.4.1-.6l-.7-1.7c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3.1 5 4.2 3 .9 3 .6 3.5.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .2-1.1-.1-.1-.2-.2-.4-.3Z"></path></svg>
            <strong>Message me on WhatsApp</strong>
          </a>
          <a class="action" href={`tel:${phoneTel}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z"></path></svg>
            <strong>Call</strong>
            <small>Phone</small>
          </a>
          <a class="action" href={`mailto:${email}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4z M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg>
            <strong>Email</strong>
            <small>{email}</small>
          </a>
          <a class="action" href="/matteo-arellano.vcf" download="Matteo-Arellano.vcf" style="grid-column: 1 / -1;">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.4 0-8 2.2-8 5v1h11.2a6.5 6.5 0 0 1-.2-1.5c0-1.7.7-3.3 1.8-4.5A13 13 0 0 0 12 14Zm7 1v3h-3v2h3v3h2v-3h3v-2h-3v-3h-2Z"></path></svg>
            <strong>Save contact</strong>
            <small>Name, phone, email and website in your address book</small>
          </a>
        </nav>

        <div class="phone">
          <a href={`tel:${phoneTel}`} aria-label={`Call ${phoneDisplay}`}>{phoneDisplay}</a>
          <button type="button" data-copy={phoneTel}>Copy number</button>
        </div>

        <button class="qr" type="button" data-qr-open aria-haspopup="dialog">
          <span class="qr-code"><img src="/images/card/card-qr.svg" width="29" height="29" alt="QR code that opens this card" /></span>
          <span>
            <strong>Show my QR code</strong>
            <small>Let someone scan it with their phone camera to open this card.</small>
            <em>Tap to enlarge</em>
          </span>
        </button>

        <ul class="links">
          {
            links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  <span>
                    <strong>{link.label}</strong>
                    <small>{link.note}</small>
                  </span>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>

        <button class="share" type="button" data-share>Share this card</button>
        <p class="feedback" aria-live="polite" data-feedback></p>
      </div>
    </main>

    <dialog class="qr-full" aria-label="QR code" data-qr>
      <div class="qr-full-inner">
        <img src="/images/card/card-qr.svg" width="29" height="29" alt="QR code that opens matteoarellano.com/card" />
        <p>Scan to open my card</p>
        <small>matteoarellano.com/card</small>
        <form method="dialog"><button type="submit">Close</button></form>
      </div>
    </dialog>

    <script is:inline define:vars={{ cardUrl }}>
      const feedback = document.querySelector("[data-feedback]");
      const say = (text) => {
        if (!feedback) return;
        feedback.textContent = text;
        setTimeout(() => (feedback.textContent = ""), 2400);
      };

      // Copy the phone number.
      document.querySelector("[data-copy]")?.addEventListener("click", async (event) => {
        const value = event.currentTarget.dataset.copy;
        try {
          await navigator.clipboard.writeText(value);
          say("Number copied.");
        } catch {
          window.prompt("Copy this number:", value);
        }
      });

      // Large QR: fill the screen and keep it awake while someone scans.
      const qr = document.querySelector("[data-qr]");
      let wakeLock = null;
      document.querySelector("[data-qr-open]")?.addEventListener("click", async () => {
        qr?.showModal();
        try {
          wakeLock = await navigator.wakeLock?.request("screen");
        } catch {
          /* Not supported or not allowed; the QR still shows. */
        }
      });
      qr?.addEventListener("click", (event) => {
        if (event.target === qr || event.target.closest(".qr-full-inner img")) qr.close();
      });
      qr?.addEventListener("close", () => {
        wakeLock?.release?.();
        wakeLock = null;
      });

      // Share the card, or copy its link.
      document.querySelector("[data-share]")?.addEventListener("click", async () => {
        const data = { title: "Matteo Arellano", text: "Matteo Arellano, Technical Growth Partner", url: cardUrl };
        if (navigator.share) {
          try {
            await navigator.share(data);
            return;
          } catch (error) {
            if (error && error.name === "AbortError") return;
          }
        }
        try {
          await navigator.clipboard.writeText(cardUrl);
          say("Card link copied.");
        } catch {
          window.prompt("Copy this card link:", cardUrl);
        }
      });
    </script>
  </body>
</html>
