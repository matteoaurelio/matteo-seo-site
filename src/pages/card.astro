---
const cardUrl = "https://matteoarellano.com/card/";
const websiteUrl = "https://matteoarellano.com/";
const linkedinUrl = "https://www.linkedin.com/in/matteoarellano";
const whatsappUrl =
  "https://wa.me/525574136001?text=Hi%20Matteo%2C%20I%20came%20across%20your%20digital%20card.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#07111f" />

    <title>Matteo Arellano | Digital Business Card</title>

    <meta
      name="description"
      content="Matteo Arellano — Technical Growth Partner & Social Entrepreneur. Connect via website, LinkedIn, WhatsApp or save my contact."
    />

    <link rel="canonical" href={cardUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph -->

    <meta property="og:type" content="website" />

    <meta property="og:url" content={cardUrl} />

    <meta
      property="og:title"
      content="Matteo Arellano | Technical Growth Partner"
    />

    <meta
      property="og:description"
      content="I partner with companies to create new revenue opportunities, improve conversion and remove costly operational friction."
    />

    <meta
      property="og:image"
      content="https://matteoarellano.com/images/card-preview.jpg"
    />

    <meta property="og:image:width" content="1200" />

    <meta property="og:image:height" content="630" />

    <meta
      property="og:image:alt"
      content="Matteo Arellano — Technical Growth Partner & Social Entrepreneur"
    />

    <!-- Twitter -->

    <meta name="twitter:card" content="summary_large_image" />

    <meta
      name="twitter:title"
      content="Matteo Arellano | Technical Growth Partner"
    />

    <meta
      name="twitter:description"
      content="Commercial growth, product, acquisition, data and automation."
    />

    <meta
      name="twitter:image"
      content="https://matteoarellano.com/images/card-preview.jpg"
    />

    <style is:global>
      :root {
        color-scheme: dark;

        --page: #050b14;

        --card: #071321;
        --card-deep: #06101c;

        --surface: rgba(255, 255, 255, 0.045);
        --surface-hover: rgba(255, 255, 255, 0.075);

        --border: rgba(151, 198, 226, 0.17);
        --border-strong: rgba(80, 190, 241, 0.34);

        --text: #f5f8fb;

        --muted: #91a7b9;
        --muted-light: #c2cfda;

        --blue: #2aa8ed;
        --cyan: #55d6d0;

        --warm: #e2b972;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-width: 320px;

        background: var(--page);
      }

      body {
        min-height: 100vh;

        margin: 0;

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        color: var(--text);

        background:
          radial-gradient(
            circle at 82% 5%,
            rgba(32, 150, 212, 0.16),
            transparent 29rem
          ),
          radial-gradient(
            circle at 8% 92%,
            rgba(80, 213, 205, 0.08),
            transparent 28rem
          ),
          #050b14;
      }

      button,
      a {
        font: inherit;
      }

      button {
        border: 0;
      }

      /* -------------------------
         PAGE
      ------------------------- */

      .card-page {
        min-height: 100vh;

        display: grid;
        place-items: center;

        padding: clamp(16px, 4vw, 48px);
      }

      /* -------------------------
         CARD
      ------------------------- */

      .digital-card {
        position: relative;

        width: min(1080px, 100%);

        min-height: 680px;

        display: grid;

        grid-template-columns:
          minmax(0, 1.12fr)
          minmax(350px, 0.88fr);

        overflow: hidden;

        border: 1px solid var(--border);

        border-radius: 34px;

        background:
          linear-gradient(128deg, rgba(255, 255, 255, 0.035), transparent 32%),
          linear-gradient(145deg, #091727 0%, #07111f 55%, #050d18 100%);

        box-shadow:
          0 40px 100px rgba(0, 0, 0, 0.45),
          inset 0 1px 0 rgba(255, 255, 255, 0.045);

        isolation: isolate;
      }

      /* -------------------------
         AMBIENT LIGHT
      ------------------------- */

      .ambient {
        position: absolute;

        border-radius: 999px;

        filter: blur(70px);

        pointer-events: none;

        z-index: -2;
      }

      .ambient-one {
        width: 300px;
        height: 300px;

        top: -160px;
        right: 80px;

        background: rgba(44, 174, 236, 0.22);
      }

      .ambient-two {
        width: 240px;
        height: 240px;

        bottom: -160px;
        left: 24%;

        background: rgba(83, 215, 205, 0.09);
      }

      /* -------------------------
         FLOW LINES
      ------------------------- */

      .flow-lines {
        position: absolute;

        right: -80px;
        bottom: -20px;

        width: 72%;
        height: auto;

        opacity: 0.2;

        pointer-events: none;

        z-index: -1;
      }

      .flow-lines path {
        fill: none;

        stroke: #2f9edb;

        stroke-width: 1;
      }

      /* -------------------------
         LEFT PANEL
      ------------------------- */

      .identity-panel {
        padding: clamp(42px, 5vw, 68px);

        display: flex;
        flex-direction: column;
      }

      .identity-topline {
        display: inline-flex;

        align-items: center;

        gap: 9px;

        color: #9fb4c3;

        font-size: 0.76rem;

        letter-spacing: 0.035em;
      }

      .status-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #66daa5;

        box-shadow: 0 0 0 5px rgba(102, 218, 165, 0.09);
      }

      /* -------------------------
         IDENTITY
      ------------------------- */

      .identity {
        margin-top: 72px;
      }

      .eyebrow {
        margin: 0 0 14px;

        color: #5cc7f5;

        font-size: 0.72rem;

        font-weight: 800;

        letter-spacing: 0.15em;

        text-transform: uppercase;
      }

      h1 {
        max-width: 620px;

        margin: 0;

        font-family: Georgia, "Times New Roman", serif;

        font-size: clamp(4rem, 7vw, 6.4rem);

        font-weight: 400;

        line-height: 0.84;

        letter-spacing: -0.06em;
      }

      h1 span {
        display: block;

        color: #45b9ef;
      }

      .role {
        margin: 30px 0 0;

        color: #d4dee7;

        font-size: clamp(0.88rem, 1.5vw, 1.02rem);

        font-weight: 560;

        line-height: 1.55;

        letter-spacing: 0.025em;
      }

      .role b {
        color: var(--cyan);

        font-weight: 700;
      }

      /* -------------------------
         VALUE PROPOSITION
      ------------------------- */

      .value-proposition {
        max-width: 590px;

        margin: 26px 0 0;

        color: #aebfcb;

        font-size: 1rem;

        line-height: 1.7;
      }

      /* -------------------------
         YEELEN
      ------------------------- */

      .founder-note {
        width: fit-content;

        max-width: 100%;

        margin-top: 27px;

        display: inline-flex;

        align-items: center;

        gap: 12px;

        padding: 10px 12px 10px 10px;

        border: 1px solid rgba(226, 185, 114, 0.17);

        border-radius: 999px;

        color: inherit;

        background: rgba(226, 185, 114, 0.045);

        text-decoration: none;

        transition:
          background 180ms ease,
          border-color 180ms ease,
          transform 180ms ease;
      }

      .founder-note:hover {
        transform: translateY(-2px);

        border-color: rgba(226, 185, 114, 0.32);

        background: rgba(226, 185, 114, 0.075);
      }

      .founder-mark {
        width: 34px;
        height: 34px;

        display: grid;

        place-items: center;

        border-radius: 50%;

        color: #14202a;

        background: var(--warm);

        font-family: Georgia, serif;

        font-weight: 700;
      }

      .founder-note > span:nth-child(2) {
        display: grid;

        gap: 1px;
      }

      .founder-note small {
        color: #9eaaae;

        font-size: 0.66rem;
      }

      .founder-note strong {
        font-size: 0.82rem;

        font-weight: 680;
      }

      .founder-arrow {
        margin-left: 3px;

        color: var(--warm);
      }

      /* -------------------------
         CONTACT ACTIONS
      ------------------------- */

      .contact-actions {
        margin-top: auto;

        padding-top: 48px;

        display: grid;

        grid-template-columns: repeat(2, minmax(0, 1fr));

        gap: 11px;
      }

      .contact-action {
        min-width: 0;

        display: grid;

        grid-template-columns:
          auto
          1fr
          auto;

        align-items: center;

        gap: 12px;

        padding: 14px 15px;

        border: 1px solid var(--border);

        border-radius: 16px;

        color: var(--text);

        background: var(--surface);

        text-align: left;

        text-decoration: none;

        cursor: pointer;

        transition:
          transform 180ms ease,
          border-color 180ms ease,
          background 180ms ease;
      }

      .contact-action:hover {
        transform: translateY(-2px);

        border-color: var(--border-strong);

        background: var(--surface-hover);
      }

      .contact-icon {
        width: 37px;
        height: 37px;

        display: grid;

        place-items: center;

        border-radius: 11px;

        color: #5ec7f3;

        background: rgba(43, 168, 237, 0.095);
      }

      .contact-icon svg {
        width: 21px;
        height: 21px;

        fill: currentColor;
      }

      .contact-icon--brand {
        overflow: hidden;

        background: transparent;
      }

      .contact-icon--brand img {
        width: 37px;
        height: 37px;

        display: block;
      }

      .contact-copy {
        min-width: 0;

        display: grid;

        gap: 2px;
      }

      .contact-copy small {
        overflow: hidden;

        color: #778e9f;

        font-size: 0.63rem;

        text-overflow: ellipsis;

        white-space: nowrap;
      }

      .contact-copy strong {
        font-size: 0.83rem;

        font-weight: 680;
      }

      .action-arrow {
        color: #638398;

        font-size: 0.82rem;
      }

      /* -------------------------
         RIGHT PANEL
      ------------------------- */

      .visual-panel {
        position: relative;

        padding: 48px 46px 42px 20px;

        display: flex;

        flex-direction: column;

        justify-content: center;
      }

      .visual-panel::before {
        content: "";

        position: absolute;

        inset: 0 0 0 12%;

        border-left: 1px solid rgba(148, 196, 224, 0.09);

        background: linear-gradient(
          180deg,
          rgba(20, 56, 82, 0.09),
          transparent 58%
        );

        z-index: -1;
      }

      /* -------------------------
         PORTRAIT
      ------------------------- */

      .portrait-frame {
        position: relative;

        width: min(100%, 390px);

        aspect-ratio: 0.88;

        margin: 0 auto;

        overflow: hidden;

        border: 1px solid rgba(107, 190, 228, 0.28);

        border-radius: 49% 51% 44% 56% / 39% 41% 59% 61%;

        background: #102132;

        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
      }

      .portrait-halo {
        position: absolute;

        inset: -35% -40% auto auto;

        width: 90%;
        height: 70%;

        border-radius: 50%;

        background: rgba(60, 184, 236, 0.22);

        filter: blur(38px);

        z-index: 1;

        pointer-events: none;
      }

      .portrait {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;

        object-position: center 30%;

        filter: saturate(0.92) contrast(1.03);
      }

      /* -------------------------
         QR PANEL
      ------------------------- */

      .scan-panel {
        width: min(100%, 390px);

        margin: 24px auto 0;

        display: grid;

        grid-template-columns:
          1fr
          auto;

        align-items: center;

        gap: 18px;

        padding: 17px;

        border: 1px solid var(--border);

        border-radius: 18px;

        background: rgba(255, 255, 255, 0.036);

        backdrop-filter: blur(8px);
      }

      .scan-copy {
        display: grid;

        gap: 4px;
      }

      .scan-copy > span {
        color: #66c8ef;

        font-size: 0.64rem;

        font-weight: 800;

        letter-spacing: 0.1em;

        text-transform: uppercase;
      }

      .scan-copy strong {
        font-size: 1rem;

        font-weight: 700;
      }

      .scan-copy p {
        margin: 2px 0 0;

        color: #8498a8;

        font-size: 0.72rem;

        line-height: 1.45;
      }

      .qr-wrap {
        width: 86px;
        height: 86px;

        display: grid;

        place-items: center;

        padding: 7px;

        border-radius: 12px;

        background: white;
      }

      .qr-wrap img {
        width: 100%;
        height: 100%;

        display: block;
      }

      /* -------------------------
         SHARE
      ------------------------- */

      .share-button {
        width: min(100%, 390px);

        margin: 12px auto 0;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 9px;

        padding: 14px 18px;

        border: 1px solid rgba(80, 190, 241, 0.27);

        border-radius: 15px;

        color: #07121d;

        background: linear-gradient(135deg, #66d7d0, #4ebef0);

        font-weight: 780;

        cursor: pointer;

        box-shadow: 0 14px 34px rgba(45, 173, 229, 0.13);

        transition:
          transform 180ms ease,
          box-shadow 180ms ease;
      }

      .share-button:hover {
        transform: translateY(-2px);

        box-shadow: 0 18px 42px rgba(45, 173, 229, 0.2);
      }

      .share-button svg {
        width: 17px;
        height: 17px;

        fill: currentColor;
      }

      .share-feedback {
        min-height: 1.2em;

        margin: 8px 0 -18px;

        color: #8eabba;

        font-size: 0.68rem;

        text-align: center;
      }

      /* -------------------------
         MOBILE PORTRAIT
      ------------------------- */

      .portrait-mobile {
        display: none;
      }

      /* -------------------------
         TABLET / MOBILE
      ------------------------- */

      @media (max-width: 820px) {
        .card-page {
          display: block;

          padding: 0;
        }

        .digital-card {
          min-height: 100vh;

          grid-template-columns: 1fr;

          border: 0;

          border-radius: 0;
        }

        .identity-panel {
          padding: 28px 22px 34px;
        }

        .identity {
          margin-top: 29px;

          text-align: center;
        }

        .portrait-mobile {
          width: 124px;
          height: 124px;

          margin: 32px auto 0;

          display: block;

          overflow: hidden;

          border: 2px solid rgba(79, 190, 237, 0.46);

          border-radius: 46% 54% 48% 52% / 42% 45% 55% 58%;

          box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
        }

        .portrait-mobile img {
          width: 100%;
          height: 100%;

          display: block;

          object-fit: cover;

          object-position: center 22%;
        }

        h1 {
          font-size: clamp(3.7rem, 19vw, 5.3rem);

          line-height: 0.86;
        }

        .role {
          margin-top: 24px;
        }

        .value-proposition {
          max-width: 500px;

          margin: 22px auto 0;

          font-size: 0.94rem;

          text-align: center;
        }

        .founder-note {
          margin: 23px auto 0;
        }

        .contact-actions {
          margin-top: 34px;

          padding-top: 0;
        }

        .visual-panel {
          padding: 0 22px 36px;
        }

        .visual-panel::before,
        .portrait-frame {
          display: none;
        }

        .scan-panel,
        .share-button {
          width: 100%;
        }

        .flow-lines {
          width: 140%;

          right: -60%;

          bottom: 130px;

          opacity: 0.13;
        }
      }

      /* -------------------------
         SMALL MOBILE
      ------------------------- */

      @media (max-width: 460px) {
        .identity-topline {
          font-size: 0.68rem;
        }

        .contact-actions {
          grid-template-columns: 1fr;
        }

        .contact-action {
          padding: 13px 14px;
        }

        .scan-copy p {
          max-width: 170px;
        }

        .qr-wrap {
          width: 78px;
          height: 78px;
        }
      }

      /* -------------------------
         ACCESSIBILITY
      ------------------------- */

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;

          transition-duration: 0.001ms !important;

          animation-duration: 0.001ms !important;

          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </head>

  <body>
    <main class="card-page">
      <article class="digital-card">
        <div class="ambient ambient-one" aria-hidden="true"></div>

        <div class="ambient ambient-two" aria-hidden="true"></div>

        <svg class="flow-lines" viewBox="0 0 900 240" aria-hidden="true">
          <path d="M-20 184C129 112 242 217 381 156S642 54 930 120"> </path>

          <path d="M-30 203C125 131 242 238 389 174S650 73 934 139"> </path>

          <path d="M-40 222C119 151 241 257 397 194S660 94 940 159"> </path>
        </svg>

        <!-- LEFT SIDE -->

        <section class="identity-panel">
          <div class="identity-topline">
            <span class="status-dot" aria-hidden="true"> </span>

            <span> Open to meaningful collaborations </span>
          </div>

          <!-- Mobile portrait -->

          <div class="portrait-mobile" aria-hidden="true">
            <img src="/images/matteo-arellano-visibility-signup.jpg" alt="" />
          </div>

          <header class="identity">
            <p class="eyebrow">Technical Growth Partner</p>

            <h1>
              Matteo
              <span>Arellano</span>
            </h1>

            <p class="role">
              Technical Growth Partner
              <b>&amp;</b>
              Social Entrepreneur
            </p>
          </header>

          <p class="value-proposition">
            I partner with companies to create new revenue opportunities,
            improve conversion and remove costly operational friction.
          </p>

          <!-- YEELEN -->

          <a
            class="founder-note"
            href="https://yeelen.page/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="founder-mark" aria-hidden="true"> Y </span>

            <span>
              <small> I also build </small>

              <strong> Founder of Yeelen </strong>
            </span>

            <span class="founder-arrow" aria-hidden="true"> ↗ </span>
          </a>

          <!-- CONTACT BUTTONS -->

          <nav class="contact-actions" aria-label="Contact Matteo">
            <!-- Website -->

            <a
              class="contact-action"
              href={websiteUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="contact-icon contact-icon--brand" aria-hidden="true">
                <img src="/favicon.svg" alt="" />
              </span>

              <span class="contact-copy">
                <small> Explore my work </small>

                <strong> Website </strong>
              </span>

              <span class="action-arrow" aria-hidden="true"> ↗ </span>
            </a>

            <!-- LinkedIn -->

            <a
              class="contact-action"
              href={linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M6.5 8.3H3V21h3.5V8.3ZM4.75 3A2.05 2.05 0 1 0 4.75 7.1 2.05 2.05 0 0 0 4.75 3ZM21 13.7c0-3.8-2-5.6-4.7-5.6-2.2 0-3.1 1.2-3.7 2V8.3H9.1V21h3.5v-6.3c0-1.7.3-3.3 2.4-3.3 2 0 2.1 1.9 2.1 3.4V21H21v-7.3Z"
                  >
                  </path>
                </svg>
              </span>

              <span class="contact-copy">
                <small> Professional profile </small>

                <strong> LinkedIn </strong>
              </span>

              <span class="action-arrow" aria-hidden="true"> ↗ </span>
            </a>

            <!-- WhatsApp -->

            <a
              class="contact-action"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 2a9.7 9.7 0 0 0-8.3 14.7L2.4 22l5.4-1.4A9.8 9.8 0 1 0 12 2Zm0 17.7a7.7 7.7 0 0 1-3.9-1.1l-.3-.2-3.2.8.9-3.1-.2-.3A7.8 7.8 0 1 1 12 19.7Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.3 6.3 0 0 1-3.1-2.7c-.2-.3 0-.4.1-.5l.6-.7c.1-.2.2-.4.1-.6l-.7-1.7c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3.1 5 4.2 3 .9 3 .6 3.5.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .2-1.1-.1-.1-.2-.2-.4-.3Z"
                  >
                  </path>
                </svg>
              </span>

              <span class="contact-copy">
                <small> Send me a message </small>

                <strong> WhatsApp </strong>
              </span>

              <span class="action-arrow" aria-hidden="true"> ↗ </span>
            </a>

            <!-- Save contact -->

            <button class="contact-action" id="saveContact" type="button">
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.4 0-8 2.2-8 5v1h11.2a6.5 6.5 0 0 1-.2-1.5c0-1.7.7-3.3 1.8-4.5A13 13 0 0 0 12 14Zm7 1v3h-3v2h3v3h2v-3h3v-2h-3v-3h-2Z"
                  >
                  </path>
                </svg>
              </span>

              <span class="contact-copy">
                <small> Add to your phone </small>

                <strong> Save Contact </strong>
              </span>

              <span class="action-arrow" aria-hidden="true"> ↓ </span>
            </button>
          </nav>
        </section>

        <!-- RIGHT SIDE -->

        <aside class="visual-panel">
          <div class="portrait-frame">
            <div class="portrait-halo" aria-hidden="true"></div>

            <img
              src="/images/matteo-arellano-visibility-signup.jpg"
              alt="Matteo Arellano"
              class="portrait"
            />
          </div>

          <!-- QR -->

          <section class="scan-panel" aria-label="QR code to this digital card">
            <div class="scan-copy">
              <span> Keep this card </span>

              <strong> Scan to connect </strong>

              <p>Open this page again on any device.</p>
            </div>

            <div class="qr-wrap">
              <img
                src="/images/matteo-card-qr.svg"
                alt="QR code for matteoarellano.com/card"
              />
            </div>
          </section>

          <!-- Share -->

          <button class="share-button" id="shareCard" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M18 16a3 3 0 0 0-2.4 1.2l-6.8-4A3.4 3.4 0 0 0 9 12c0-.4-.1-.8-.2-1.2l6.8-4A3 3 0 1 0-1-1.7l-6.8 4A3 3 0 1 0 5 15a3 3 0 0 0 2.8-1.9l6.8 4A3 3 0 1 0 18 16Z"
              >
              </path>
            </svg>

            <span> Share my card </span>
          </button>

          <p class="share-feedback" id="shareFeedback" aria-live="polite"></p>
        </aside>
      </article>
    </main>

    <script define:vars={{ cardUrl }}>
      const saveContactButton = document.getElementById("saveContact");

      const shareButton = document.getElementById("shareCard");

      const shareFeedback = document.getElementById("shareFeedback");

      /* -------------------------
         SAVE VCARD
      ------------------------- */

      saveContactButton?.addEventListener("click", () => {
        const vCard = [
          "BEGIN:VCARD",
          "VERSION:3.0",
          "N:Arellano;Matteo;;;",
          "FN:Matteo Arellano",
          "TITLE:Technical Growth Partner & Social Entrepreneur",
          "ORG:Matteo Arellano",
          "TEL;TYPE=CELL:+525574136001",
          "EMAIL;TYPE=INTERNET:matteo.visibility@gmail.com",
          "URL:https://matteoarellano.com/",
          "X-SOCIALPROFILE;TYPE=linkedin:https://www.linkedin.com/in/matteoarellano",
          "NOTE:Technical Growth Partner. Founder of Yeelen.",
          "END:VCARD",
        ].join("\r\n");

        const blob = new Blob([vCard], {
          type: "text/vcard;charset=utf-8",
        });

        const url = URL.createObjectURL(blob);

        const link = document.createElement("a");

        link.href = url;

        link.download = "Matteo-Arellano.vcf";

        document.body.appendChild(link);

        link.click();

        link.remove();

        setTimeout(() => URL.revokeObjectURL(url), 1000);
      });

      /* -------------------------
         SHARE CARD
      ------------------------- */

      shareButton?.addEventListener("click", async () => {
        const shareData = {
          title: "Matteo Arellano",

          text: "Matteo Arellano — Technical Growth Partner & Social Entrepreneur",

          url: cardUrl,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);

            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === "AbortError") {
              return;
            }
          }
        }

        try {
          await navigator.clipboard.writeText(cardUrl);

          if (shareFeedback) {
            shareFeedback.textContent = "Card link copied.";
          }

          setTimeout(() => {
            if (shareFeedback) {
              shareFeedback.textContent = "";
            }
          }, 2200);
        } catch {
          window.prompt("Copy this card link:", cardUrl);
        }
      });
    </script>
  </body>
</html>
