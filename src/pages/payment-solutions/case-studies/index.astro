---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import CaseStudyHero from "../../../components/CaseStudyHero.astro";
import {
  sortedPaymentCaseStudies,
  caseRegions,
  caseTechnologies,
  slugify,
} from "../../../data/paymentCaseStudies";
import { paymentGuides } from "../../../data/paymentGuides";
import "../../../styles/growth-platform.css";
import "../../../styles/case-studies.css";

const site = "https://matteoarellano.com";
const canonical = `${site}/payment-solutions/case-studies/`;
const title = "Payment Case Studies and Guides | Matteo Arellano";
const description =
  "Anonymised payment case studies and step-by-step payment guides: what went wrong, why, and how to solve it. Filter by region and payment technology.";

const cases = sortedPaymentCaseStudies();

const countBy = (test: (item: (typeof cases)[number]) => boolean) => cases.filter(test).length;

const regionFilters = caseRegions.map((region) => ({
  label: region,
  value: slugify(region),
  count: countBy((item) => item.region === region),
}));

const techFilters = caseTechnologies.map((tech) => ({
  label: tech,
  value: slugify(tech),
  count: countBy((item) => item.technologies.includes(tech)),
}));

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": `${site}/#website` },
      author: { "@id": `${site}/#person` },
      breadcrumb: { "@id": `${canonical}#breadcrumb` },
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: cases.length + paymentGuides.length,
        itemListElement: [
          ...cases.map((item) => ({ url: `${canonical}${item.slug}/`, name: item.title })),
          ...paymentGuides.map((guide) => ({
            url: `${site}/payment-solutions/guides/${guide.slug}/`,
            name: guide.title,
          })),
        ].map((entry, index) => ({ "@type": "ListItem", position: index + 1, ...entry })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        {
          "@type": "ListItem",
          position: 2,
          name: "Payment solutions",
          item: `${site}/payment-solutions/`,
        },
        { "@type": "ListItem", position: 3, name: "Case studies", item: canonical },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/case-studies/lofoten-coast-og.jpg"
>
  <Header />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="cs-page">
    <CaseStudyHero
      crumbLabel="Payment solutions"
      crumbHref="/payment-solutions/"
      title="Case studies"
      titleId="cs-title"
    >
      Anonymised · insight-led
    </CaseStudyHero>

    <section class="cs-shell cs-intro">
      <p>
        Real payment problems, without client names. Each case study explains
        what went wrong, why it went wrong and how to solve it. When the real
        company could be identified, the example uses a different industry
        with the same characteristics, and the case study says so.
      </p>
    </section>

    <section class="cs-shell cs-browse" aria-labelledby="browse-title">
      <h2 class="cs-visually-hidden" id="browse-title">Browse case studies</h2>

      <div class="cs-filters" data-cs-filters hidden>
        <div class="cs-filter-group" role="group" aria-labelledby="filter-region">
          <span class="cs-filter-label" id="filter-region">Region</span>
          <div class="cs-chips">
            <button type="button" class="cs-chip" data-cs-filter="region" data-value="all" aria-pressed="true">
              All regions
            </button>
            {
              regionFilters.map((filter) => (
                <button
                  type="button"
                  class="cs-chip"
                  data-cs-filter="region"
                  data-value={filter.value}
                  aria-pressed="false"
                >
                  {filter.label}
                  <span class="cs-chip-count" data-cs-count>{filter.count}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="cs-filter-group" role="group" aria-labelledby="filter-tech">
          <span class="cs-filter-label" id="filter-tech">Technology</span>
          <div class="cs-chips">
            <button type="button" class="cs-chip" data-cs-filter="tech" data-value="all" aria-pressed="true">
              All technologies
            </button>
            {
              techFilters.map((filter) => (
                <button
                  type="button"
                  class="cs-chip"
                  data-cs-filter="tech"
                  data-value={filter.value}
                  aria-pressed="false"
                >
                  {filter.label}
                  <span class="cs-chip-count" data-cs-count>{filter.count}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="cs-filter-footer">
          <p class="cs-result-count" role="status" aria-live="polite" data-cs-status>
            Showing {cases.length} {cases.length === 1 ? "case study" : "case studies"}
          </p>
          <button type="button" class="cs-clear" data-cs-reset hidden>Clear filters</button>
        </div>
      </div>

      <ol class="cs-list">
        {
          cases.map((item, index) => (
            <li
              class="cs-item"
              data-cs-item
              data-region={slugify(item.region)}
              data-tech={item.technologies.map(slugify).join(" ")}
            >
              <a href={`/payment-solutions/case-studies/${item.slug}/`}>
                <span class="cs-item-number">{String(cases.length - index).padStart(2, "0")}</span>
                <div class="cs-item-body">
                  {item.status && <p class="cs-status-badge">{item.status}</p>}
                  <h3>{item.title}</h3>
                  <p class="cs-item-summary">{item.summary}</p>
                  <ul class="cs-item-tags" aria-label="Region and technology">
                    <li>{item.region} · {item.country}</li>
                    {item.technologies.map((tech) => <li>{tech}</li>)}
                  </ul>
                  <p class="cs-item-date">
                    <time datetime={item.published}>{formatDate(item.published)}</time> ·{" "}
                    {item.readingMinutes} min read
                  </p>
                </div>
                <span class="cs-item-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>

      <p class="cs-empty" data-cs-empty hidden>
        No case studies match these filters yet.
        <button type="button" data-cs-reset>Clear filters</button>
      </p>
    </section>

    <section class="cs-shell cs-guides" id="guides" aria-labelledby="guides-title">
      <div class="cs-section-head">
        <h2 id="guides-title">Guides</h2>
        <p>How payments work, explained step by step for managers and non-technical teams.</p>
      </div>
      <ol class="cs-list">
        {
          paymentGuides.map((guide) => (
            <li class="cs-item">
              <a href={`/payment-solutions/guides/${guide.slug}/`}>
                <span class="cs-item-number">Guide</span>
                <div class="cs-item-body">
                  <h3>{guide.title}</h3>
                  <p class="cs-item-summary">{guide.summary}</p>
                  <ul class="cs-item-tags" aria-label="Topics">
                    {guide.tags.slice(0, 5).map((tag) => <li>{tag}</li>)}
                  </ul>
                  <p class="cs-item-date">
                    <time datetime={guide.published}>{formatDate(guide.published)}</time> ·{" "}
                    {guide.readingMinutes} min read · {guide.audience}
                  </p>
                </div>
                <span class="cs-item-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cs-shell cs-closing">
      <p>Do you have a payment problem like these?</p>
      <div class="cs-closing-links">
        <a href="mailto:matteo.visibility@gmail.com?subject=Payment%20problem">matteo.visibility@gmail.com</a>
        <a href="/payment-solutions/">How I help with payments →</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  type Group = "region" | "tech";

  const filters = document.querySelector<HTMLElement>("[data-cs-filters]");
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-cs-item]"));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-cs-filter]"));
  const empty = document.querySelector<HTMLElement>("[data-cs-empty]");
  const status = document.querySelector<HTMLElement>("[data-cs-status]");
  const clearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-cs-reset]"));
  const state: Record<Group, string> = { region: "all", tech: "all" };

  // The filters only appear when JavaScript runs; without it, every case is listed.
  filters?.removeAttribute("hidden");

  const matches = (item: HTMLElement, region: string, tech: string) =>
    (region === "all" || item.dataset.region === region) &&
    (tech === "all" || (item.dataset.tech ?? "").split(" ").includes(tech));

  function render(updateUrl = true) {
    let visible = 0;
    items.forEach((item) => {
      item.hidden = !matches(item, state.region, state.tech);
      if (!item.hidden) visible += 1;
    });

    // Counts show how many cases each option would give, combined with the other filter.
    chips.forEach((chip) => {
      const group = chip.dataset.csFilter as Group;
      const value = chip.dataset.value ?? "all";
      chip.setAttribute("aria-pressed", String(state[group] === value));

      if (value === "all") return;
      const other: Group = group === "region" ? "tech" : "region";
      const count = items.filter((item) =>
        group === "region" ? matches(item, value, state[other]) : matches(item, state[other], value),
      ).length;
      const countEl = chip.querySelector<HTMLElement>("[data-cs-count]");
      if (countEl) countEl.textContent = String(count);
      chip.disabled = count === 0 && state[group] !== value;
    });

    const filtered = state.region !== "all" || state.tech !== "all";
    clearButtons.forEach((button) => {
      if (button.classList.contains("cs-clear")) button.hidden = !filtered;
    });
    if (empty) empty.hidden = visible > 0;
    if (status) {
      const noun = visible === 1 ? "case study" : "case studies";
      status.textContent = filtered
        ? `Showing ${visible} of ${items.length} ${items.length === 1 ? "case study" : "case studies"}`
        : `Showing ${visible} ${noun}`;
    }

    if (updateUrl) {
      const params = new URLSearchParams();
      if (state.region !== "all") params.set("region", state.region);
      if (state.tech !== "all") params.set("technology", state.tech);
      const query = params.toString();
      history.replaceState(null, "", query ? `?${query}` : location.pathname);
    }
  }

  // Filters can be shared as links, for example ?region=latam&technology=oxxo-pay
  const params = new URLSearchParams(location.search);
  const known = (group: Group, value: string | null) =>
    !!value && chips.some((chip) => chip.dataset.csFilter === group && chip.dataset.value === value);
  if (known("region", params.get("region"))) state.region = params.get("region")!;
  if (known("tech", params.get("technology"))) state.tech = params.get("technology")!;
  render(false);

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const chip = target.closest<HTMLButtonElement>("[data-cs-filter]");
    if (chip && !chip.disabled) {
      const group = chip.dataset.csFilter as Group;
      const value = chip.dataset.value ?? "all";
      // Selecting an active option again turns it off.
      state[group] = state[group] === value && value !== "all" ? "all" : value;
      render();
    }
    if (target.closest("[data-cs-reset]")) {
      state.region = "all";
      state.tech = "all";
      render();
    }
  });
</script>
