---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import CaseStudyHero from "../../../../components/CaseStudyHero.astro";
import { getPaymentCaseStudy } from "../../../../data/paymentCaseStudies";
import "../../../../styles/growth-platform.css";
import "../../../../styles/case-studies.css";

const slug = "dlocal-currency-rejections-colombia";
const study = getPaymentCaseStudy(slug);
if (!study) throw new Error(`Case study not found: ${slug}`);

const site = "https://matteoarellano.com";
const hub = `${site}/payment-solutions/case-studies/`;
const canonical = `${hub}${slug}/`;
const title = "dLocal Currency Rejections in Colombia: Error 5004 and How to Fix It | Case Study";
const description = study.summary;

const publishedLabel = new Date(`${study.published}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const contents = [
  { id: "example", label: "The example: a language school with a currency selector" },
  { id: "local", label: "Why dLocal works with local currencies" },
  { id: "three-currencies", label: "Three currencies that are often mixed up" },
  { id: "docs", label: "What dLocal's documentation says" },
  { id: "diagnose", label: "How to diagnose the problem: five checks" },
  { id: "solve", label: "How to solve it: five options" },
  { id: "providers", label: "How other providers handle currency in Colombia" },
  { id: "south-america", label: "The same rule in other South American markets" },
  { id: "bre-b", label: "Looking ahead: Bre-B" },
  { id: "conclusion", label: "Conclusion and next steps" },
  { id: "faq", label: "Frequently asked questions" },
];

const docFacts = [
  {
    label: "The currency field",
    value: "A three-letter ISO 4217 code in capital letters, for example COP",
  },
  { label: "Currency for Colombia", value: "COP, with 0 decimals in the amount" },
  {
    label: "Customer document in Colombia",
    value: "Required: CC (cédula de ciudadanía) or NIT, 6 to 11 digits",
  },
  {
    label: "Charging the customer in USD",
    value: "Possible with the field currency_to_charge = USD, but only where dLocal makes it available. Example: debit cards in Argentina",
  },
  { label: "Error when the currency is not accepted", value: "HTTP 400, code 5004: \"Currency not allowed for this country.\"" },
  {
    label: "Exchange rates from dLocal",
    value: "An endpoint that returns rates only from USD to a local currency",
  },
];

const checks = [
  {
    title: "Is it a refused request or a declined payment?",
    body: [
      "This is the first thing I check, because the two need different fixes. dLocal returns two kinds of failure. An API error, with an HTTP 400 status and a code in the 5000 range, means that dLocal refused the request before it reached a bank. A payment with the status REJECTED and a code in the 300 range means that the request was valid, but the bank, the card network or a risk check declined it.",
      "Error 5004, \"Currency not allowed for this country\", is in the first group. It is a configuration problem, not a customer problem. That is useful: when you fix the configuration, you fix it for every payment at once.",
    ],
  },
  {
    title: "Is the country and currency combination allowed?",
    body: [
      "Log the country and currency of every request, and compare them with dLocal's country reference. For Colombia, the documented currency is COP. If you want to use USD, ask your dLocal account manager whether USD is enabled for Colombia on your account. Do not assume that a currency that works in one country works in another.",
    ],
  },
  {
    title: "Is the amount in the right format?",
    body: [
      "dLocal's country reference lists 0 decimals for COP. A price converted from EUR 49.99 can produce an amount such as 228,431.57 COP. Round converted amounts to whole pesos before you send them, and apply the same rule to Chile (CLP) and Paraguay (PYG), which also use 0 decimals.",
    ],
  },
  {
    title: "Does the customer have a valid document number?",
    body: [
      "In Colombia, dLocal requires the customer's document: a CC or a NIT with 6 to 11 digits. A missing document can produce error 5001 (\"Missing parameter\"), and an invalid one can produce status code 342 (\"Invalid document\"). This is not a currency problem, but it often appears at the same time, so check it in the same review. Customers who are foreign residents often have a cédula de extranjería (CE). Other providers in Colombia accept this document, so ask dLocal how to handle it.",
    ],
  },
  {
    title: "Does the payment method support the currency?",
    body: [
      "Local payment methods in Colombia work in COP only. dLocal's examples for PSE (bank transfer), Nequi (wallet) and Efecty (cash) all use COP. If a payment method is not available for a combination, dLocal can return error 5010 (\"Method not available\").",
    ],
  },
];

const options = [
  {
    name: "Convert to the local currency at checkout",
    sees: "The final amount in COP before paying",
    risk: "The business, from the moment of conversion",
    effort: "Medium",
  },
  {
    name: "Set prices in local currency",
    sees: "A local price, for example COP 189,900",
    risk: "The business",
    effort: "Medium (one price list per market)",
  },
  {
    name: "Charge in USD where it is allowed",
    sees: "A price in USD; the bank converts it",
    risk: "The customer (and their bank's fees)",
    effort: "Low, but depends on availability",
  },
  {
    name: "Route by currency and card origin",
    sees: "No change",
    risk: "Depends on the route",
    effort: "High (a second provider)",
  },
  {
    name: "Validate before sending, and monitor",
    sees: "No failed payments",
    risk: "No change",
    effort: "Low",
  },
];

const providers = [
  { name: "dLocal", currencies: "COP (USD charging only where dLocal makes it available)" },
  { name: "EBANX", currencies: "COP" },
  { name: "PayU Latam (through PaymentsOS)", currencies: "COP and USD; instalments only in COP" },
  { name: "Wompi (Bancolombia)", currencies: "COP and USD" },
  { name: "PPRO (local acquiring)", currencies: "COP" },
];

const markets = [
  { country: "Argentina", currency: "ARS", decimals: "2", document: "DNI, CUIT or CUIL", note: "USD possible for debit cards (currency_to_charge)" },
  { country: "Bolivia", currency: "BOB", decimals: "2", document: "CI or NIT", note: "" },
  { country: "Brazil", currency: "BRL", decimals: "2", document: "CPF or CNPJ", note: "Full CPF validation" },
  { country: "Chile", currency: "CLP", decimals: "0", document: "CI or RUT", note: "Whole numbers only" },
  { country: "Colombia", currency: "COP", decimals: "0", document: "CC or NIT", note: "Whole numbers only" },
  { country: "Ecuador", currency: "USD", decimals: "2", document: "CI", note: "USD is the official currency" },
  { country: "Paraguay", currency: "PYG", decimals: "0", document: "CI", note: "Whole numbers only" },
  { country: "Peru", currency: "PEN", decimals: "2", document: "DNI or RUC", note: "" },
  { country: "Uruguay", currency: "UYU", decimals: "2", document: "CI or RUT", note: "" },
];

const faqs = [
  {
    question: "What does dLocal error 5004 mean?",
    answer:
      "Error 5004 (HTTP 400) means \"Currency not allowed for this country\". dLocal refused the request because the currency you sent is not allowed for the country of the payment. The request did not reach a bank. Send the local currency of the country (COP for Colombia), or USD only if dLocal has made it available for that country and your account.",
  },
  {
    question: "Which currency should I send to dLocal for payments in Colombia?",
    answer:
      "Send COP. dLocal's country reference lists COP as the currency for Colombia, with 0 decimals, so send the amount as a whole number of pesos.",
  },
  {
    question: "Can I charge customers in Colombia in USD with dLocal?",
    answer:
      "dLocal has a field, currency_to_charge, that charges the customer in USD, but only where dLocal makes it available. The documented example is debit cards in Argentina. dLocal's Colombia page lists only COP, so confirm with your dLocal account manager before you build on it.",
  },
  {
    question: "Is the customer's ID number required for payments in Colombia?",
    answer:
      "Yes. dLocal requires a document for Colombia: a CC (cédula de ciudadanía) or a NIT, with 6 to 11 digits. A missing document can cause error 5001, and an invalid one can cause status code 342.",
  },
  {
    question: "Will a different payment provider solve the currency problem?",
    answer:
      "Usually not. Every provider checked for this article processes local payments in Colombia in COP; some also accept USD. The rule comes from local processing itself, so the solution is in how your checkout handles currencies.",
  },
];

const sources = [
  { name: "dLocal Docs — Create payment (currency and currency_to_charge)", url: "https://docs.dlocal.com/reference/create-payment" },
  { name: "dLocal Docs — Payments HTTP errors (5001, 5004, 5010)", url: "https://docs.dlocal.com/reference/http-errors-payments" },
  { name: "dLocal Docs — Payment status codes (300 range, 342)", url: "https://docs.dlocal.com/reference/payment-status-codes" },
  { name: "dLocal Docs — Country reference", url: "https://docs.dlocal.com/reference/country-reference" },
  { name: "dLocal Docs — Colombia (COP, PSE, Nequi, Efecty, Bre-B)", url: "https://docs.dlocal.com/docs/colombia" },
  { name: "dLocal Docs — Argentina (USD for debit cards)", url: "https://docs.dlocal.com/docs/argentina" },
  { name: "dLocal Docs — Get an exchange rate", url: "https://docs.dlocal.com/api-documentation/payins-api-reference/currency-exchange" },
  { name: "dLocal — Payins (local currency and settlement)", url: "https://www.dlocal.com/our-solution/payins/" },
  {
    name: "dLocal Go Help Center — Exchange rates and who pays them",
    url: "https://helpcenter.dlocalgo.com/en/articles/7169372-what-is-the-exchange-rate-and-how-dlocal-go-apply-it",
  },
  {
    name: "EBANX Docs — Colombia country overview",
    url: "https://docs.ebanx.com/docs/pay-in/processing/payment-methods/country-specific/colombia/colombia-country-overview",
  },
  {
    name: "Nexio Docs — PayU Colombia/LATAM through PaymentsOS",
    url: "https://docs.nexiopay.com/docs/payu-colombialatam-via-paymentsos-integration-guide",
  },
  { name: "Yuno Docs — Wompi", url: "https://docs.y.uno/docs/wompi" },
  { name: "PPRO Developer Hub — Colombia local acquiring", url: "https://developerhub.ppro.com/global-api/docs/colombia-local-acquiring" },
  { name: "Finextra — Nuvei begins direct local acquiring in Colombia", url: "https://www.finextra.com/pressarticle/99723/nuvei-begins-direct-local-acquiring-in-colombia" },
  { name: "Rapyd — Why localising payments matters", url: "https://rapyd.net/?p=38657" },
  { name: "Rapyd — LATAM payments playbook (2026)", url: "https://www.rapyd.net/wp-content/uploads/2026/05/latam-payments-playbook.pdf" },
  {
    name: "Vanguardia — Bre-B after one year (October 2026)",
    url: "https://www.vanguardia.com/economia/2026/10/06/bre-b-mueve-casi-264-billones-en-un-ano-asi-cambio-la-forma-de-transferir-dinero-en-colombia/",
  },
  {
    name: "El Heraldo — Bre-B mass operation from 6 October 2025",
    url: "https://www.elheraldo.co/economia/2025/09/19/las-llaves-de-bre-b-del-banco-de-la-republica-empezaran-su-funcion-oficial-desde-el-6-de-octubre/",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonical}#article`,
      headline: study.title,
      description,
      url: canonical,
      mainEntityOfPage: canonical,
      inLanguage: "en",
      datePublished: study.published,
      dateModified: study.updated ?? study.published,
      author: { "@id": `${site}/#person` },
      publisher: { "@id": `${site}/#person` },
      image: `${site}/images/case-studies/lofoten-coast-og.jpg`,
      isPartOf: { "@id": `${hub}#page` },
      proficiencyLevel: "Expert",
      about: [
        { "@type": "Organization", name: "dLocal", url: "https://www.dlocal.com/" },
        { "@type": "Thing", name: "Multi-currency payments" },
        { "@type": "Thing", name: "Local acquiring" },
      ],
      mentions: [
        { "@type": "Organization", name: "EBANX" },
        { "@type": "Organization", name: "PayU Latam" },
        { "@type": "Organization", name: "Wompi" },
        { "@type": "Organization", name: "PPRO" },
        { "@type": "Thing", name: "Bre-B" },
        { "@type": "Thing", name: "PSE" },
      ],
      spatialCoverage: [
        { "@type": "Country", name: "Colombia" },
        { "@type": "Place", name: "South America" },
      ],
      keywords: (study.tags ?? study.technologies).join(", "),
      citation: sources.map((source) => source.url),
    },
