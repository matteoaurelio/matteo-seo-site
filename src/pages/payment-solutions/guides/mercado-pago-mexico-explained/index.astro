/* ---------- Terms ---------- */

const terms = [
  {
    term: "Payment facilitator (aggregator)",
    meaning: "A company that holds the contracts with banks and card networks, and lets many small merchants accept payments under its own contract.",
    example: "Daniel never signs a contract with a bank. He opens a Mercado Pago account and starts selling the same day.",
  },
  {
    term: "Afiliación",
    meaning: "The direct merchant contract that a Mexican bank gives a store so it can accept cards.",
    example: "A large retailer has an afiliación with its bank and negotiates its own rate. A small shop usually does not qualify, or does not want the paperwork.",
  },
  {
    term: "Checkout",
    meaning: "The page or screen where the shopper chooses how to pay and confirms the payment.",
    example: "With Checkout Pro, Sofía pays on a Mercado Pago page. With Checkout Bricks or the Checkout API, she pays on Daniel's own site.",
  },
  {
    term: "Release time",
    meaning: "How long the merchant waits before the money from a sale becomes available. With Mercado Pago, a shorter wait costs a higher fee.",
    example: "Daniel can receive the money immediately for 3.49% plus tax, or in 30 days for 2.95% plus tax.",
  },
  {
    term: "IVA",
    meaning: "Mexico's value added tax. Mercado Pago adds 16% IVA on top of every fee.",
    example: "A fee of MXN 34.90 becomes MXN 40.48 after IVA.",
  },
  {
    term: "Meses sin intereses (MSI)",
    meaning: "Interest-free months on a bank credit card. The shopper pays the same price in equal monthly parts; the store usually pays an extra fee for the wait.",
    example: "Sofía pays MXN 1,000 in 12 payments of MXN 83.33. Daniel pays an extra 12.89% plus tax on the sale.",
  },
  {
    term: "Meses sin tarjeta (Mercado Crédito)",
    meaning: "Mercado Pago's own credit line inside its app. The shopper can pay in monthly parts without a credit card, and pays interest to Mercado Pago.",
    example: "Sofía has no credit card but has a credit line in her app. Daniel receives the full sale; Sofía pays the interest.",
  },
  {
    term: "Interest rate and CAT",
    meaning: "The interest rate is the price of the borrowed money. The CAT (Costo Anual Total) is Mexico's standard measure of the total yearly cost of a loan, including interest and fees, before tax.",
    example: "Mercado Crédito publishes an average interest rate of 82.7% a year. A 2025 Mercado Pago page gave its average CAT as 121.3%.",
  },
  {
    term: "Chargeback",
    meaning: "When a cardholder tells their bank they did not make or receive a purchase, and the bank takes the money back while it investigates.",
    example: "Sofía's card is stolen and used at Daniel's store. Her bank reverses the payment, and Mercado Pago holds the amount in Daniel's account.",
  },
  {
    term: "Preference",
    meaning: "In Mercado Pago's Checkout Pro, the message a store's server sends to describe an order: items, amount and where to send the shopper afterwards.",
    example: "Daniel's server sends a preference for one lamp at MXN 1,000 and receives a payment page in return.",
  },
  {
    term: "Webhook",
    meaning: "A message that Mercado Pago sends to the store's server when a payment changes status. It is the reliable signal that a payment was approved.",
    example: "Seconds after Sofía pays, Daniel's server receives a notification and checks that the payment is approved.",
  },
  {
    term: "Token",
    meaning: "A one-time code that replaces the card number, so the real number never reaches the store's server.",
    example: "In the Checkout API, Mercado Pago's code in Sofía's browser turns her card number into a token before anything is sent.",
  },
];

