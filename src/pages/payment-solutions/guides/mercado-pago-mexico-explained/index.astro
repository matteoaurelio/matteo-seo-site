      inLanguage: "en",
      datePublished: guide.published,
      dateModified: guide.updated ?? guide.published,
      author: { "@id": `${site}/#person` },
      publisher: { "@id": `${site}/#person` },
      image: `${site}/images/case-studies/lofoten-coast-og.jpg`,
      audience: { "@type": "BusinessAudience", audienceType: guide.audience },
      proficiencyLevel: "Beginner",
      about: [
        { "@type": "Organization", name: "Mercado Pago" },
        { "@type": "Country", name: "Mexico" },
        { "@type": "Thing", name: "Online payment methods" },
        { "@type": "Thing", name: "Payment costs" },
