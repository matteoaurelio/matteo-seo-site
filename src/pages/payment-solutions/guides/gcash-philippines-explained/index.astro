/* ---------- Mistakes ---------- */

const mistakes = [
  {
    title: "Treating the return page as proof of payment",
    text: "The customer can reach your \"thank you\" page without a completed payment, or never reach it after a completed one, for example when the phone switches apps. Only the webhook, or a status check with the gateway, confirms a payment.",
  },
  {
    title: "Ignoring the customer's limits",
    text: "A Basic user cannot pay more than their small monthly limit, and Xendit and PayMongo do not accept GCash payments above ₱100,000. If your average order is high, many \"failed\" payments are limits, not technical errors.",
  },
  {
    title: "A checkout that is longer than the expiry",
    text: "If approving takes longer than the expiry (15 to 30 minutes with common gateways), the request closes. This happens when customers leave to cash in at a store or wait for an OTP.",
  },
  {
    title: "Not testing on real phones",
    text: "GCash approval happens on the phone. Teams that test only on desktop miss problems with deep links, in-app browsers (for example inside a social media app) and customers who return to a different browser tab.",
  },
  {
    title: "Retrying by creating many new requests",
    text: "When a customer clicks \"Pay\" several times, the system can create several payment requests for one order. Without a clear link between order and request, you risk double charges and confusing records.",
  },
  {
    title: "Saving only \"failed\", not the reason",
    text: "A failure code tells you who can fix the problem: the customer, GCash, the gateway or you. Without the code, every failure looks the same and nobody can act.",
  },
  {
    title: "No alternative when GCash fails",
    text: "When GCash is down or in maintenance, a checkout without Maya, QR Ph, cards or bank transfer loses the sale. GCash publishes maintenance windows in advance, usually at night.",
  },
  {
    title: "Pricing in another currency",
    text: "GCash payments are in pesos only. A checkout that sends USD or EUR to a GCash request will be refused before the customer sees anything.",
  },
  {
    title: "Unclear refund promises",
    text: "Support teams often promise an instant refund. In reality, the refund window, the timing and partial refunds depend on the gateway. Customers then contact GCash, and GCash sends them back to the merchant.",
  },
  {
    title: "Forgetting the branding rules",
    text: "Some routes, for example GCash through Alipay+ at Checkout.com, require specific GCash and Alipay+ logos at checkout. A missing logo can delay approval or go-live.",
  },
];

/* ---------- Failure codes ---------- */

const codes = [
  { code: "USER_DID_NOT_AUTHORIZE", source: "Xendit", meaning: "The customer did not approve within the time limit.", owner: "Customer", action: "Let the customer try again with a new request; send a reminder if the order is still valid." },
  { code: "USER_DECLINED_PAYMENT", source: "Xendit", meaning: "The customer cancelled the payment in GCash.", owner: "Customer", action: "Show other payment methods." },
  { code: "INSUFFICIENT_BALANCE", source: "Xendit", meaning: "Not enough money in the wallet.", owner: "Customer", action: "Explain how to cash in, or offer another method." },
  { code: "AMOUNT_EXCEED_LIMIT", source: "PayMongo", meaning: "The amount is above GCash's limit.", owner: "You and customer", action: "Keep GCash for payments below ₱100,000; offer bank transfer or card above it." },
  { code: "ACCOUNT_ACCESS_BLOCKED", source: "Xendit", meaning: "GCash restricted the customer's account.", owner: "Customer and GCash", action: "Ask the customer to contact GCash; offer another method." },
  { code: "CLOSED", source: "PayMongo", meaning: "The checkout expired, or GCash returned a general error.", owner: "Unclear", action: "Create a new checkout; if it repeats, check timing and escalate." },
  { code: "PAYMENT_REQUEST_EXPIRED", source: "Xendit", meaning: "The request expired before the payment.", owner: "You", action: "Shorten the checkout; create a new request for a retry." },
  { code: "CHANNEL_UNAVAILABLE, SYSTEM_ERROR", source: "Xendit, PayMongo", meaning: "GCash or the connection to it has a problem.", owner: "GCash or gateway", action: "Retry later; check the gateway's status page; show alternatives." },
  { code: "INVALID_MERCHANT_SETTINGS, PARAM_MISSING", source: "Xendit, PayMongo", meaning: "The account or the request is configured wrongly.", owner: "You or gateway", action: "Fix the request or ask the gateway to check your settings." },
  { code: "FAILURE_DETAILS_UNAVAILABLE", source: "Xendit", meaning: "GCash said \"failed\" without a reason.", owner: "Unknown", action: "Escalate with the request ID, time and amount." },
];

/* ---------- Diagnosis method ---------- */

const diagnosisSteps = [
  {
    title: "Split the journey into stages",
    text: "Count how many payments reach each stage: request created, customer sent to GCash, customer approved, webhook received, order confirmed. A drop between two stages shows where the problem is. A drop before approval is usually the customer; a drop after approval is usually a system.",
  },
  {
    title: "Save every failure code and group them by owner",
    text: "Use a table like the one above. If most failures belong to the customer (balance, limits, no approval), improve the messages and offer alternatives. If most belong to a system, escalate.",
  },
  {
    title: "Look for a pattern in time",
    text: "Plot failures by hour. A spike at night may match a GCash maintenance window. A short spike during the day may match a gateway incident. For example, Xendit reported intermittent GCash timeouts for 38 minutes on 15 June 2026.",
  },
  {
    title: "Look for a pattern in amount",
    text: "Plot failures by order amount. If failures rise above ₱5,000 or ₱10,000, many of your customers may have Basic accounts and hit their limits. If they rise near ₱100,000, you are at the payment limit.",
  },
  {
    title: "Look for a pattern in device",
    text: "Compare desktop, mobile browser and in-app browsers. If one device type fails much more, the problem is usually the redirect or deep link, not GCash.",
  },
  {
    title: "Close every open payment",
    text: "Some payments stay without a final status, and some channels do not send a failure webhook at all. Run a regular job that asks the gateway for the status of every payment that is still open after the expiry, and updates the order.",
  },
  {
    title: "Give the customer a clear next step",
    text: "Write one message per type of failure: \"Your GCash balance is too low: cash in or choose another method\", \"Your approval time expired: try again\". A specific message turns a failure into a second attempt.",
  },
  {
    title: "Escalate with evidence",
    text: "When you contact the gateway, send the payment request IDs, times, amounts and codes. \"GCash is failing\" cannot be investigated; \"40 requests with FAILURE_DETAILS_UNAVAILABLE between 14:10 and 14:30\" can.",
  },
];

