const slug = "gcash-philippines-explained";
const guide = getPaymentGuide(slug);
if (!guide) throw new Error(`Guide not found: ${slug}`);

const site = "https://matteoarellano.com";
const canonical = `${site}/payment-solutions/guides/${slug}/`;
const title = "How GCash Works: Accepting GCash Payments and Fixing Failures | Guide";
const description = guide.summary;

const publishedLabel = new Date(`${guide.published}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

/* ---------- Key facts ---------- */

const facts = [
  { label: "What it is", value: "A mobile wallet (e-money) app for the Philippines" },
  { label: "Operator", value: "G-Xchange, Inc., a subsidiary of Mynt (Globe Fintech Innovations)" },
  { label: "Regulator", value: "Bangko Sentral ng Pilipinas (BSP), the central bank" },
  { label: "Launched", value: "October 2004, as an SMS money-transfer service" },
  { label: "Monthly active users", value: "40.4 million (March 2026), about 55% of Filipino adults" },
  { label: "Merchants", value: "2.1 million QR Ph merchants (March 2026)" },
  { label: "Currency", value: "Philippine peso (PHP) only" },
];

/* ---------- History ---------- */

const timeline = [
  {
    year: "2004",
    text: "Globe Telecom launches GCash as an SMS service to send money by text message. At the time, about 80% of Filipinos had no bank account. It was Globe's answer to Smart Padala, a rival service from Smart Communications.",
  },
  {
    year: "2009",
    text: "The central bank publishes its first rules for electronic money (BSP Circular 649). Non-bank companies that issue e-money, including Globe's G-Xchange for GCash, must register with the BSP.",
  },
  {
    year: "2012",
    text: "GCash becomes a smartphone app, with money transfers, mobile load and bill payments.",
  },
  {
    year: "2015",
    text: "Mynt is created as the parent company of GCash, a partnership of Globe Telecom, Ayala Corporation and Ant Financial (now Ant Group, the company behind Alipay).",
  },
  {
    year: "2019",
    text: "The BSP creates QR Ph, one national QR code standard, so that any bank or wallet app can pay any participating merchant.",
  },
  {
    year: "2021",
    text: "Through Alipay+, GCash users start to pay at merchants abroad, beginning with Japan. By 2026, GCash is accepted at Alipay+ merchants in more than 45 markets.",
  },
  {
    year: "2026",
    text: "Mynt lists on the Philippine Stock Exchange on 20 October 2026, under the ticker GCASH.",
  },
];

/* ---------- Terms ---------- */

const terms = [
  {
    term: "E-money and e-wallet",
    meaning: "E-money is money stored electronically by a licensed company. An e-wallet is the app where a person keeps it.",
    example: "Ana puts ₱2,000 in cash into her GCash wallet at a partner store. Her app now shows a balance of ₱2,000 in e-money.",
  },
  {
    term: "EMI (electronic money issuer)",
    meaning: "A company licensed by the BSP to issue e-money. GCash's operator, G-Xchange, is an EMI, not a bank.",
    example: "Money in GCash is not a bank deposit, so it is not covered by the deposit insurance (PDIC) that protects bank accounts.",
  },
  {
    term: "Verification level (KYC)",
    meaning: "How well GCash knows the user. Basic users registered with a mobile number only; Fully Verified users also submitted a government ID and a selfie.",
    example: "A Basic user can hold at most ₱10,000. A Fully Verified user can hold up to ₱100,000.",
  },
  {
    term: "Wallet and transaction limits",
    meaning: "Caps on how much a user can hold, receive and spend. They depend on the verification level and reset on the first day of each month.",
    example: "Ben has a Basic account. He tries to pay ₱12,000 for a phone. The payment cannot succeed, because his wallet cannot even hold that amount.",
  },
  {
    term: "OTP",
    meaning: "A one-time password: a short code sent by SMS to the user's registered mobile number to confirm that it is really them.",
    example: "Carla starts a payment on a laptop. GCash sends a 6-digit code to her phone, and she types it in to continue.",
  },
  {
    term: "MPIN",
    meaning: "The user's personal PIN for GCash, like a bank card PIN. It is entered to approve a payment.",
    example: "After the OTP, Carla enters her MPIN. If she enters it wrong too many times, her access can be locked for a while.",
  },
  {
    term: "Cash-in",
    meaning: "Adding money to a GCash wallet: at a partner store, from a bank account, or from another GCash user.",
    example: "Dan's balance is too low for a ₱1,500 order. He cashes in ₱1,000 from his bank, then pays.",
  },
  {
    term: "Payment gateway",
    meaning: "A company that connects your website to many payment methods, including GCash, through one integration. It collects the money and pays it to your bank account.",
    example: "PayMongo, Xendit, Adyen and Checkout.com are gateways that offer GCash.",
  },
  {
    term: "Redirect and deep link",
    meaning: "A redirect sends the customer from your page to a GCash page. A deep link opens the GCash app directly on the phone.",
    example: "On a laptop, Eva sees a GCash web page. On her phone, the GCash app opens instead.",
  },
  {
    term: "Webhook",
    meaning: "A message that the gateway sends to your server when the payment status changes. It is the reliable signal that a payment succeeded or failed.",
    example: "Twenty seconds after Eva approves, your server receives a message: \"payment succeeded, order 4512\".",
  },
  {
    term: "Expiry",
    meaning: "The time the customer has to approve the payment. After it, the payment request is closed and a new one is needed.",
    example: "With one gateway the limit is 15 minutes. Fely leaves to cash in at a store and comes back after 25 minutes: the request has expired.",
  },
  {
    term: "Settlement and MDR",
    meaning: "Settlement is when the gateway pays the money to your bank account. MDR (merchant discount rate) is the fee deducted per payment.",
    example: "A customer pays ₱1,000. With a 2.23% MDR, the fee is ₱22.30 plus VAT, and the rest is settled to you some days later.",
  },
  {
    term: "Void and refund",
    meaning: "A void cancels a payment before it is finalised. A refund sends money back after the payment succeeded.",
    example: "Gio returns a jacket. The shop refunds ₱1,800 to his GCash wallet through the gateway.",
  },
  {
    term: "QR Ph, InstaPay and PESONet",
    meaning: "The Philippines' national payment rails. QR Ph is the shared QR code standard, InstaPay moves money in real time, and PESONet moves larger amounts in batches.",
    example: "A café shows one QR Ph code. Customers pay it with GCash, Maya or a bank app, and the money moves through InstaPay.",
  },
];

