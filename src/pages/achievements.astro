---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  recommendations,
  achievements,
  recommendationAreas,
  toIsoDate,
  assertVerbatimExcerpts,
} from "../data/achievements";
import { referenceLetters } from "../data/referenceLetters";
import { languageLevels } from "../data/languages";
import "../styles/growth-platform.css";
import "../styles/recommendations.css";

// Every excerpt shown on this page must be copied exactly from a recommendation.
assertVerbatimExcerpts();

const site = "https://matteoarellano.com";
const canonical = `${site}/achievements/`;
const personId = `${site}/#person`;

const title = "Recommendations, Experience & Education | Matteo Arellano";
const description =
  "18 recommendations for Matteo Arellano from colleagues and partners in growth marketing, payments, product, data engineering and finance, published in full, plus reference letters, outcomes, experience and education.";

/* ---------- Recommendations ---------- */

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });

const initials = (name: string) => {
  const parts = name.replace(/\./g, "").split(/\s+/).filter(Boolean);
  const first = parts[0]?.[0] ?? "";
  const last = parts.length > 1 ? parts[parts.length - 1][0] : "";
  return (first + last).toUpperCase();
};

const toParagraphs = (text: string) =>
  text
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

/** A block of text: a paragraph, or a short heading line the writer used ("Standout strength"). */
type Block = { heading?: string; text: string };

const toBlocks = (text: string): Block[] =>
  text
    .split(/\n\s*\n|\n/)
    .map((line) => line.trim())
    .filter(Boolean)
    .reduce<Block[]>((blocks, line) => {
      const isHeading = line.length < 40 && !/[.!?:]$/.test(line) && line.split(" ").length <= 4;
      const previous = blocks[blocks.length - 1];
      if (previous && previous.heading !== undefined && previous.text === "") {
        previous.text = line;
      } else if (isHeading) {
        blocks.push({ heading: line, text: "" });
      } else {
        blocks.push({ text: line });
      }
      return blocks;
    }, []);

// Order: the featured recommendation, then dated ones newest first, with the
// Senja reviews (undated, about current work) after the 2026 LinkedIn ones.
const featuredId = recommendations.find((item) => item.featured)?.id;

const items = recommendations
  .map((recommendation, index) => {
    const iso = recommendation.date ? toIsoDate(recommendation.date) : undefined;
    const blocks = toBlocks(recommendation.quote);
    return {
      ...recommendation,
      iso,
      displayDate: iso ? formatDate(iso) : undefined,
      blocks,
      sortKey: iso ?? `2026-01-01-${String(99 - index).padStart(2, "0")}`,
      // Short recommendations are shown in full; longer ones open on demand.
      collapsible: recommendation.quote.length > 420,
    };
  })
  .sort((a, b) => {
    if (a.id === featuredId) return -1;
    if (b.id === featuredId) return 1;
    return b.sortKey.localeCompare(a.sortKey);
  });

const total = items.length;
const featured = items[0];
const linkedInCount = items.filter((item) => item.source === "LinkedIn").length;
const senjaCount = items.filter((item) => item.source === "Senja").length;
const datedYears = items.filter((item) => item.iso).map((item) => item.iso!.slice(0, 4)).sort();
const firstYear = datedYears[0];
const lastYear = datedYears[datedYears.length - 1];
const latestIso = datedYears.length ? items.filter((item) => item.iso).map((item) => item.iso!).sort().pop()! : undefined;

const areaFilters = recommendationAreas.map((area) => ({
  ...area,
  count: items.filter((item) => item.areas.includes(area.id)).length,
}));

/* ---------- Outcomes, experience, education ---------- */

const outcomes = [
  {
    number: "42%",
    label: "Conversion improvement",
    copy: "Behavioural analysis and funnel work used to identify friction and improve a digital customer journey.",
  },
  {
    number: "90%",
    label: "Lower cloud-processing cost",
    copy: "A technical redesign using more efficient data-processing technologies materially reduced recurring processing cost.",
  },
  {
    number: "30+",
    label: "Analytical models",
    copy: "Financial and operational models built to give management clearer information for decisions and controls.",
  },
  {
    number: "Global",
    label: "Cross-functional experience",
    copy: "Work across finance, risk, data engineering, analytics, product growth and commercial problems in international teams.",
  },
];

const timeline = [
  {
    period: "Present",
    role: "Growth, product & analytics",
    organisation: "Distribusion Technologies",
    location: "Remote / international",
    copy: "Working across conversion, payments, customer journeys, analytics, experimentation, partner needs and technical performance in ground transportation.",
    skills: ["Growth", "Product analytics", "Conversion", "Payments", "BigQuery", "Amplitude"],
  },
  {
    period: "2024–2025",
    role: "Financial Analytics Engineer",
    organisation: "PIA Group Netherlands",
    location: "Utrecht, Netherlands",
    copy: "Built management reporting, more than 30 analytical models, dbt/SQL data layers and controls for financial and operational decision-making.",
    skills: ["Financial analytics", "dbt", "SQL", "Data modelling", "Controls"],
  },
  {
    period: "2020–2024",
    role: "Finance, analytics & data engineering",
    organisation: "Cargill",
    location: "Amsterdam, Schiphol & Mexico City",
    copy: "Moved from financial management into business intelligence, Python and data engineering. Built APIs, ETL pipelines, reporting systems and machine-learning workflows for global finance and agricultural businesses.",
    skills: ["Python", "Data engineering", "Finance", "Machine learning", "Power BI", "AWS"],
  },
  {
    period: "2018–2019",
    role: "Risk, restructuring & financial analysis",
    organisation: "European Investment Bank & European Investment Fund",
    location: "Luxembourg",
    copy: "Worked on operational risk, key risk indicators, distressed transactions, debt repayment analysis, insolvency research, company fundamentals and credit analysis.",
    skills: ["Risk", "Credit analysis", "Restructuring", "Financial modelling"],
  },
];

const education = [
  {
    year: "2021",
    title: "Data Scientist Track",
    detail: "Python, statistics, data processing and applied data science",
    institution: "Dataquest",
  },
  {
    year: "2018",
    title: "MSc Business Administration",
    detail: "Accounting & Financial Management · Cum laude",
    institution: "Rotterdam School of Management, Erasmus University",
  },
  {
    year: "2017",
    title: "BSc International Business Administration",
    detail: "International Business Administration",
    institution: "Rotterdam School of Management, Erasmus University",
  },
];

const academicHighlights = achievements.filter((item) =>
  ["Award", "Academic result", "Recommendation letter"].includes(item.category),
);

const languageCount = languageLevels.reduce((sum, level) => sum + level.languages.length, 0);

const sections = [
  { id: "recommendations", label: "Recommendations", count: total },
  { id: "letters", label: "Letters", count: referenceLetters.length },
  { id: "outcomes", label: "Outcomes" },
  { id: "experience", label: "Experience" },
  { id: "languages", label: "Languages", count: languageCount },
  { id: "education", label: "Education" },
];

const contactEmail = "matteo.visibility@gmail.com";
const letterRequestHref = (letter: (typeof referenceLetters)[number]) =>
  `mailto:${contactEmail}?subject=${encodeURIComponent(
    `Reference letter request: ${letter.author}`,
  )}&body=${encodeURIComponent(
    `Hi Matteo,\n\nCould you share the full reference letter from ${letter.author} (${letter.organisation})?\n\nWhat it is for:\n`,
  )}`;

/* ---------- Structured data ---------- */

const rsm = {
  "@type": "CollegeOrUniversity",
  name: "Rotterdam School of Management, Erasmus University",
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${canonical}#profilepage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "en",
      dateModified: latestIso,
      isPartOf: { "@id": `${site}/#website` },
      breadcrumb: { "@id": `${canonical}#breadcrumb` },
      mainEntity: { "@id": personId },
      hasPart: [
        { "@id": `${canonical}#recommendation-list` },
        { "@id": `${canonical}#reference-letters` },
      ],
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        {
          "@type": "ListItem",
          position: 2,
          name: "Recommendations & experience",
          item: canonical,
        },
      ],
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Matteo Arellano",
      url: `${site}/`,
      alumniOf: rsm,
      hasCredential: education
        .filter((item) => item.institution.startsWith("Rotterdam"))
        .map((item) => ({
          "@type": "EducationalOccupationalCredential",
          name: `${item.title} (${item.detail})`,
          credentialCategory: "degree",
          recognizedBy: rsm,
        })),
      award: achievements
        .filter((item) => item.category === "Award")
        .map((item) => `${item.title} (${item.year})`),
      knowsLanguage: languageLevels.flatMap((level) =>
        level.languages.map((language) => ({
          "@type": "Language",
          name: language.name,
          alternateName: language.code,
        })),
      ),
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#reference-letters`,
      name: "Reference letters for Matteo Arellano (published excerpts)",
      numberOfItems: referenceLetters.length,
      itemListElement: referenceLetters.map((letter, index) => {
        const names = letter.author.split(" & ");
        const roles = letter.authorRole.split(" · ");
        return {
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "Review",
            "@id": `${canonical}#letter-${letter.id}`,
            url: `${canonical}#letter-${letter.id}`,
            name: `${letter.kind} from ${letter.author}`,
            itemReviewed: { "@id": personId },
            author: names.map((name, i) => ({
              "@type": "Person",
              name,
              jobTitle: roles[i] ?? roles[0],
            })),
            datePublished: letter.iso,
            description: letter.context,
            reviewBody: [letter.pull, ...letter.passages].join(" "),
          },
        };
      }),
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#recommendation-list`,
      name: `Recommendations for Matteo Arellano (${linkedInCount} on LinkedIn, ${senjaCount} collected through Senja)`,
      numberOfItems: total,
      itemListOrder: "https://schema.org/ItemListOrderDescending",
      itemListElement: items.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "Review",
          "@id": `${canonical}#rec-${item.id}`,
          url: `${canonical}#rec-${item.id}`,
          itemReviewed: { "@id": personId },
          author: {
            "@type": "Person",
            name: item.name,
            jobTitle: item.headline,
            ...(item.profileUrl ? { sameAs: item.profileUrl } : {}),
          },
          ...(item.iso ? { datePublished: item.iso } : {}),
          description: `${item.relationship}. Published on ${item.source}.`,
          reviewBody: item.quote,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/recommendations/colosseum-og.jpg"
>
  <Header />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <main class="rec-page">
    <!-- ============ Hero ============ -->
    <section class="rec-hero" aria-labelledby="rec-title">
      <picture class="rec-hero-bg" aria-hidden="true">
        <source
          media="(max-width: 760px)"
          srcset="/images/recommendations/colosseum-portrait-600.webp 600w, /images/recommendations/colosseum-portrait-900.webp 900w"
          sizes="100vw"
        />
        <img
          src="/images/recommendations/colosseum-1400.webp"
          srcset="/images/recommendations/colosseum-900.webp 900w, /images/recommendations/colosseum-1400.webp 1400w"
          sizes="(max-width: 760px) 100vw, 62vw"
          width="1400"
          height="1287"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="rec-shell rec-hero-inner">
        <p class="rec-hero-kicker">Recommendations</p>
        <h1 id="rec-title">Recommendations from the people I have worked with.</h1>
        <p class="rec-lede">
          {total} recommendations from colleagues and partners in growth,
          payments, product, data and finance. Each one is published in full,
          exactly as it was written.
        </p>

        <figure class="rec-hero-quote">
          <blockquote>
            <p>{featured.highlight}</p>
          </blockquote>
          <figcaption>
            <a href={`#rec-${featured.id}`}>{featured.name}</a>, {featured.headline.split(" | ")[0]}
          </figcaption>
        </figure>

        <p class="rec-hero-facts">
          {linkedInCount} are published on LinkedIn and {senjaCount} were collected
          through Senja, written between {firstYear} and {lastYear}.
        </p>

        <a class="rec-hero-cta" href="#recommendations">Read the recommendations <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <!-- ============ On-this-page index ============ -->
    <nav class="rec-index" aria-label="On this page">
      <div class="rec-shell">
        <ol>
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.id}`} data-index-link={section.id}>
                  {section.label}
                  {section.count && <span class="rec-index-count">{section.count}</span>}
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </nav>

    <!-- ============ Recommendations ============ -->
    <section class="rec-section rec-reading" id="recommendations" aria-labelledby="recommendations-title">
      <div class="rec-shell">
        <header class="rec-reading-head">
          <h2 id="recommendations-title">In their own words.</h2>
          <p>
            Choose the kind of work you care about, or search for a name,
            company or skill. Every recommendation stays on this page.
          </p>
        </header>

        <div class="rec-filter" data-rec-controls hidden>
          <div class="rec-chips" role="group" aria-label="Show recommendations about">
            <button type="button" class="rec-chip" aria-pressed="true" data-filter="all">
              All <span>{total}</span>
            </button>
            {
              areaFilters.map((area) => (
                <button
                  type="button"
                  class="rec-chip"
                  aria-pressed="false"
                  data-filter={area.id}
                  data-label={area.label}
                  data-service-href={area.service.href}
                  data-service-label={area.service.label}
                >
                  {area.label} <span>{area.count}</span>
                </button>
              ))
            }
          </div>
          <label class="rec-search">
            <span class="rec-visually-hidden">Search the recommendations</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M13 13l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
            <input type="search" placeholder="Search by name, company or skill" autocomplete="off" data-rec-search />
          </label>
        </div>

        <p class="rec-status" role="status" aria-live="polite" data-rec-status></p>

        <ol class="rec-list">
          {
            items.map((item) => (
              <li class="rec-item" id={`rec-${item.id}`} data-rec-item data-areas={item.areas.join(" ")}>
                <article aria-labelledby={`rec-${item.id}-name`}>
                  <header class="rec-person">
                    <span class="rec-avatar" aria-hidden="true">
                      {item.photo ? <img src={item.photo} alt="" width="44" height="44" loading="lazy" /> : initials(item.name)}
                    </span>
                    <div class="rec-person-text">
                      <h3 id={`rec-${item.id}-name`}>
                        {item.profileUrl ? (
                          <a href={item.profileUrl} target="_blank" rel="noopener noreferrer">{item.name}</a>
                        ) : (
                          item.name
                        )}
                      </h3>
                      <span>{item.headline}</span>
                    </div>
                  </header>

                  <blockquote class="rec-quote">
                    {item.collapsible ? (
                      <>
                        <p class="rec-quote-highlight">{item.highlight}</p>
                        <details class="rec-more" data-rec-details>
                          <summary>
                            <span class="rec-more-open">Read the full recommendation</span>
                            <span class="rec-more-close">Show less</span>
                          </summary>
                          <div class="rec-more-body">
                            {item.blocks.map((block) => (
                              <p>
                                {block.heading && <strong class="rec-block-heading">{block.heading}</strong>}
                                {block.text}
                              </p>
                            ))}
                          </div>
                        </details>
                      </>
                    ) : (
                      <div class="rec-quote-full">
                        {item.blocks.map((block) => (
                          <p>{block.text}</p>
                        ))}
                      </div>
                    )}
                  </blockquote>

                  <footer class="rec-meta">
                    <span class:list={["rec-source", `rec-source--${item.source.toLowerCase()}`]}>{item.source}</span>
                    <span>
                      {item.relationship}
                      {item.organisation && !item.relationship.includes(item.organisation) && <> · {item.organisation}</>}
                    </span>
                    {item.iso && <time datetime={item.iso}>{item.displayDate}</time>}
                    <a class="rec-permalink" href={`#rec-${item.id}`} aria-label={`Link to ${item.name}'s recommendation`}>Link</a>
                  </footer>
                </article>
              </li>
            ))
          }
        </ol>

        <p class="rec-empty" data-rec-empty hidden>
          Nothing matches yet.
          <button type="button" data-filter="all">Show all {total}</button>
        </p>

        <p class="rec-source-note">
          LinkedIn recommendations are published on
          <a href="https://www.linkedin.com/in/matteoarellano" target="_blank" rel="noopener noreferrer">my LinkedIn profile ↗</a>.
          The other reviews were collected directly through Senja. Spelling and
          wording are left exactly as written.
        </p>
      </div>
    </section>

    <!-- ============ Reference letters ============ -->
    <section class="rec-section rec-section--wash" id="letters" aria-labelledby="letters-title">
      <div class="rec-shell">
        <header class="rec-section-head">
          <div>
            <p class="rec-kicker">Reference letters</p>
            <h2 id="letters-title">Signed letters, summarised.</h2>
          </div>
          <p>
            Formal letters from a team lead, a colleague and an award jury. The
            originals carry signatures and personal contact details, so I do
            not publish them. The passages below are quoted exactly, and the
            full letters are available on request.
          </p>
        </header>

        <ol class="rec-letters">
          {
            referenceLetters.map((letter) => (
              <li class="rec-letter" id={`letter-${letter.id}`}>
                <figure class="rec-letter-sheet">
                  <div class="rec-letter-paper">
                    <p class="rec-letter-letterhead">{letter.organisation}</p>
                    <p class="rec-letter-date">
                      <time datetime={letter.iso}>{letter.date}</time>
                    </p>
                    <p class="rec-letter-salutation">{letter.salutation}</p>
                    <span class="rec-letter-lines" aria-hidden="true">
                      <i /><i />
                    </span>
                    <blockquote class="rec-letter-pull">
                      <p>{letter.pull}</p>
                    </blockquote>
                    <span class="rec-letter-lines" aria-hidden="true">
                      <i /><i /><i />
                    </span>
                    <figcaption class="rec-letter-sign">
                      <strong>{letter.author}</strong>
                      <span>{letter.authorRole}</span>
                    </figcaption>
                    <span class="rec-letter-stamp">Excerpt · original on file</span>
                  </div>
                </figure>

                <div class="rec-letter-info">
                  <p class="rec-letter-kind">
                    {letter.kind} · <time datetime={letter.iso}>{letter.date}</time>
                  </p>
                  <h3>{letter.author}</h3>
                  <p class="rec-letter-role">
                    {letter.authorRole}
                    <br />
                    {letter.organisation}
                  </p>
                  <p class="rec-letter-context">{letter.context}</p>

                  <h4 class="rec-letter-label">What the letter speaks to</h4>
                  <ul class="rec-letter-tags">
                    {letter.confirms.map((item) => <li>{item}</li>)}
                  </ul>

                  <details class="rec-more rec-letter-more">
                    <summary>
                      <span class="rec-more-open">Read {letter.passages.length} more passages</span>
                      <span class="rec-more-close">Hide passages</span>
                    </summary>
                    <div class="rec-more-body">
                      {letter.passages.map((passage) => (
                        <blockquote>
                          <p>{passage}</p>
                        </blockquote>
                      ))}
                    </div>
                  </details>

                  <a class="rec-letter-request" href={letterRequestHref(letter)}>
                    Request the full letter <span aria-hidden="true">→</span>
                  </a>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ============ Outcomes ============ -->
    <section class="rec-section rec-section--dark" id="outcomes" aria-labelledby="outcomes-title">
      <div class="rec-shell">
        <header class="rec-section-head">
          <div>
            <p class="rec-kicker">Selected outcomes</p>
            <h2 id="outcomes-title">Results from different parts of my career.</h2>
          </div>
          <p>
            Deliberately varied: from customer conversion to technical
            efficiency and management information.
          </p>
        </header>

        <ul class="rec-outcomes">
          {
            outcomes.map((item) => (
              <li>
                <strong>{item.number}</strong>
                <h3>{item.label}</h3>
                <p>{item.copy}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============ Experience ============ -->
    <section class="rec-section" id="experience" aria-labelledby="experience-title">
      <div class="rec-shell">
        <header class="rec-section-head">
          <div>
            <p class="rec-kicker">Experience</p>
            <h2 id="experience-title">From finance into data, technology and growth.</h2>
          </div>
          <p>
            Each move added another way of looking at a business problem, so I
            can work comfortably between commercial context, quantitative
            analysis and technical execution.
          </p>
        </header>

        <ol class="rec-timeline">
          {
            timeline.map((item) => (
              <li class="rec-timeline-item">
                <div class="rec-timeline-period">
                  <span>{item.period}</span>
                  <small>{item.location}</small>
                </div>
                <div class="rec-timeline-body">
                  <h3>{item.organisation}</h3>
                  <p class="rec-timeline-role">{item.role}</p>
                  <p>{item.copy}</p>
                  <ul class="rec-skills" aria-label={`Skills used at ${item.organisation}`}>
                    {item.skills.map((skill) => <li>{skill}</li>)}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ============ Languages ============ -->
    <section class="rec-section rec-section--wash" id="languages" aria-labelledby="languages-title">
      <div class="rec-shell">
        <header class="rec-section-head">
          <div>
            <p class="rec-kicker">Languages</p>
            <h2 id="languages-title">{languageCount} languages, from native to elementary.</h2>
          </div>
          <p>
            Native in Spanish and Catalan and advanced professional in English
            and Dutch, with conversational French and Portuguese and elementary
            Norwegian.
          </p>
        </header>

        <ol class="rec-languages">
          {
            languageLevels.map((level) => (
              <li class="rec-language-level">
                <div class="rec-language-head">
                  <span class="rec-meter" aria-hidden="true">
                    {[1, 2, 3, 4].map((step) => (
                      <i class:list={[step <= level.step && "is-on"]} />
                    ))}
                  </span>
                  <h3>{level.label}</h3>
                  {level.note && <p>{level.note}</p>}
                </div>
                <ul class="rec-language-list">
                  {level.languages.map((language) => (
                    <li>
                      <strong>{language.name}</strong>
                      {language.endonym !== language.name && (
                        <span lang={language.code}>{language.endonym}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ============ Education ============ -->
    <section class="rec-section" id="education" aria-labelledby="education-title">
      <div class="rec-shell">
        <header class="rec-section-head">
          <div>
            <p class="rec-kicker">Education</p>
            <h2 id="education-title">A business foundation, then deeper technical training.</h2>
          </div>
        </header>

        <ol class="rec-education">
          {
            education.map((item) => (
              <li>
                <span class="rec-education-year">{item.year}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.detail}</p>
                  <small>{item.institution}</small>
                </div>
              </li>
            ))
          }
        </ol>

        <details class="rec-disclosure">
          <summary>
            <span>Academic results, awards &amp; letters</span>
            <span class="rec-disclosure-count">{academicHighlights.length}</span>
          </summary>
          <ul class="rec-academic">
            {
              academicHighlights.map((item) => (
                <li>
                  <span class="rec-academic-meta">
                    {item.year} · {item.category}
                  </span>
                  <h3>{item.title}</h3>
                  <p>{item.institution}</p>
                  <small>{item.description}</small>
                  {item.title.includes("Rotterdam100") && (
                    <a class="rec-academic-link" href="#letter-rotterdam100">
                      Read the award letter summary ↑
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </details>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="rec-cta" aria-labelledby="cta-title">
      <div class="rec-shell rec-cta-inner">
        <div>
          <p class="rec-kicker">Work together</p>
          <h2 id="cta-title">Have a problem that needs more than one discipline?</h2>
          <p>
            Bring the commercial objective or the problem. We can talk it
            through and see whether my background is useful for what you are
            trying to do.
          </p>
        </div>
        <a class="growth-primary-button" href="/#availability">Let's talk</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-rec-item]"));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".rec-chip"));
  const search = document.querySelector<HTMLInputElement>("[data-rec-search]");
  const statusEl = document.querySelector<HTMLElement>("[data-rec-status]");
  const emptyEl = document.querySelector<HTMLElement>("[data-rec-empty]");

  // Controls appear only with JavaScript; without it every recommendation is listed.
  document.querySelector("[data-rec-controls]")?.removeAttribute("hidden");

  const texts = new Map(items.map((item) => [item, (item.textContent ?? "").toLowerCase()]));
  let area = "all";

  function render() {
    const query = (search?.value ?? "").trim().toLowerCase();
    let visible = 0;

    items.forEach((item) => {
      const inArea = area === "all" || (item.dataset.areas ?? "").split(" ").includes(area);
      const inSearch = !query || (texts.get(item) ?? "").includes(query);
      item.hidden = !(inArea && inSearch);
      if (!item.hidden) visible += 1;

      // Open matches when searching, so the reader sees why they matched.
      const details = item.querySelector<HTMLDetailsElement>("[data-rec-details]");
      if (details && query) details.open = inArea && inSearch;
    });

    chips.forEach((chip) => chip.setAttribute("aria-pressed", String(chip.dataset.filter === area)));
    if (emptyEl) emptyEl.hidden = visible > 0;

    if (!statusEl) return;
    statusEl.replaceChildren();
    if (area === "all" && !query) return;

    const chip = chips.find((item) => item.dataset.filter === area);
    const noun = visible === 1 ? "recommendation" : "recommendations";
    let text = `${visible} ${noun}`;
    if (area !== "all") text += ` about ${chip?.dataset.label?.toLowerCase()}`;
    if (query) text += ` mentioning “${search?.value.trim()}”`;
    statusEl.append(`${text}.`);

    if (area !== "all" && chip?.dataset.serviceHref) {
      const link = document.createElement("a");
      link.href = chip.dataset.serviceHref;
      link.textContent = `${chip.dataset.serviceLabel} service →`;
      statusEl.append(" ", link);
    }
  }

  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-filter]");
    if (!button) return;
    area = button.dataset.filter ?? "all";
    if (button.closest("[data-rec-empty]") && search) search.value = "";
    render();
  });

  search?.addEventListener("input", render);

  // Deep links (#rec-name) show and open the recommendation they point to.
  function openFromHash() {
    const target = location.hash.startsWith("#rec-") ? document.getElementById(location.hash.slice(1)) : null;
    if (!target) return;
    if (target.hidden) {
      area = "all";
      if (search) search.value = "";
      render();
    }
    const detail = target.querySelector<HTMLDetailsElement>("[data-rec-details]");
    if (detail) detail.open = true;
    target.scrollIntoView({ block: "start" });
  }
  window.addEventListener("hashchange", openFromHash);
  openFromHash();

  // Highlight the current section in the on-page index.
  const indexLinks = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-index-link]")).map((link) => [
      link.dataset.indexLink,
      link,
    ]),
  );

  if ("IntersectionObserver" in window) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          indexLinks.forEach((link) => link.removeAttribute("aria-current"));
          indexLinks.get(entry.target.id)?.setAttribute("aria-current", "true");
        });
      },
      { rootMargin: "-35% 0px -60% 0px" },
    );
    indexLinks.forEach((_, id) => {
      const section = id ? document.getElementById(id) : null;
      if (section) sectionObserver.observe(section);
    });
  }

</script>
