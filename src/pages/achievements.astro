---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  recommendations,
  type Recommendation,
} from "../data/achievements";

const title =
  "Career Timeline, Recommendations & Education | Matteo Arellano";

const description =
  "Explore Matteo Arellano's career timeline, professional recommendations, university diplomas, academic achievements, Dataquest studies, and technical certifications across finance, analytics, data engineering, SEO, AI visibility, and conversion.";

const canonical = "https://matteoarellano.com/achievements/";

const featuredRecommendation =
  (recommendations.find(
    (recommendation) => recommendation.featured,
  ) as Recommendation) ?? recommendations[0];

const remainingRecommendations = recommendations.filter(
  (recommendation) => recommendation !== featuredRecommendation,
);

const timeline = [
  {
    period: "2025-present",
    title: "Lead SEO & Growth Manager",
    organisation: "Systems Search Studio",
    location: "Mexico, working globally",
    icon: "search",
    description:
      "I moved fully into technical SEO, growth analytics, AI visibility, conversion, and website performance. My work includes payment acceptance analysis, event tracking, BigQuery and Amplitude analysis, Google Analytics 4, Google Ads, technical SEO, automation, and custom tools.",
    skills: [
      "Technical SEO",
      "AI visibility",
      "CRO",
      "GA4",
      "BigQuery",
      "Amplitude",
      "Payment analytics",
    ],
  },
  {
    period: "2024-2025",
    title: "Financial Analytics Engineer",
    organisation: "PIA Group Nederland",
    location: "Utrecht, Netherlands",
    icon: "dashboard",
    description:
      "I built financial and operational reporting for directors, created more than 30 analytical models, developed bronze, silver, and gold data layers with dbt and SQL, and designed internal controls to identify anomalies and balancing issues.",
    skills: [
      "Financial reporting",
      "dbt",
      "SQL",
      "Internal controls",
      "Data modelling",
    ],
  },
  {
    period: "2023-2024",
    title: "Global Financial Analytics Engineer",
    organisation: "Cargill",
    location: "Mexico City, Mexico",
    icon: "globe",
    description:
      "I supported global finance reporting across food, agriculture, energy trading, and specialised portfolios. I developed financial APIs and data pipelines, worked on machine-learning anomaly detection, and reduced cloud processing costs by around 90% through faster data technologies.",
    skills: [
      "Python",
      "Polars",
      "AWS",
      "Hadoop",
      "Machine learning",
      "Financial APIs",
    ],
  },
  {
    period: "2022",
    title: "Financial Analytics Engineer",
    organisation: "Cargill",
    location: "Amsterdam, Netherlands",
    icon: "database",
    description:
      "I worked on trading-position risk management, forecasting, Power BI models, Impala data structures, and scheduled Hadoop workflows for accounting and financial reconciliation.",
    skills: [
      "Power BI",
      "Forecasting",
      "Impala",
      "Hadoop",
      "Risk analytics",
    ],
  },
  {
    period: "2020-2022",
    title: "Finance, management information and data analytics",
    organisation: "Cargill",
    location: "Schiphol and Amsterdam, Netherlands",
    icon: "chart",
    description:
      "I started in financial management and moved into business intelligence and data engineering. I built ETL pipelines, reporting models, and data flows for cocoa, chocolate, bioindustrials, and agricultural supply-chain teams.",
    skills: [
      "Finance",
      "ETL",
      "Power Query",
      "DAX",
      "Business intelligence",
      "Supply chain",
    ],
  },
  {
    period: "2018-2019",
    title: "Risk, restructuring and financial analysis",
    organisation: "European Investment Fund and European Investment Bank",
    location: "Luxembourg",
    icon: "bank",
    description:
      "After graduating, I worked in European banking on operational risk, key risk indicators, distressed transactions, debt repayment analysis, insolvency research, company fundamentals, and credit analysis.",
    skills: [
      "Operational risk",
      "Credit analysis",
      "Restructuring",
      "Financial modelling",
    ],
  },
  {
    period: "2018",
    title: "Graduated cum laude",
    organisation: "Rotterdam School of Management, Erasmus University",
    location: "Rotterdam, Netherlands",
    icon: "graduation",
    description:
      "I completed my Master of Science in Business Administration, specialising in Accounting and Financial Management. This was the point where my career moved from academic finance into applied risk, analytics, data engineering, and later website growth.",
    skills: [
      "Accounting",
      "Financial management",
      "Business administration",
      "Research",
    ],
  },
];

const universityDiplomas = [
  {
    year: "2018",
    degree:
      "Master of Science in Business Administration",
    field: "Accounting and Financial Management",
    institution: "Rotterdam School of Management, Erasmus University",
    result: "Cum laude",
    description:
      "Graduate degree focused on accounting, financial management, business analysis, and evidence-based decision-making.",
  },
  {
    year: "2017",
    degree: "Bachelor of Science in International Business Administration",
    field: "International Business Administration",
    institution: "Rotterdam School of Management, Erasmus University",
    result: "Completed",
    description:
      "Undergraduate degree covering finance, strategy, operations, international management, and organisational decision-making.",
  },
];

const otherStudies = [
  {
    year: "2021",
    type: "Data science programme",
    title: "Data Scientist Track",
    institution: "Dataquest",
    description:
      "A structured programme in Python, data processing, statistics, data analysis, and applied data science completed from March to December 2021.",
    topics: ["Python", "Data processing", "Statistics", "Data analysis"],
  },
  {
    year: "2016",
    type: "Intensive university course",
    title: "China's Economic Growth, Foreign Trade and Investment",
    institution: "LSE-PKU Summer School at Peking University",
    description:
      "Completed the EC205 intensive course in Beijing and received a grade of A.",
    topics: [
      "International economics",
      "Economic growth",
      "Trade",
      "Investment",
    ],
  },
  {
    year: "2016-2017",
    type: "University course",
    title: "Financial Analysis",
    institution:
      "Graduate School of Management, St. Petersburg State University",
    description:
      "Completed a 45-hour financial analysis course. The accompanying academic recommendation highlighted analytical ability, attention to detail, teamwork, facilitation, and curiosity about the financial sector.",
    topics: ["Financial analysis", "Teamwork", "Analytical thinking"],
  },
  {
    year: "2015",
    type: "Intensive university course",
    title: "Human Resource Management and Employment Relations",
    institution: "The London School of Economics and Political Science",
    description:
      "Completed the MG190 LSE Summer School course and received a grade of A.",
    topics: [
      "Human resources",
      "Employment relations",
      "Management",
      "Organisations",
    ],
  },
];

const certifications = [
  "Linear Regression for Machine Learning",
  "Intro to Python for Finance",
  "Data Modelling for Power BI",
  "Docker Training for the Absolute Beginner",
  "Recursion and Trees",
];

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${canonical}#profile-page`,
  url: canonical,
  name: title,
  description,
  dateModified: "2026-07-19",
  mainEntity: {
    "@type": "Person",
    "@id": "https://matteoarellano.com/#person",
    name: "Matteo Arellano",
    url: "https://matteoarellano.com/",
    sameAs: ["https://www.linkedin.com/in/matteoarellano"],
    jobTitle: "Lead SEO & Growth Manager",
    description:
      "Matteo Arellano works across technical SEO, AI visibility, growth analytics, conversion, GA4, BigQuery, Python, data engineering, and financial analytics.",
    knowsLanguage: [
      "English",
      "Spanish",
      "Catalan",
      "Dutch",
      "Norwegian",
    ],
    knowsAbout: [
      "Technical SEO",
      "AI visibility",
      "Conversion rate optimization",
      "Growth analytics",
      "Google Analytics 4",
      "BigQuery",
      "Amplitude",
      "Python",
      "SQL",
      "Data engineering",
      "Financial analytics",
      "Machine learning",
      "Payment analytics",
    ],
    alumniOf: [
      {
        "@type": "CollegeOrUniversity",
        name: "Rotterdam School of Management, Erasmus University",
      },
      {
        "@type": "CollegeOrUniversity",
        name: "The London School of Economics and Political Science",
      },
      {
        "@type": "CollegeOrUniversity",
        name: "Peking University",
      },
      {
        "@type": "CollegeOrUniversity",
        name:
          "Graduate School of Management, St. Petersburg State University",
      },
    ],
    award: ["Winner of the Rotterdam100 2016-2017"],
    hasCredential: [
      ...universityDiplomas.map((diploma) => ({
        "@type": "EducationalOccupationalCredential",
        name: `${diploma.degree}, ${diploma.field}`,
        credentialCategory: "University degree",
        recognizedBy: {
          "@type": "CollegeOrUniversity",
          name: diploma.institution,
        },
      })),
      ...otherStudies.map((study) => ({
        "@type": "EducationalOccupationalCredential",
        name: study.title,
        credentialCategory: study.type,
        recognizedBy: {
          "@type": "Organization",
          name: study.institution,
        },
      })),
    ],
    hasOccupation: timeline
      .filter((item) => item.period !== "2018")
      .map((item) => ({
        "@type": "Occupation",
        name: item.title,
        description: item.description,
        occupationLocation: {
          "@type": "Place",
          name: item.location,
        },
      })),
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://matteoarellano.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Achievements, career, recommendations and education",
      item: canonical,
    },
  ],
};

const timelineSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Matteo Arellano career timeline",
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  numberOfItems: timeline.length,
  itemListElement: timeline.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: `${item.period}: ${item.title} at ${item.organisation}`,
    description: item.description,
  })),
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify([
      profileSchema,
      breadcrumbSchema,
      timelineSchema,
    ])}
  ></script>

  <main class="achievement-page">
    <section class="achievement-hero">
      <div class="achievement-container achievement-hero-grid">
        <div class="achievement-hero-copy">
          <span class="achievement-kicker">
            Career · Recommendations · Education
          </span>

          <h1>
            Matteo Arellano's career, recommendations and education.
          </h1>

          <p class="achievement-lede">
            I graduated from Rotterdam School of Management in 2018 and moved
            from European banking and financial risk into global analytics,
            data engineering, technical SEO, AI visibility, and conversion
            work. This page brings that journey together in one place.
          </p>

          <nav class="achievement-jump-links" aria-label="Page sections">
            <a href="#career-timeline">Career timeline</a>
            <a href="#recommendations">Recommendations</a>
            <a href="#university-diplomas">University diplomas</a>
            <a href="#other-studies">Other studies</a>
          </nav>
        </div>

        <aside class="identity-card" aria-label="Matteo Arellano profile summary">
          <span class="identity-label">Profile summary</span>

          <dl>
            <div>
              <dt>Current focus</dt>
              <dd>Technical SEO, AI visibility, growth and analytics</dd>
            </div>

            <div>
              <dt>Career foundation</dt>
              <dd>Finance, risk, data engineering and machine learning</dd>
            </div>

            <div>
              <dt>Education</dt>
              <dd>
                MSc Business Administration, Accounting and Financial
                Management
              </dd>
            </div>

            <div>
              <dt>Languages</dt>
              <dd>English, Spanish, Catalan, Dutch and Norwegian</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <aside class="credential-banner">
      <div class="achievement-container credential-banner-inner">
        <div class="credential-banner-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path
              d="M8 3.75h8A2.25 2.25 0 0 1 18.25 6v12A2.25 2.25 0 0 1 16 20.25H8A2.25 2.25 0 0 1 5.75 18V6A2.25 2.25 0 0 1 8 3.75Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            />
            <path
              d="M9 8h6M9 11.5h6M9 15h3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
        </div>

        <p>
          <strong>Want to work together?</strong>
          I am happy to share the diplomas, certificates, and credentials
          mentioned on this page directly with you.
        </p>

        <a href="mailto:matteo.visibility@gmail.com?subject=Credentials%20and%20project%20enquiry">
          Contact me
        </a>
      </div>
    </aside>

    <section
      class="achievement-section"
      id="career-timeline"
      aria-labelledby="career-timeline-title"
    >
      <div class="achievement-container">
        <header class="achievement-section-header">
          <div>
            <span class="achievement-eyebrow">01 · Career timeline</span>
            <h2 id="career-timeline-title">
              From financial risk to data-driven website growth
            </h2>
          </div>

          <p>
            The timeline shows how each stage added a new layer: finance, risk,
            business intelligence, data engineering, machine learning, growth,
            technical SEO, and conversion.
          </p>
        </header>

        <ol class="career-timeline">
          {
            timeline.map((item) => (
              <li class="career-item">
                <div class="career-marker" aria-hidden="true">
                  {item.icon === "graduation" && (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path
                        d="m3 9 9-4 9 4-9 4-9-4Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M7 11.2V15c0 1.4 2.2 3 5 3s5-1.6 5-3v-3.8M21 9v5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />
                    </svg>
                  )}

                  {item.icon === "bank" && (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path
                        d="m3 9 9-5 9 5M5 10.5h14M6.5 10.5v6M10.2 10.5v6M13.8 10.5v6M17.5 10.5v6M4 19h16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}

                  {item.icon === "chart" && (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path
                        d="M5 19V9M12 19V5M19 19v-7M3 19.5h18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />
                    </svg>
                  )}

                  {item.icon === "database" && (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <ellipse
                        cx="12"
                        cy="6"
                        rx="7"
                        ry="3"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <path
                        d="M5 6v6c0 1.66 3.13 3 7 3s7-1.34 7-3V6M5 12v6c0 1.66 3.13 3 7 3s7-1.34 7-3v-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                    </svg>
                  )}

                  {item.icon === "globe" && (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <circle
                        cx="12"
                        cy="12"
                        r="8.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <path
                        d="M3.8 12h16.4M12 3.5c2.2 2.2 3.3 5 3.3 8.5S14.2 18.3 12 20.5M12 3.5C9.8 5.7 8.7 8.5 8.7 12s1.1 6.3 3.3 8.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />
                    </svg>
                  )}

                  {item.icon === "dashboard" && (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <rect
                        x="4"
                        y="4"
                        width="16"
                        height="16"
                        rx="3"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <path
                        d="M8 16v-4M12 16V8M16 16v-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />
                    </svg>
                  )}

                  {item.icon === "search" && (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <circle
                        cx="10.5"
                        cy="10.5"
                        r="5.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <path
                        d="m15 15 5 5M7.8 10.5l1.7 1.8 3.6-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                </div>

                <article class="career-card">
                  <div class="career-card-top">
                    <span class="career-period">{item.period}</span>
                    <span class="career-location">{item.location}</span>
                  </div>

                  <h3>{item.title}</h3>
                  <p class="career-organisation">{item.organisation}</p>
                  <p class="career-description">{item.description}</p>

                  <ul class="career-skills" aria-label={`${item.title} topics`}>
                    {item.skills.map((skill) => <li>{skill}</li>)}
                  </ul>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      class="achievement-section achievement-section-soft"
      id="recommendations"
      aria-labelledby="recommendations-title"
    >
      <div class="achievement-container">
        <header class="achievement-section-header">
          <div>
            <span class="achievement-eyebrow">02 · Recommendations</span>
            <h2 id="recommendations-title">
              What colleagues say about working with me
            </h2>
          </div>

          <p>
            These recommendations come from people who worked with me across
            growth, finance, analytics, data engineering, Python, machine
            learning, and complex business projects.
          </p>
        </header>

        <article class="featured-recommendation">
          <div class="featured-recommendation-meta">
            <span class="linkedin-badge">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="16"
                height="16"
              >
                <path
                  fill="currentColor"
                  d="M5.37 3.5A2.37 2.37 0 1 1 5.36 8.24 2.37 2.37 0 0 1 5.37 3.5ZM3.32 9.86h4.1V21h-4.1V9.86Zm6.66 0h3.93v1.52h.06c.55-1.04 1.89-2.13 3.89-2.13 4.16 0 4.93 2.74 4.93 6.3V21h-4.1v-4.84c0-1.15-.02-2.64-1.61-2.64-1.61 0-1.86 1.26-1.86 2.56V21h-4.1V9.86Z"
                ></path>
              </svg>

              {featuredRecommendation.source}
            </span>

            <time>{featuredRecommendation.date}</time>
          </div>

          <blockquote>
            {
              featuredRecommendation.quote
                .split("\n\n")
                .map((paragraph) => <p>{paragraph}</p>)
            }
          </blockquote>

          <footer>
            <div>
              <strong>{featuredRecommendation.name}</strong>
              <span>{featuredRecommendation.headline}</span>
            </div>

            <small>{featuredRecommendation.relationship}</small>
          </footer>
        </article>

        <div class="recommendation-grid">
          {
            remainingRecommendations.map((recommendation) => (
              <article class="recommendation-card">
                <header>
                  <span class="linkedin-badge linkedin-badge-light">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      width="15"
                      height="15"
                    >
                      <path
                        fill="currentColor"
                        d="M5.37 3.5A2.37 2.37 0 1 1 5.36 8.24 2.37 2.37 0 0 1 5.37 3.5ZM3.32 9.86h4.1V21h-4.1V9.86Zm6.66 0h3.93v1.52h.06c.55-1.04 1.89-2.13 3.89-2.13 4.16 0 4.93 2.74 4.93 6.3V21h-4.1v-4.84c0-1.15-.02-2.64-1.61-2.64-1.61 0-1.86 1.26-1.86 2.56V21h-4.1V9.86Z"
                      ></path>
                    </svg>

                    {recommendation.source}
                  </span>

                  <time>{recommendation.date}</time>
                </header>

                <blockquote>
                  {
                    recommendation.quote
                      .split("\n\n")
                      .map((paragraph) => <p>{paragraph}</p>)
                  }
                </blockquote>

                <footer>
                  <strong>{recommendation.name}</strong>
                  <span>{recommendation.headline}</span>
                  <small>{recommendation.relationship}</small>
                </footer>
              </article>
            ))
          }
        </div>

        <div class="source-note">
          <p>
            The recommendation text is reproduced from the original LinkedIn
            recommendations.
          </p>

          <a
            href="https://www.linkedin.com/in/matteoarellano"
            target="_blank"
            rel="noopener noreferrer"
          >
            View my LinkedIn profile
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section
      class="achievement-section"
      id="university-diplomas"
      aria-labelledby="university-diplomas-title"
    >
      <div class="achievement-container">
        <header class="achievement-section-header">
          <div>
            <span class="achievement-eyebrow">03 · University diplomas</span>
            <h2 id="university-diplomas-title">
              Formal education in business, accounting and finance
            </h2>
          </div>

          <p>
            My university education gave me the financial and business
            foundation that later shaped my work in analytics, engineering,
            technical SEO, and growth.
          </p>
        </header>

        <div class="diploma-grid">
          {
            universityDiplomas.map((diploma) => (
              <article class="diploma-card">
                <div class="diploma-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path
                      d="m3 9 9-4 9 4-9 4-9-4Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M7 11.2V15c0 1.4 2.2 3 5 3s5-1.6 5-3v-3.8M21 9v5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                </div>

                <div class="diploma-copy">
                  <div class="diploma-topline">
                    <span>{diploma.year}</span>
                    <strong>{diploma.result}</strong>
                  </div>

                  <h3>{diploma.degree}</h3>
                  <p class="diploma-field">{diploma.field}</p>
                  <p class="diploma-institution">{diploma.institution}</p>
                  <p>{diploma.description}</p>
                </div>
              </article>
            ))
          }
        </div>

        <aside class="award-callout">
          <div class="award-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path
                d="M8 4h8v5a4 4 0 0 1-8 0V4Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              />
              <path
