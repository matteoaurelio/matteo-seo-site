---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { recommendations, achievements } from "../data/achievements";
import "../styles/growth-platform.css";
import "../styles/profile-growth.css";

const title = "Recommendations, Experience & Education | Matteo Arellano";
const description =
  "Professional recommendations, selected commercial and technical outcomes, career experience and education from Matteo Arellano, Technical Growth Partner.";
const canonical = "https://matteoarellano.com/achievements/";

const featuredRecommendation =
  recommendations.find((recommendation) => recommendation.featured) ?? recommendations[0];
const remainingRecommendations = recommendations.filter(
  (recommendation) => recommendation !== featuredRecommendation,
);

const outcomes = [
  {
    number: "42%",
    label: "conversion improvement",
    copy: "Behavioural analysis and funnel work used to identify friction and improve a digital customer journey.",
  },
  {
    number: "90%",
    label: "lower cloud-processing cost",
    copy: "A technical redesign using more efficient data-processing technologies materially reduced recurring processing cost.",
  },
  {
    number: "30+",
    label: "analytical models",
    copy: "Financial and operational models built to give management clearer information for decisions and controls.",
  },
  {
    number: "Global",
    label: "cross-functional experience",
    copy: "Work across finance, risk, data engineering, analytics, product growth and commercial problems in international teams.",
  },
];

const timeline = [
  {
    period: "Present",
    role: "Growth, product & analytics",
    organisation: "Distribusion Technologies",
    location: "Remote / international",
    copy: "Working across conversion, payments, customer journeys, analytics, experimentation, partner needs and technical performance in ground transportation.",
    skills: ["Growth", "Product analytics", "Conversion", "Payments", "BigQuery", "Amplitude"],
  },
  {
    period: "2024–2025",
    role: "Financial Analytics Engineer",
    organisation: "PIA Group Netherlands",
    location: "Utrecht, Netherlands",
    copy: "Built management reporting, more than 30 analytical models, dbt/SQL data layers and controls for financial and operational decision-making.",
    skills: ["Financial analytics", "dbt", "SQL", "Data modelling", "Controls"],
  },
  {
    period: "2020–2024",
    role: "Finance, analytics & data engineering",
    organisation: "Cargill",
    location: "Amsterdam, Schiphol & Mexico City",
    copy: "Moved from financial management into business intelligence, Python and data engineering. Built APIs, ETL pipelines, reporting systems and machine-learning workflows for global finance and agricultural businesses.",
    skills: ["Python", "Data engineering", "Finance", "Machine learning", "Power BI", "AWS"],
  },
  {
    period: "2018–2019",
    role: "Risk, restructuring & financial analysis",
    organisation: "European Investment Bank & European Investment Fund",
    location: "Luxembourg",
    copy: "Worked on operational risk, key risk indicators, distressed transactions, debt repayment analysis, insolvency research, company fundamentals and credit analysis.",
    skills: ["Risk", "Credit analysis", "Restructuring", "Financial modelling"],
  },
];

const education = [
  {
    year: "2018",
    title: "MSc Business Administration",
    detail: "Accounting & Financial Management · Cum laude",
    institution: "Rotterdam School of Management, Erasmus University",
  },
  {
    year: "2017",
    title: "BSc International Business Administration",
    detail: "International Business Administration",
    institution: "Rotterdam School of Management, Erasmus University",
  },
  {
    year: "2021",
    title: "Data Scientist Track",
    detail: "Python, statistics, data processing and applied data science",
    institution: "Dataquest",
  },
];

const academicHighlights = achievements.filter((item) =>
  ["Award", "Academic result", "Recommendation letter"].includes(item.category),
);

const senjaIds = [
  "ec497f76-377a-46dc-9240-db1d69100c24",
  "86fcd7c9-6eb3-4c3d-b0c2-eb39f1808c23",
  "23825e64-b11f-4de5-854f-47c6093628b5",
  "810b2a8c-4b82-4ec6-9070-8e89eb250eb8",
  "3c50d95c-ed58-44ea-81e0-efc4f589558b",
];

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonical,
  name: title,
  description,
  mainEntity: {
    "@type": "Person",
    "@id": "https://matteoarellano.com/#person",
    name: "Matteo Arellano",
    url: "https://matteoarellano.com/",
    sameAs: ["https://www.linkedin.com/in/matteoarellano"],
    jobTitle: "Technical Growth Partner",
    knowsAbout: [
      "Business development",
      "Partnerships",
      "Commercial analysis",
      "Product analytics",
      "Conversion optimization",
      "Technical SEO",
      "Google Ads",
      "Data engineering",
      "Python",
      "SQL",
      "BigQuery",
      "Automation",
    ],
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/matteo-arellano-visibility-signup.jpg"
>
  <Header />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(profileSchema)}
  />

  <main class="evidence-page">
    <section class="evidence-hero">
      <div class="growth-shell evidence-hero-grid">
        <div>
          <span class="growth-overline">Recommendations & experience</span>
          <h1>Evidence from the people, teams and problems I have worked with.</h1>
          <p>
            My background is broad by design: commercial growth, finance,
            analytics, data engineering and product work. This page brings
            together the recommendations, outcomes and experience behind that
            range.
          </p>
        </div>
        <aside class="evidence-hero-note">
          <span>What people consistently mention</span>
          <strong>Problem solving · analytical depth · communication · initiative</strong>
          <p>
            The pattern matters more than any individual job title: I am most
            useful when the problem is important, ambiguous and crosses functions.
          </p>
        </aside>
      </div>
    </section>

    <section class="evidence-outcomes-section">
      <div class="growth-shell">
        <header class="evidence-section-heading">
          <span class="growth-overline">Selected outcomes</span>
          <h2>Results from different parts of my career.</h2>
          <p>
            These are deliberately varied. They show the range from customer
            conversion to technical efficiency and management information.
          </p>
        </header>
        <div class="evidence-outcome-grid">
          {outcomes.map((item) => (
            <article class="evidence-outcome-card">
              <strong>{item.number}</strong>
              <span>{item.label}</span>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="evidence-recommendations-section" id="recommendations">
      <div class="growth-shell">
        <header class="evidence-section-heading evidence-section-heading--light">
          <span class="growth-overline">Professional recommendations</span>
          <h2>What people I have worked with say.</h2>
          <p>
            These are recommendations from colleagues who saw my work directly
            across growth, finance, analytics, data engineering and complex
            cross-functional projects.
          </p>
        </header>

        <article class="evidence-featured-quote">
          <span class="evidence-quote-mark" aria-hidden="true">“</span>
          <blockquote>
            {featuredRecommendation.quote.split("\n\n").map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </blockquote>
          <footer>
            <strong>{featuredRecommendation.name}</strong>
            <span>{featuredRecommendation.headline}</span>
            <small>{featuredRecommendation.relationship}</small>
          </footer>
        </article>

        <div class="evidence-recommendation-grid">
          {remainingRecommendations.map((recommendation) => (
            <article class="evidence-recommendation-card">
              <blockquote>
                {recommendation.quote.split("\n\n").map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </blockquote>
              <footer>
                <strong>{recommendation.name}</strong>
                <span>{recommendation.headline}</span>
                <small>{recommendation.date}</small>
              </footer>
            </article>
          ))}
        </div>

        <div class="evidence-linkedin-link">
          <a href="https://www.linkedin.com/in/matteoarellano" target="_blank" rel="noopener noreferrer">
            View the original recommendations on LinkedIn ↗
          </a>
        </div>
      </div>
    </section>

    <section class="evidence-direct-reviews">
      <div class="growth-shell">
        <header class="evidence-section-heading">
          <span class="growth-overline">Reviews & appraisals</span>
          <h2>Additional feedback collected directly.</h2>
          <p>
            These reviews were collected through Senja from people who have
            worked with me on technical, analytical and growth-related work.
          </p>
        </header>

        <div class="evidence-senja-grid">
          {senjaIds.map((id) => (
            <div class="evidence-senja-card">
              <div
                class="senja-embed"
                data-id={id}
                data-mode="shadow"
                data-lazyload="true"
                style="display:block;width:100%;"
              ></div>
            </div>
          ))}
        </div>

        {senjaIds.map((id) => (
          <script
            is:inline
            src={`https://widget.senja.io/widget/${id}/platform.js`}
            type="text/javascript"
            async
          ></script>
        ))}
      </div>
    </section>

    <section class="evidence-career-section" id="experience">
      <div class="growth-shell evidence-career-layout">
        <div class="evidence-career-intro">
          <span class="growth-overline">Experience</span>
          <h2>A career that moved from finance into data, technology and growth.</h2>
          <p>
            Each move added another way of looking at a business problem. The
            result is that I can move comfortably between commercial context,
            quantitative analysis and technical execution.
          </p>
        </div>

        <div class="evidence-timeline">
          {timeline.map((item) => (
            <article class="evidence-timeline-item">
              <div class="evidence-timeline-meta">
                <span>{item.period}</span>
                <strong>{item.organisation}</strong>
                <small>{item.location}</small>
              </div>
              <div>
                <h3>{item.role}</h3>
                <p>{item.copy}</p>
                <div class="evidence-skill-list">
                  {item.skills.map((skill) => <span>{skill}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="evidence-education-section" id="education">
      <div class="growth-shell">
        <header class="evidence-section-heading">
          <span class="growth-overline">Education</span>
          <h2>Business foundation, then deeper technical training.</h2>
        </header>

        <div class="evidence-education-grid">
          {education.map((item) => (
            <article class="evidence-education-card">
              <span>{item.year}</span>
              <h3>{item.title}</h3>
              <strong>{item.detail}</strong>
              <p>{item.institution}</p>
            </article>
          ))}
        </div>

        <div class="evidence-academic-list">
          {academicHighlights.map((item) => (
            <article>
              <span>{item.year} · {item.category}</span>
              <h3>{item.title}</h3>
              <p>{item.institution}</p>
              <small>{item.description}</small>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="evidence-cta-section">
      <div class="growth-shell evidence-cta-card">
        <div>
          <span class="growth-overline">Work together</span>
          <h2>Have a growth problem that needs more than one discipline?</h2>
          <p>
            Bring the commercial objective or the problem. We can talk through
            it and see whether my background is useful for what you are trying to do.
          </p>
        </div>
        <a class="growth-primary-button" href="/#availability">Let's talk</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
