---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Privacy Policy | Matteo Arellano";

const description =
  "Privacy Policy for matteoarellano.com, explaining what information is collected, how it is used, and how visitors can contact Matteo Arellano about their data.";

const canonical = "https://matteoarellano.com/privacy-policy/";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />

  <main class="recipe-page">
    <article class="recipe-shell">
      <header class="recipe-hero">
        <span class="recipe-kicker">Privacy Policy</span>

        <h1>Privacy Policy</h1>

        <p>
          This page explains what information I collect through this website,
          why I collect it, how long I keep it, and how you can contact me about
          your personal information.
        </p>

        <div class="recipe-tags">
          <span>Last updated: June 17, 2026</span>
          <span>Website: matteoarellano.com</span>
        </div>
      </header>

      <section class="recipe-card">
        <h2>Who operates this website</h2>

        <p>
          This website, <code>https://matteoarellano.com</code>, is operated by
          Matteo Arellano from Mexico City, Mexico.
        </p>

        <p>
          You can contact me about this Privacy Policy or about your personal
          information at:
        </p>

        <p>
          <a
            class="card-link inline-card-link"
            href="mailto:matteo.visibility@gmail.com"
          >
            matteo.visibility@gmail.com
          </a>
        </p>
      </section>

      <section class="recipe-card">
        <h2>What information I collect</h2>

        <p>
          I collect only the information that is necessary to respond to
          inquiries, manage bookings, provide services, improve the website, and
          communicate with people who choose to contact me.
        </p>

        <p>
          Depending on how you use the website, I may collect your name, email
          address, company name, website, role, project details, or any message
          you choose to send through email, forms, booking tools, or future
          newsletter signups.
        </p>

        <p>
          I may also collect basic technical information related to website
          performance, security, and search visibility. At the moment, I do not
          process payments through this website.
        </p>
      </section>

      <section class="recipe-card">
        <h2>How I collect information</h2>

        <p>
          I may collect information when you send me an email, book a call
          through Cal.com, request a free SEO check, fill out a form, sign up
          for future updates, or interact with pages, resources, or tools on the
          website.
        </p>

        <p>
          Some technical information may also be processed automatically through
          the systems used to host, deliver, and protect the website.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Why I use your information</h2>

        <p>
          I use personal information to respond to your messages, schedule and
          manage calls, understand your website or business problem, provide
          requested services, improve the website, protect the website from
          abuse or technical issues, and send future email updates only if you
          choose to sign up for them.
        </p>

        <p>
          My services may include technical SEO consulting, AI visibility
          audits, analytics and data consulting, browser diagnostics tools, free
          SEO checks, newsletter content, and digital resources.
        </p>

        <p>
          I do not use your personal information for purposes unrelated to the
          reason you provided it.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Tools and third-party services</h2>

        <p>
          I use a small number of third-party services to operate the website,
          manage communication, and protect the site.
        </p>

        <p>
          These may include Cloudflare Pages for hosting, Cloudflare for website
          delivery and security, Cal.com for bookings, Google Search Console for
          search visibility information, and email services to receive and reply
          to messages.
        </p>

        <p>
          If I add new tools in the future, such as an email newsletter
          provider, I will update this Privacy Policy when needed.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Google Forms and future email collection</h2>

        <p>
          I may use Google Forms or another form provider to collect email
          addresses for a newsletter, resource download, waiting list, free SEO
          check, or similar purpose.
        </p>

        <p>
          If I use a form, the form may collect the information you choose to
          submit, such as your name, email address, website, or message. This
          information will be used only for the purpose explained near the form.
        </p>

        <p>
          If you sign up for a future email list, you will be able to request
          removal by contacting me at
          <a
            class="card-link inline-card-link"
            href="mailto:matteo.visibility@gmail.com"
          >
            matteo.visibility@gmail.com
          </a>.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Cookies and analytics</h2>

        <p>
          At the moment, I use Google Search Console to understand search
          visibility. Google Search Console provides aggregated search
          performance information and does not give me a personal profile of
          individual visitors.
        </p>

        <p>
          The website may also use technical cookies or similar technologies
          that are necessary for website security, performance, or operation.
        </p>

        <p>
          I do not currently use advertising pixels, retargeting pixels, or paid
          advertising tracking on this website. If I add analytics cookies,
          advertising tools, or newsletter tracking in the future, I will update
          this Privacy Policy.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Chrome extensions and browser tools</h2>

        <p>
          I also build browser diagnostics tools and Chrome extensions. The
          privacy practices for those tools are disclosed separately in the
          Chrome Web Store listing or in the extension-specific privacy
          information.
        </p>

        <p>
          This Privacy Policy mainly applies to the website at
          <code>https://matteoarellano.com</code>.
        </p>
      </section>

      <section class="recipe-card">
        <h2>How long I keep personal information</h2>

        <p>
          I keep personal information for up to one year, unless a longer period
          is needed to respond to an active inquiry, provide a requested
          service, comply with legal obligations, resolve a dispute, or maintain
          basic business records.
        </p>

        <p>
          If you want me to delete your information earlier, you can contact me
          at
          <a
            class="card-link inline-card-link"
            href="mailto:matteo.visibility@gmail.com"
          >
            matteo.visibility@gmail.com
          </a>.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Who I share information with</h2>

        <p>I do not sell your personal information.</p>

        <p>
          I may share limited information with service providers only when
          needed to operate the website, manage bookings, communicate with you,
          protect the website, or provide requested services.
        </p>

        <p>
          For example, information may be processed by Cloudflare, Cal.com,
          Google, or email service providers, depending on how you interact with
          the website.
        </p>

        <p>
          I may also disclose information if required by law, legal process, or
          a valid request from a competent authority.
        </p>
      </section>

      <section class="recipe-card">
        <h2>International visitors</h2>

        <p>
          This website is operated from Mexico City, Mexico, and is intended for
          visitors and potential clients worldwide.
        </p>

        <p>
          If you access the website from outside Mexico, your information may be
          processed in Mexico or by service providers located in other
          countries.
        </p>

        <p>
          By using the website or submitting information, you understand that
          your information may be processed outside your country of residence.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Your rights</h2>

        <p>
          You may contact me to request access to, correction of, deletion of,
          or objection to the use of your personal information.
        </p>

        <p>
          These are commonly known in Mexico as ARCO rights: access,
          rectification, cancellation, and opposition.
        </p>

        <p>
          You may also ask to withdraw consent for future communications. To
          make a request, contact:
        </p>

        <p>
          <a
            class="card-link inline-card-link"
            href="mailto:matteo.visibility@gmail.com"
          >
            matteo.visibility@gmail.com
          </a>
        </p>

        <p>
          I may need to verify your identity before responding to a privacy
          request.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Email communications</h2>

        <p>
          If you choose to join a future email list or newsletter, I may send
          you updates about technical SEO, AI visibility, analytics, browser
          diagnostics, digital resources, or related content.
        </p>

        <p>
          You can unsubscribe or ask to be removed at any time by using the
          unsubscribe option if available, or by emailing
          <a
            class="card-link inline-card-link"
            href="mailto:matteo.visibility@gmail.com"
          >
            matteo.visibility@gmail.com
          </a>.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Security</h2>

        <p>
          I take reasonable steps to protect personal information from
          unauthorized access, loss, misuse, or disclosure.
        </p>

        <p>
          However, no website, email system, or internet-based service can be
          guaranteed to be completely secure. You should avoid sending sensitive
          personal information through ordinary website forms or email unless it
          is necessary.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Links to other websites</h2>

        <p>
          This website may link to external websites, including LinkedIn,
          Medium, GitHub, Chrome Web Store, Cal.com, Google, or other
          third-party resources.
        </p>

        <p>
          I am not responsible for the privacy practices of external websites.
          You should review their privacy policies before submitting information
          to them.
        </p>
      </section>

      <section class="recipe-card">
        <h2>Changes to this Privacy Policy</h2>

        <p>
          I may update this Privacy Policy from time to time. When I make
          changes, I will update the “Last updated” date at the top of this
          page.
        </p>

        <p>
          Continued use of the website after changes are published means the
          updated version applies.
        </p>
      </section>

      <section class="recipe-related">
        <div>
          <span class="recipe-kicker">Contact</span>
          <h2>Questions about privacy?</h2>

          <p>
            For privacy questions, requests, or concerns, contact Matteo
            Arellano in Mexico City, Mexico.
          </p>
        </div>

        <a class="recipe-button" href="mailto:matteo.visibility@gmail.com">
          Email Matteo
        </a>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>
