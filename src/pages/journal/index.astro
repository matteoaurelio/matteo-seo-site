---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

const entries = (await getCollection("journal", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = "Work Journal | Matteo Arellano";
const description =
  "Notes about technical SEO, analytics, organic growth, experimentation and the lessons behind my work.";
const canonical = "https://matteoarellano.com/journal/";

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<BlogLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <main class="journal-page">
    <header class="journal-intro">
      <p class="journal-label">Work Journal</p>

      <h1>Notes from the work</h1>

      <p class="journal-description">
        A public record of what I am building, what I am learning and how my
        thinking changes through real work. Client names and confidential
        details are always removed.
      </p>
    </header>

    <section class="journal-list" aria-label="Journal entries">
      {
        entries.length === 0 ? (
          <p>No journal entries have been published yet.</p>
        ) : (
          entries.map((entry) => (
            <article class="journal-card">
              <p class="journal-date">
                {formatDate(entry.data.pubDate)}
              </p>

              <h2>
                <a href={`/journal/${entry.id}/`}>
                  {entry.data.title}
                </a>
              </h2>

              <p class="journal-summary">
                {entry.data.description}
              </p>

              {
                entry.data.tags.length > 0 && (
                  <div class="journal-tags" aria-label="Topics">
                    {entry.data.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                )
              }

              <a
                class="journal-read"
                href={`/journal/${entry.id}/`}
              >
                Read entry →
              </a>
            </article>
          ))
        )
      }
    </section>
  </main>
</BlogLayout>

<style>
  .journal-page {
    width: min(900px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 5rem 0;
  }

  .journal-intro {
    max-width: 720px;
    margin-bottom: 3.5rem;
  }

  .journal-label {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .journal-intro h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .journal-description {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .journal-list {
    display: grid;
    gap: 1.25rem;
  }

  .journal-card {
    padding: 1.75rem;
    border: 1px solid rgba(15, 76, 129, 0.2);
    border-radius: 18px;
  }

  .journal-date {
    margin: 0;
    font-size: 0.88rem;
    opacity: 0.7;
  }

  .journal-card h2 {
    margin: 0.4rem 0 0.8rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.2;
  }

  .journal-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .journal-card h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .journal-summary {
    margin: 0;
    line-height: 1.7;
  }

  .journal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }

  .journal-tags span {
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(15, 76, 129, 0.08);
    font-size: 0.8rem;
  }

  .journal-read {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .journal-read:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 640px) {
    .journal-page {
      padding: 3rem 0;
    }

    .journal-card {
      padding: 1.25rem;
    }
  }
</style>
