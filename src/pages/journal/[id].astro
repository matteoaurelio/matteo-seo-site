---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import CaseStudyHero from "../../components/CaseStudyHero.astro";
import "../../styles/case-studies.css";

export async function getStaticPaths() {
  const entries = await getCollection("journal", ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: {
      id: entry.id,
    },
    props: {
      entry,
    },
  }));
}

interface Props {
  entry: CollectionEntry<"journal">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Entries tagged "cybersecurity" get the cybersecurity hub's look:
// the Greek theatre header and a link back to the hub.
const isCybersecurity = entry.data.tags.some(
  (tag) => tag.toLowerCase() === "cybersecurity",
);

const title = `${entry.data.title} | Work Journal | Matteo Arellano`;
const canonical = `https://matteoarellano.com/journal/${entry.id}/`;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

const site = "https://matteoarellano.com";
const video = entry.data.video;
const shareImage =
  entry.data.image ?? (isCybersecurity ? "/images/cybersecurity/greek-theatre-og.jpg" : undefined);

const articleSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  mainEntityOfPage: canonical,
  url: canonical,
  author: {
    "@type": "Person",
    "@id": `${site}/#person`,
    name: "Matteo Arellano",
    url: `${site}/`,
  },
  ...(shareImage ? { image: new URL(shareImage, site).toString() } : {}),
};

if (video) {
  articleSchema.video = {
    "@type": "VideoObject",
    name: video.title,
    description: entry.data.description,
    thumbnailUrl: shareImage
      ? [new URL(shareImage, site).toString(), `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`]
      : `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`,
    uploadDate: video.uploadDate.toISOString(),
    duration: video.duration,
    contentUrl: `https://www.youtube.com/watch?v=${video.youtubeId}`,
    embedUrl: `https://www.youtube-nocookie.com/embed/${video.youtubeId}`,
    author: { "@id": `${site}/#person` },
  };
}
---

<BlogLayout
  title={title}
  description={entry.data.description}
  canonical={canonical}
  image={shareImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  {
    isCybersecurity && (
      <div class="cs-page journal-cyber-hero">
        <CaseStudyHero
          crumbLabel="Cybersecurity"
          crumbHref="/cybersecurity/"
          title={entry.data.title}
          titleId="journal-title"
          variant="article"
          image="/images/cybersecurity/greek-theatre"
          imageHeight={1080}
        >
          {formatDate(entry.data.pubDate)} · Matteo Arellano
        </CaseStudyHero>
      </div>
    )
  }

  <main class:list={["journal-entry-page", isCybersecurity && "journal-entry-page--cyber"]}>
    <article class="journal-article">
      {
        isCybersecurity ? (
          <a class="back-link" href="/cybersecurity/articles/">← All cybersecurity articles</a>
        ) : (
          <a class="back-link" href="/journal/">← Back to the work journal</a>
        )
      }

      <header class="journal-header">
        <p class="journal-label">
          {isCybersecurity ? "Cybersecurity · Work Journal" : "Work Journal"}
        </p>

        {!isCybersecurity && <h1>{entry.data.title}</h1>}

        <p class="journal-description">
          {entry.data.description}
        </p>

        {
          !isCybersecurity && (
            <div class="journal-meta">
              <span>{formatDate(entry.data.pubDate)}</span>
              <span>Matteo Arellano</span>
            </div>
          )
        }

        {
          entry.data.tags.length > 0 && (
            <div class="journal-tags" aria-label="Topics">
              {entry.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      {
        video && (
          <figure class="journal-video">
            <div class="journal-video-frame">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}?rel=0`}
                title={video.title}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
            <figcaption>
              <span>Watch: {video.title}</span>
              {video.playlistUrl && (
                <a href={video.playlistUrl} target="_blank" rel="noopener noreferrer">
                  {video.playlistLabel ?? "See the full playlist"} ↗
                </a>
              )}
            </figcaption>
          </figure>
        )
      }

      <div class="journal-content">
        <Content />
      </div>
    </article>
  </main>
</BlogLayout>

<style>
  .journal-cyber-hero {
    background: transparent;
  }

  /* Cybersecurity entries sit on white, so the faded header blends into
     the page as it does on the hub pages. */
  .journal-entry-page.journal-entry-page--cyber {
    width: 100%;
    padding: 2.5rem max(1rem, calc((100% - 860px) / 2)) 6rem;
    background: #ffffff;
  }

  .journal-content :global(pre) {
    margin: 0 0 1.75rem;
    padding: 1.1rem 1.25rem;
    border-radius: 12px;
    overflow-x: auto;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .journal-content :global(:not(pre) > code) {
    padding: 0.1rem 0.35rem;
    border-radius: 6px;
    background: rgba(15, 76, 129, 0.08);
    font-size: 0.92em;
  }

  .journal-entry-page {
    width: min(860px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .journal-article {
    max-width: 760px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .journal-header {
    margin-bottom: 3rem;
  }

  .journal-label {
    margin: 0 0 0.8rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .journal-header h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .journal-description {
    max-width: 700px;
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .journal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .journal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .journal-tags span {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgba(15, 76, 129, 0.08);
    font-size: 0.82rem;
  }

  .journal-video {
    margin: 0 0 3rem;
  }

  .journal-video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: #071729;
    box-shadow: 0 18px 42px rgba(16, 43, 77, 0.14);
  }

  .journal-video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .journal-video figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 0.85rem;
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .journal-video figcaption a {
    font-weight: 700;
  }

  .journal-content {
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .journal-content :global(p) {
    margin: 0 0 1.5rem;
  }

  .journal-content :global(h2) {
    margin: 3rem 0 1rem;
    font-size: 1.8rem;
    line-height: 1.25;
  }

  .journal-content :global(h3) {
    margin: 2.5rem 0 1rem;
    font-size: 1.4rem;
    line-height: 1.35;
  }

  /* Keep headings clear of the sticky site header when a reader
     follows an in-page link (for example a contents list). */
  .journal-content :global([id]) {
    scroll-margin-top: 104px;
  }

  /* Colour, underline and hover come from the shared inline-link
     style in global.css. */
  .journal-content :global(a) {
    overflow-wrap: anywhere;
  }

  .journal-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid currentColor;
    background: rgba(15, 76, 129, 0.06);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .journal-content :global(blockquote p) {
    margin: 0;
  }

  .journal-content :global(ul),
  .journal-content :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .journal-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .journal-content :global(img) {
    display: block;
    width: min(100%, 600px);
    max-height: 720px;
    height: auto;
    margin: 2.5rem auto;
    border-radius: 0.5rem;
    object-fit: contain;
  }

  .journal-content :global(details) {
    margin: 0 0 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(15, 76, 129, 0.2);
    border-radius: 12px;
    background: rgba(15, 76, 129, 0.03);
  }

  .journal-content :global(details summary) {
    cursor: pointer;
    line-height: 1.5;
  }

  .journal-content :global(details[open] summary) {
    margin-bottom: 0.75rem;
  }

  .journal-content :global(details p) {
    margin: 0;
  }

  .journal-content :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid rgba(15, 76, 129, 0.2);
  }

  .journal-content :global(table) {
    width: 100%;
    margin: 2rem 0 2.5rem;
    border: 1px solid rgba(15, 76, 129, 0.2);
    border-collapse: collapse;
    border-spacing: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .journal-content :global(th),
  .journal-content :global(td) {
    padding: 0.9rem 1rem;
    border-right: 1px solid rgba(15, 76, 129, 0.18);
    border-bottom: 1px solid rgba(15, 76, 129, 0.18);
    text-align: left;
    vertical-align: top;
    overflow-wrap: normal;
    word-break: normal;
  }

  .journal-content :global(th:last-child),
  .journal-content :global(td:last-child) {
    border-right: 0;
  }

  .journal-content :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .journal-content :global(th) {
    background: rgba(15, 76, 129, 0.09);
    font-weight: 700;
    line-height: 1.35;
  }

  .journal-content :global(tbody tr:nth-child(even)) {
    background: rgba(15, 76, 129, 0.025);
  }

  .journal-content :global(td p),
  .journal-content :global(th p) {
    margin: 0;
  }

  .journal-content :global(td a) {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .journal-entry-page {
      width: min(100% - 1.25rem, 860px);
      padding: 2.5rem 0 4rem;
    }

    .back-link {
      margin-bottom: 2rem;
    }

    .journal-header {
      margin-bottom: 2.5rem;
    }

    .journal-header h1 {
      font-size: clamp(2.25rem, 12vw, 3.4rem);
    }

    .journal-description {
      font-size: 1.05rem;
      line-height: 1.65;
    }

    .journal-content {
      font-size: 1rem;
    }

    .journal-content :global(table) {
      display: block;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      font-size: 0.88rem;
      white-space: normal;
      -webkit-overflow-scrolling: touch;
    }

    .journal-content :global(thead),
    .journal-content :global(tbody) {
      white-space: normal;
    }

    .journal-content :global(th),
    .journal-content :global(td) {
      min-width: 135px;
      padding: 0.75rem;
    }

    .journal-content :global(th:first-child),
    .journal-content :global(td:first-child) {
      min-width: 210px;
    }
  }

  @media (max-width: 640px) {
    .journal-entry-page.journal-entry-page--cyber {
      width: 100%;
      padding: 2rem 0.625rem 4rem;
    }
  }
</style>
