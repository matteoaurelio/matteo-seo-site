---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { cookbookChapters, getRecipesByChapter } from "../../data/cookbook";

const title =
  "Technical Growth Cookbook | SEO, Analytics & Data Recipes | Matteo Arellano";

const description =
  "A practical cookbook of reusable code recipes for SEO, analytics, campaign tracking, browser diagnostics, Core Web Vitals, and large-scale data analysis.";

const canonical = "https://matteoarellano.com/resources/";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />

  <main class="cookbook-page">
    <section class="cookbook-hero">
      <span class="cookbook-kicker">Technical Growth Cookbook</span>

      <h1>Reusable code recipes for SEO, analytics, tracking, and data analysis.</h1>

      <p>
        A practical cookbook of technical recipes explained through real business problems:
        campaign tracking, technical SEO audits, JavaScript diagnostics, Core Web Vitals,
        Search Console analysis, internal linking, Polars workflows, and reporting.
      </p>

      <div class="cookbook-hero-actions">
        <a class="cookbook-button" href="#chapters">
          Explore chapters
        </a>

        <a class="cookbook-secondary-button" href="/blog/">
          Read the blog
        </a>
      </div>
    </section>

    <section class="cookbook-intro-card">
      <div>
        <h2>How the cookbook works</h2>
        <p>
          Each recipe starts from a practical business problem, then shows the code,
          explains the logic, lists mistakes to avoid, and connects the solution to
          measurement, visibility, or business decisions.
        </p>
      </div>

      <div class="cookbook-principles">
        <span>Business problem</span>
        <span>Code recipe</span>
        <span>Plain-English explanation</span>
        <span>Measurement logic</span>
      </div>
    </section>

    <section class="cookbook-section" id="chapters">
      <div class="cookbook-section-header">
        <span class="cookbook-kicker">10 chapters</span>
        <h2>Choose a topic.</h2>
        <p>
          Each chapter contains focused recipes. The structure will grow over time as
          new LinkedIn posts, website recipes, and GitHub cookbook entries are published.
        </p>
      </div>

      <div class="cookbook-chapter-grid">
        {cookbookChapters.map((chapter) => {
          const recipes = getRecipesByChapter(chapter.slug);

          return (
            <a
              class="cookbook-chapter-card"
              href={`/resources/${chapter.slug}/`}
            >
              <span class="chapter-number">{chapter.number}</span>
              <h3>{chapter.title}</h3>
              <p>{chapter.description}</p>

              <div class="chapter-tags">
                {chapter.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>

              <strong>
                {recipes.length === 1
                  ? "1 recipe available"
                  : `${recipes.length} recipes available`}
              </strong>
            </a>
          );
        })}
      </div>
    </section>

    <section class="cookbook-cta">
      <span class="cookbook-kicker">Built in public</span>

      <h2>This cookbook will grow recipe by recipe.</h2>

      <p>
        Each recipe can become a website page, a LinkedIn post, and a GitHub cookbook
        entry. Over time, this becomes a public library of practical technical growth patterns.
      </p>

      <a
        class="cookbook-button"
        href="https://www.linkedin.com/in/matteoarellano/"
        target="_blank"
        rel="noreferrer"
      >
        Follow the series on LinkedIn
      </a>
    </section>
  </main>

  <Footer />
</BaseLayout>
