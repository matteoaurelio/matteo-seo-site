---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import CaseStudyHero from "../../../components/CaseStudyHero.astro";
import {
  glossaryGroups,
  allGlossaryTerms,
  natExample,
} from "../../../data/cybersecurityGlossary";
import "../../../styles/case-studies.css";

const title =
  "Cybersecurity Glossary for Marketers: DNS, NAT, IP Addresses, CSP & More | Matteo Arellano";
const description =
  "Plain-English definitions of network and web security terms, from DNS, NAT and IP addresses to Content Security Policy, each with a worked example.";
const canonical = "https://matteoarellano.com/cybersecurity/glossary/";

const glossarySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Cybersecurity",
          item: "https://matteoarellano.com/cybersecurity/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Glossary",
          item: canonical,
        },
      ],
    },
    {
      "@type": "DefinedTermSet",
      "@id": `${canonical}#glossary`,
      name: "Cybersecurity glossary for websites, analytics and marketing",
      url: canonical,
      description,
      author: { "@id": "https://matteoarellano.com/#person" },
      hasDefinedTerm: allGlossaryTerms.map((item) => ({
        "@type": "DefinedTerm",
        "@id": `${canonical}#${item.slug}`,
        name: item.term,
        description: item.definition,
        url: `${canonical}#${item.slug}`,
        inDefinedTermSet: `${canonical}#glossary`,
      })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/images/cybersecurity/greek-theatre-og.jpg"
>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(glossarySchema)} />

  <main class="cs-page">
    <CaseStudyHero
      crumbLabel="Cybersecurity"
      crumbHref="/cybersecurity/"
      title="Glossary"
      titleId="gl-title"
      image="/images/cybersecurity/greek-theatre"
      imageHeight={1080}
    >
      {allGlossaryTerms.length} terms · each with a worked example
    </CaseStudyHero>

  <div class="gl-page">
    <section class="gl-intro">
      <p>
        Security terms for people who run websites, ads and online stores.
        Every definition comes with a worked example, so the terms build on
        each other. Network terms use one home network behind a router.
        Content Security Policy and DNS terms use an online shop.
      </p>
      <a class="gl-link" href="/cybersecurity/articles/">Read the articles →</a>
    </section>

    <nav class="gl-index" aria-label="Glossary sections">
      {
        glossaryGroups.map((group) => (
          <div class="gl-index-group">
            <a class="gl-index-title" href={`#${group.slug}`}>{group.title}</a>
            <div class="gl-index-terms">
              {group.terms.map((item) => (
                <a href={`#${item.slug}`}>{item.term}</a>
              ))}
            </div>
          </div>
        ))
      }
    </nav>

    <figure class="gl-example" aria-label="The example network used for network terms">
      <div>
        <span class="gl-example-label">Inside the home (LAN, private)</span>
        <ul>
          {
            natExample.devices.map((device) => (
              <li>
                <strong>{device.name}</strong>
                <code>{device.ip}</code>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="gl-example-router">
        <strong>Router with NAT</strong>
        <span>LAN <code>{natExample.routerLan}</code></span>
        <span>WAN <code>{natExample.routerWan}</code></span>
      </div>
      <div class="gl-example-wan">
        <span class="gl-example-label">What the internet sees (public)</span>
        <code class="gl-example-public">{natExample.routerWan}</code>
        <small>One address for all three devices</small>
      </div>
    </figure>

    {
      glossaryGroups.map((group) => (
        <section class="gl-group" id={group.slug}>
          <h2>{group.title}</h2>
          <p class="gl-group-intro">{group.intro}</p>
          <dl class="gl-terms">
            {group.terms.map((item) => (
              <div class="gl-term" id={item.slug}>
                <dt>
                  <a href={`#${item.slug}`}>{item.term}</a>
                </dt>
                <dd>
                  <p>{item.definition}</p>
                  <p class="gl-term-example">
                    <span>In the example</span>
                    {item.inTheExample}
                  </p>
                  {item.forMarketers && (
                    <p class="gl-term-marketing">
                      <span>Why marketers should care</span>
                      {item.forMarketers}
                    </p>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }

    <section class="gl-cta on-dark">
      <h2>See these terms at work</h2>
      <p>
        The articles use this glossary to explain real problems, such as IP
        filters that stop matching and conversion tags blocked by a security
        policy.
      </p>
      <a class="gl-button" href="/cybersecurity/articles/">Read the articles</a>
    </section>
  </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .gl-page {
    width: min(1040px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(48px, 7vw, 88px) 0 6rem;
  }

  .gl-intro {
    max-width: 62ch;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .gl-intro p {
    margin: 0 0 1.1rem;
    color: var(--cs-copy);
    font-size: clamp(1.06rem, 1.5vw, 1.2rem);
    line-height: 1.8;
  }

  .gl-link {
    font-weight: 700;
    color: var(--primary);
  }

  .gl-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gl-index {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem 2rem;
    margin-bottom: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--soft-2);
    border-radius: var(--radius-lg);
    background: var(--surface-solid);
  }

  .gl-index-title {
    display: block;
    margin-bottom: 0.45rem;
    font-weight: 700;
    color: var(--primary);
  }

  .gl-index-terms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.8rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .gl-index-terms a:hover,
  .gl-index-title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gl-example {
    display: grid;
    grid-template-columns: 1.2fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin: 0 0 3rem;
    padding: 1.5rem;
    border: 1px solid var(--soft-2);
    border-radius: var(--radius-lg);
    background: var(--bg-strong);
  }

  .gl-example-label {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .gl-example ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gl-example li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-md);
    background: var(--surface-solid);
  }

  .gl-example code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.92rem;
  }

  .gl-example-router {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    border-radius: var(--radius-md);
    background: var(--primary);
    color: #fff;
    text-align: center;
  }

  .gl-example-router span {
    font-size: 0.88rem;
  }

  .gl-example-wan {
    text-align: center;
  }

  .gl-example-public {
    display: block;
    padding: 0.8rem;
    border-radius: var(--radius-md);
    background: var(--surface-solid);
    font-size: 1.15rem !important;
    font-weight: 700;
    color: var(--primary);
  }

  .gl-example-wan small {
    display: block;
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .gl-group {
    margin-bottom: 3rem;
    scroll-margin-top: 6rem;
  }

  .gl-group h2 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    letter-spacing: -0.02em;
  }

  .gl-group-intro {
    margin: 0 0 1.25rem;
    color: var(--muted);
  }

  .gl-terms {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .gl-term {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1.25rem;
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--soft);
    border-radius: var(--radius-md);
    background: var(--surface-solid);
    scroll-margin-top: 6rem;
  }

  .gl-term:target {
    border-color: var(--primary-3);
    box-shadow: 0 0 0 3px rgba(90, 169, 255, 0.25);
  }

  .gl-term dt {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .gl-term dt a:hover {
    color: var(--primary);
  }

  .gl-term dd {
    margin: 0;
  }

  .gl-term dd p {
    margin: 0 0 0.75rem;
    line-height: 1.65;
  }

  .gl-term dd p:last-child {
    margin-bottom: 0;
  }

  .gl-term-example,
  .gl-term-marketing {
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    font-size: 0.96rem;
  }

  .gl-term-example {
    background: var(--bg-strong);
  }

  .gl-term-marketing {
    background: rgba(14, 116, 144, 0.08);
  }

  .gl-term-example span,
  .gl-term-marketing span {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .gl-term-marketing span {
    color: var(--accent);
  }

  .gl-cta {
    padding: 2.25rem;
    border-radius: var(--radius-xl);
    background: var(--primary);
    color: #fff;
  }

  .gl-cta h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
  }

  .gl-cta p {
    max-width: 640px;
    margin: 0 0 1.4rem;
    line-height: 1.7;
    opacity: 0.9;
  }

  .gl-button {
    display: inline-block;
    padding: 0.85rem 1.35rem;
    border-radius: 999px;
    background: #fff;
    color: var(--primary);
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .gl-index {
      grid-template-columns: 1fr;
    }

    .gl-example {
      grid-template-columns: 1fr;
    }

    .gl-term {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
