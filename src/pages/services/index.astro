---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import DiscoveryCalendar from "../../components/DiscoveryCalendar.astro";
import { growthServices } from "../../data/growthServices";
import "../../styles/growth-platform.css";

const title = "How I Help Companies Grow | Matteo Arellano";
const description =
  "Explore five areas where I partner with companies: expansion and partnerships, commercial analysis, product and conversion, acquisition and visibility, and data and automation.";
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://matteoarellano.com/services/"
  image="/images/matteo-arellano-visibility-signup.jpg"
>
  <Header />

  <main class="growth-services-overview">
    <section class="growth-overview-hero">
      <div class="growth-shell growth-overview-hero-grid">
        <div>
          <span class="growth-overline">How I help</span>
          <h1>Five ways I help companies create commercial value.</h1>
        </div>
        <div>
          <p>
            New revenue, better decisions, higher conversion, more qualified
            demand or lower operating cost. Choose the outcome closest to what
            you need and see exactly how I can help.
          </p>
          <a class="growth-primary-button" href="#availability">Discuss a growth opportunity</a>
        </div>
      </div>
    </section>

    <section class="growth-services-section growth-services-section--overview">
      <div class="growth-shell">
        <div class="growth-service-grid">
          {growthServices.map((service, index) => (
            <article class:list={["growth-service-card", index === 0 && "growth-service-card--featured"]}>
              <div class="growth-service-card-top">
                <span>{service.number}</span>
                <span>{service.name}</span>
              </div>
              <h2>{service.shortTitle}</h2>
              <p class="growth-service-promise">{service.homepagePromise}</p>
              <p class="growth-service-description">{service.homepageDescription}</p>
              <a href={`/services/${service.slug}/`}>Open service page <span>→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="growth-services-note">
      <div class="growth-shell growth-services-note-grid">
        <div>
          <span class="growth-overline">One commercial goal, several levers</span>
          <h2>I use the capabilities that move the outcome.</h2>
        </div>
        <p>
          A new-market opportunity may require prospect interviews and data
          analysis. A conversion problem may be caused by payment acceptance.
          A visibility problem may require a better landing page. I keep the
          commercial target fixed and bring in the capabilities needed to move it.
        </p>
      </div>
    </section>

    <section class="growth-calendar-band">
      <div class="growth-shell">
        <DiscoveryCalendar
          namespace="services-discovery"
          title="Have a growth target but not a fixed solution yet?"
          copy="Tell me the commercial outcome you want to improve. We can use 20 minutes to understand what is blocking it, what evidence already exists and where I could contribute."
        />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
