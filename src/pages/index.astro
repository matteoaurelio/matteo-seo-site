---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/services.css";

const title = "Growth Partner for B2B & Service Businesses | Matteo Arellano";

const description =
  "Growth partner for B2B and service businesses. Better insights, stronger conversion, market expansion and automation — combining commercial thinking with technical execution.";

const alternateLanguages = [
  {
    hreflang: "en",
    href: "https://matteoarellano.com/",
  },
  {
    hreflang: "es",
    href: "https://matteoarellano.com/es/",
  },
  {
    hreflang: "nl",
    href: "https://matteoarellano.com/nl/",
  },
  {
    hreflang: "x-default",
    href: "https://matteoarellano.com/",
  },
];

const growthLevers = [
  {
    number: "01",
    category: "Insights",
    title: "See where growth is hiding",
    promise:
      "Turn customer, product, market and operational data into better decisions.",
    need: "When the business has plenty of information but not enough clarity on what deserves attention next.",
    outcomes: [
      "Find revenue and margin opportunities",
      "Understand customer and product performance",
      "Spot patterns, anomalies and missed opportunities",
    ],
    tools: ["BigQuery", "SQL", "Python", "Analytics"],
  },

  {
    number: "02",
    category: "Acquisition",
    title: "Capture more demand",
    promise:
      "Get in front of people and companies already looking for what you offer.",
    need: "When the offer is strong but the business needs a more reliable way to generate qualified demand.",
    outcomes: [
      "Improve Google and local visibility",
      "Find high-intent customer opportunities",
      "Strengthen landing pages and acquisition journeys",
    ],
    tools: [
      "Google Business Profile",
      "SEO",
      "Search Console",
      "Landing pages",
    ],
  },

  {
    number: "03",
    category: "Conversion",
    title: "Turn more interest into customers",
    promise:
      "Find where customer journeys break and focus on the improvements that matter.",
    need: "When traffic, leads or users are coming in but too many disappear before the business outcome.",
    outcomes: [
      "Identify conversion leaks",
      "Understand customer behaviour and abandonment",
      "Prioritize improvements by commercial impact",
    ],
    tools: ["Amplitude", "GA4", "GTM", "BigQuery", "Experimentation"],
  },

  {
    number: "04",
    category: "Expansion",
    title: "Find the next market",
    promise:
      "Identify the customers, partners and markets worth pursuing next.",
    need: "When growth beyond the current customer base depends on better market intelligence and a more focused pipeline.",
    outcomes: [
      "Evaluate markets and segments",
      "Identify high-fit companies and partners",
      "Build repeatable business development workflows",
    ],
    tools: ["Market intelligence", "Prospecting", "CRM", "AI", "Research"],
  },

  {
    number: "05",
    category: "Scale",
    title: "Remove what slows growth down",
    promise:
      "Automate repetitive work and build the data systems the business needs to scale.",
    need: "When reporting, spreadsheets, disconnected systems or manual processes become bottlenecks.",
    outcomes: [
      "Automate recurring operational work",
      "Connect systems and APIs",
      "Build reliable data and reporting workflows",
    ],
    tools: ["Python", "APIs", "SQL", "BigQuery", "Automation"],
  },
];

const proofPoints = [
  {
    number: "42%",
    title: "Conversion improvement",
    copy: "Growth work informed by behavioural analysis and real customer journeys.",
  },
  {
    number: "90%",
    title: "Cloud cost reduction",
    copy: "Technical improvements that materially reduced the cost of data processing.",
  },
  {
    number: "9+",
    title: "Years across business & technology",
    copy: "Experience spanning finance, analytics, data engineering, growth and operations.",
  },
];

const experience = [
  {
    company: "Cargill",
    logo: "/images/experience/CARGILL_LOGO.webp",
    context: "Global agriculture & operations",
  },
  {
    company: "PIA Group",
    logo: "/images/experience/PIA_GROUP_NEDERLAND.avif",
    context: "Professional services · Netherlands",
  },
  {
    company: "European Investment Bank",
    logo: "/images/experience/EIB_BANK.png",
    context: "European institutional finance",
  },
  {
    company: "European Investment Fund",
    logo: "/images/experience/eif.png",
    context: "European institutional finance",
  },
  {
    company: "Distribusion",
    logo: "/images/experience/DISTRIBUSION_TECHNOLOGIES.png",
    context: "B2B technology · APIs · mobility",
  },
];

const workingStyle = [
  {
    number: "01",
    title: "Understand the growth constraint",
    copy: "We start with the commercial question: what are you trying to grow, what is getting in the way and what would meaningful progress look like?",
  },
  {
    number: "02",
    title: "Find the evidence",
    copy: "I combine customer behaviour, market intelligence, business context and operational data instead of relying on assumptions.",
  },
  {
    number: "03",
    title: "Turn insight into execution",
    copy: "I can move from analysis into implementation — measurement, workflows, automation, acquisition, technical systems or market development.",
  },
];

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Matteo Arellano",
  url: "https://matteoarellano.com/",
  jobTitle: "Independent Growth Partner",
  description,
  sameAs: ["https://www.linkedin.com/in/matteoarellano"],
  knowsAbout: [
    "Growth strategy",
    "Business analytics",
    "Product analytics",
    "Business development",
    "Market expansion",
    "Conversion optimization",
    "Search engine optimization",
    "Data engineering",
    "Business process automation",
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://matteoarellano.com/"
  lang="en"
  alternateLanguages={alternateLanguages}
>
  <Header />

  <script type="application/ld+json" set:html={personJsonLd} />

  <main class="services-index">
    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="services-hero">
      <div class="services-shell services-hero-grid">
        <div class="services-hero-copy">
          <span class="services-overline"> Independent growth partner </span>

          <h1>
            Find the next growth opportunity. Build what it takes to capture it.
          </h1>

          <p class="services-hero-lede">
            I combine commercial thinking, analytics and technical execution to
            help B2B and service businesses uncover better insights, convert
            more demand, expand into new markets and automate the work that
            slows growth.
          </p>

          <p class="services-hero-fit">
            From understanding the business problem to analysing the data and
            helping implement the solution.
          </p>

          <div class="services-hero-actions">
            <a class="services-primary-action" href="/services/">
              See how I help businesses grow
            </a>

            <a class="services-text-action" href="/achievements/">
              Results & experience →
            </a>
          </div>
        </div>

        <!-- PERSONAL PROFILE -->

        <aside class="services-profile">
          <div class="services-profile-image">
            <img
              src="/images/matteo-arellano-visibility-signup.jpg"
              alt="Matteo Arellano"
            />
          </div>

          <div class="services-profile-info">
            <strong>Matteo Arellano</strong>

            <p>Growth partner · Business + technology</p>

            <div class="services-profile-specialisms" aria-label="Growth focus">
              <span>Insights</span>
              <span>Conversion</span>
              <span>Expansion</span>
              <span>Automation</span>
            </div>

            <div class="services-profile-location">
              <span>Based in Mexico City</span>
              <span>Working internationally</span>
            </div>

            <nav class="services-profile-links" aria-label="Contact Matteo">
              <a href="mailto:matteo.visibility@gmail.com"> Email </a>

              <a
                href="https://www.linkedin.com/in/matteoarellano"
                target="_blank"
                rel="noreferrer"
              >
                LinkedIn
              </a>

              <a
                href="https://wa.me/525574136001"
                target="_blank"
                rel="noreferrer"
              >
                WhatsApp
              </a>
            </nav>
          </div>
        </aside>
      </div>
    </section>

    <!-- =====================================================
         PROOF
         ===================================================== -->

    <section class="services-method">
      <div class="services-shell">
        <header class="services-method-header">
          <span class="services-overline"> Selected impact </span>

          <h2>Growth has to show up somewhere measurable.</h2>
        </header>

        <div class="services-method-grid">
          {
            proofPoints.map((item) => (
              <article class="services-method-item">
                <span>{item.number}</span>

                <h3>{item.title}</h3>

                <p>{item.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =====================================================
         GROWTH LEVERS
         ===================================================== -->

    <section class="services-portfolio" id="growth">
      <div class="services-shell">
        <header class="services-portfolio-header">
          <span class="services-overline"> Growth levers </span>

          <h2>Growth is rarely just a marketing problem.</h2>

          <p>
            Sometimes the opportunity is hidden in the data. Sometimes customers
            cannot find you. Sometimes they find you but do not convert.
            Sometimes the team simply cannot scale the process behind it.
          </p>
        </header>

        <div class="services-card-grid">
          {
            growthLevers.map((lever) => (
              <article class="services-card">
                <div class="services-card-top">
                  <span class="services-card-number">{lever.number}</span>

                  <span class="services-card-category">{lever.category}</span>
                </div>

                <h3>{lever.title}</h3>

                <p class="services-card-promise">{lever.promise}</p>

                <p class="services-card-need">{lever.need}</p>

                <div class="services-card-divider" />

                <p class="services-card-label">Where I can help</p>

                <ul class="services-card-outcomes">
                  {lever.outcomes.map((outcome) => (
                    <li>{outcome}</li>
                  ))}
                </ul>

                <div class="services-card-tools">
                  {lever.tools.map((tool) => (
                    <span>{tool}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <div class="services-hero-actions">
          <a class="services-primary-action" href="/services/">
            Explore all services
          </a>
        </div>
      </div>
    </section>

    <!-- =====================================================
         DIFFERENTIATION
         ===================================================== -->

    <section class="services-method">
      <div class="services-shell">
        <header class="services-method-header">
          <span class="services-overline"> Business + technology </span>

          <h2>I bring actionable solutions in 15 days</h2>

          <p>
            The useful part of my background is the combination. I can
            understand the commercial problem, investigate it with data and go
            deep enough technically to help build the solution.
          </p>
        </header>

        <div class="services-method-grid">
          <article class="services-method-item">
            <span>BUSINESS</span>

            <h3>Commercial thinking</h3>

            <p>
              Customer acquisition, conversion, business development, market
              expansion, finance and operational performance.
            </p>
          </article>

          <article class="services-method-item">
            <span>DATA</span>

            <h3>Evidence before assumptions</h3>

            <p>
              Customer behaviour, product analytics, market intelligence, large
              datasets and business performance analysis.
            </p>
          </article>

          <article class="services-method-item">
            <span>EXECUTION</span>

            <h3>Technical depth</h3>

            <p>
              SQL, BigQuery, Python, APIs, analytics implementation, data
              pipelines, automation and technical diagnostics.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================
         EXPERIENCE
         ===================================================== -->

    <section class="services-experience">
      <div class="services-shell">
        <header class="services-experience-header">
          <span class="services-overline"> Selected experience </span>

          <h2>Experience inside different kinds of businesses.</h2>

          <p>
            My background spans global operations, professional services,
            European finance and API-intensive B2B technology. That range is
            useful when the problem does not fit neatly inside one department.
          </p>

          <a href="/achievements/" class="services-text-action">
            See achievements & recommendations →
          </a>
        </header>

        <div
          class="services-logo-grid"
          aria-label="Organizations Matteo Arellano has worked with"
        >
          {
            experience.map((item) => (
              <article class="services-logo-item">
                <div class="services-logo-image">
                  <img
                    src={item.logo}
                    alt={`${item.company} logo`}
                    loading="lazy"
                  />
                </div>

                <div class="services-logo-copy">
                  <strong>{item.company}</strong>

                  <span>{item.context}</span>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =====================================================
         WORKING RELATIONSHIP
         ===================================================== -->

    <section class="services-method">
      <div class="services-shell">
        <header class="services-method-header">
          <span class="services-overline"> How I work </span>

          <h2>From opportunity to execution.</h2>

          <p>
            The goal is not another report. It is to understand what would move
            the business forward and help make it happen.
          </p>
        </header>

        <div class="services-method-grid">
          {
            workingStyle.map((item) => (
              <article class="services-method-item">
                <span>{item.number}</span>

                <h3>{item.title}</h3>

                <p>{item.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =====================================================
         FINAL CTA
         ===================================================== -->

    <section class="services-contact">
      <div class="services-shell services-contact-inner">
        <div>
          <span class="services-overline"> Let's grow </span>

          <h2>What are you trying to grow?</h2>

          <p>
            Tell me what you want to improve — acquisition, conversion,
            expansion, insight or operations. I'll tell you where I would start
            and whether I can help.
          </p>
        </div>

        <div class="services-contact-actions">
          <a
            class="services-contact-primary"
            href="mailto:matteo.visibility@gmail.com?subject=Growth%20opportunity&body=Hi%20Matteo,%0A%0AWhat%20we%20want%20to%20grow%20or%20improve%20is:%20"
          >
            Tell me what you want to grow
          </a>

          <a
            class="services-contact-secondary"
            href="https://wa.me/525574136001?text=Hi%20Matteo%2C%20I'd%20like%20to%20talk%20about%20a%20growth%20opportunity."
            target="_blank"
            rel="noreferrer"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- FLOATING WHATSAPP -->

  <a
    class="services-whatsapp-float"
    href="https://wa.me/525574136001?text=Hi%20Matteo%2C%20I'd%20like%20to%20talk%20about%20a%20growth%20opportunity."
    target="_blank"
    rel="noreferrer"
    aria-label="Contact Matteo on WhatsApp"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.148-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.099-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.009-.371-.011-.57-.011-.198 0-.52.074-.792.371-.272.297-1.04 1.016-1.04 2.479s1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.693.625.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
      ></path>
      <path
        d="M12.004 2C6.477 2 2 6.477 2 12c0 1.764.459 3.42 1.261 4.858L2 22l5.293-1.235A9.94 9.94 0 0 0 12.004 22C17.527 22 22 17.523 22 12S17.527 2 12.004 2zm0 18.182a8.14 8.14 0 0 1-4.147-1.135l-.297-.176-3.14.733.748-3.058-.193-.314A8.145 8.145 0 0 1 3.818 12c0-4.515 3.671-8.182 8.186-8.182 4.511 0 8.178 3.667 8.178 8.182s-3.667 8.182-8.178 8.182z"
      ></path>
    </svg>

    <span>WhatsApp</span>
  </a>

  <Footer />
</BaseLayout>
