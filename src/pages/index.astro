---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DiscoveryCalendar from "../components/DiscoveryCalendar.astro";
import { growthServices } from "../data/growthServices";
import { recommendations } from "../data/achievements";
import "../styles/growth-platform.css";

const title = "Technical Growth Partner | Matteo Arellano";
const description =
  "I help companies create new revenue opportunities, improve conversion, acquire qualified demand, uncover commercial insights and automate expensive work.";

const valueOutcomes = [
  {
    label: "New revenue",
    title: "Find new markets, partners and commercial opportunities.",
    copy: "Identify where the next source of growth could come from and turn it into a focused commercial path.",
  },
  {
    label: "Higher conversion",
    title: "Turn more of the demand you already have into revenue.",
    copy: "Find the funnel, payment and product friction that is costing customers and prioritize the fixes that matter.",
  },
  {
    label: "More qualified demand",
    title: "Help the right customers discover you and take action.",
    copy: "Connect search, paid acquisition, landing pages and measurement to real commercial outcomes.",
  },
  {
    label: "Lower cost & manual work",
    title: "Automate expensive recurring work and build systems that scale.",
    copy: "Use data workflows, APIs and automation to reduce operational friction and recurring cost.",
  },
];

const featuredRecommendationNames = [
  "Oscar Flores",
  "Jose Laguna",
  "Lucas Zarpellon",
];
const featuredRecommendations = featuredRecommendationNames
  .map((name) => recommendations.find((item) => item.name === name))
  .filter(Boolean);

const companies = [
  {
    name: "Distribusion Technologies",
    logo: "/images/experience/DISTRIBUSION_TECHNOLOGIES.png",
  },
  {
    name: "Cargill",
    logo: "/images/experience/CARGILL_LOGO.webp",
  },
  {
    name: "European Investment Bank",
    logo: "/images/experience/EIB_BANK.png",
  },
  {
    name: "European Investment Fund",
    logo: "/images/experience/eif.png",
  },
  {
    name: "PIA Group Netherlands",
    logo: "/images/experience/PIA_GROUP_NEDERLAND.avif",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://matteoarellano.com/"
  image="/images/matteo-arellano-visibility-signup.jpg"
>
  <Header />

  <main class="growth-home">
    <section class="growth-hero">
      <div class="growth-shell growth-hero-grid">
        <div class="growth-hero-copy">
          <span class="growth-overline">Technical Growth Partner</span>
          <h1>
            I help companies find new ways to grow and turn them into revenue.
          </h1>
          <p class="growth-hero-lede">
            From new markets and partnerships to conversion, acquisition, data
            and automation, I help teams identify commercial opportunities,
            understand what is holding growth back and build the next move.
          </p>

          <div class="growth-hero-actions">
            <a class="growth-primary-button" href="#services"
              >Explore how I can help</a
            >
            <a class="growth-secondary-link" href="#availability"
              >Talk through an opportunity →</a
            >
          </div>

          <div class="growth-hero-principle">
            <span>How I work</span>
            <strong
              >Start with the commercial outcome: more revenue, higher
              conversion, lower cost or faster execution. Then use the right
              tools to get there.</strong
            >
          </div>
        </div>

        <aside class="growth-portrait-card" aria-label="About Matteo Arellano">
          <div class="growth-portrait-image">
            <img
              src="/images/matteo-arellano-visibility-signup.jpg"
              alt="Matteo Arellano"
            />
          </div>
          <div class="growth-portrait-copy">
            <span>Business + technology</span>
            <strong>Matteo Arellano</strong>
            <p>
              Growth partner working across commercial questions, analytics and
              technical execution. Founder of Yeelen.
            </p>
            <div class="growth-portrait-links">
              <a
                href="https://www.linkedin.com/in/matteoarellano"
                target="_blank"
                rel="noreferrer">LinkedIn</a
              >
              <a href="mailto:matteo.visibility@gmail.com">Email</a>
              <a href="/about/">About</a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="growth-value-strip" aria-label="Commercial outcomes">
      <div class="growth-shell growth-value-strip-grid">
        {
          valueOutcomes.map((item, index) => (
            <article class="growth-value-strip-item">
              <span>
                {String(index + 1).padStart(2, "0")} · {item.label}
              </span>
              <h2>{item.title}</h2>
              <p>{item.copy}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="growth-services-section" id="services">
      <div class="growth-shell">
        <header class="growth-section-heading">
          <span class="growth-overline">How I can help</span>
          <h2>Five ways I help companies create commercial value.</h2>
          <p>
            Each service has a clear end state. The work can still cross between
            commercial, analytical and technical areas when that is what gets
            the result.
          </p>
        </header>

        <div class="growth-service-grid">
          {
            growthServices.map((service, index) => (
              <article
                class:list={[
                  "growth-service-card",
                  index === 0 && "growth-service-card--featured",
                ]}
              >
                <div class="growth-service-card-top">
                  <span>{service.number}</span>
                  <span>{service.name}</span>
                </div>
                <h3>{service.shortTitle}</h3>
                <p class="growth-service-promise">{service.homepagePromise}</p>
                <p class="growth-service-description">
                  {service.homepageDescription}
                </p>
                <a href={`/services/${service.slug}/`}>
                  Explore {service.name} <span>→</span>
                </a>
              </article>
            ))
          }
        </div>

        <div class="growth-section-footer-link">
          <a href="/services/">See all services together →</a>
        </div>
      </div>
    </section>

    <section class="growth-recommendations-section" id="recommendations">
      <div class="growth-shell">
        <header class="growth-section-heading growth-section-heading--compact">
          <span class="growth-overline">Recommendations & appraisals</span>
          <h2>What people I have worked with say.</h2>
          <p>
            The strongest proof of how I work comes from people who have seen me
            inside real teams, messy problems and demanding projects.
          </p>
        </header>

        <div class="growth-recommendation-grid">
          {
            featuredRecommendations.map(
              (item) =>
                item && (
                  <article class="growth-recommendation-card">
                    <span class="growth-quote-mark" aria-hidden="true">
                      “
                    </span>
                    <blockquote>{item.quote}</blockquote>
                    <footer>
                      <strong>{item.name}</strong>
                      <span>{item.headline}</span>
                    </footer>
                  </article>
                ),
            )
          }
        </div>

        <a
          class="growth-recommendations-link"
          href="/achievements/#recommendations"
        >
          Read all recommendations, appraisals and career evidence →
        </a>
      </div>
    </section>

    <section class="growth-partner-section">
      <div class="growth-shell growth-partner-grid">
        <div>
          <span class="growth-overline">How I partner</span>
          <h2>Move from a growth goal to a concrete next action.</h2>
        </div>
        <div class="growth-partner-steps">
          <article>
            <span>01</span>
            <h3>Define the commercial target</h3>
            <p>
              More revenue, higher conversion, lower cost, a new market or a
              better decision — make the end state explicit.
            </p>
          </article>
          <article>
            <span>02</span>
            <h3>Find what is blocking it</h3>
            <p>
              Use prospect conversations, customer behaviour, market signals and
              data to identify the real constraint or opportunity.
            </p>
          </article>
          <article>
            <span>03</span>
            <h3>Build the next move</h3>
            <p>
              Turn the evidence into outreach, a product change, an experiment,
              a partnership, automation or another measurable action.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="growth-calendar-band">
      <div class="growth-shell">
        <DiscoveryCalendar
          namespace="homepage-discovery"
          eyebrow="Talk and discover together"
          title="Have something you're trying to grow, fix or understand?"
          copy="Tell me what you are working on. We can use 20 minutes to understand the problem, exchange ideas and see whether there is a useful way for me to contribute."
        />
      </div>
    </section>

    <section
      class="growth-companies-section"
      aria-labelledby="companies-heading"
    >
      <div class="growth-shell">
        <header class="growth-companies-heading">
          <span class="growth-overline">Experience</span>
          <h2 id="companies-heading">Companies and teams I've worked with.</h2>
        </header>

        <div class="growth-company-grid">
          {
            companies.map((company) => (
              <div class="growth-company-logo" title={company.name}>
                <img
                  src={company.logo}
                  alt={`${company.name} logo`}
                  loading="lazy"
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
