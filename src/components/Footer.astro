---
import { getCollection } from "astro:content";

const fieldNotes = (await getCollection("journal", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<footer class="site-footer growth-site-footer">
  <div class="container growth-footer-grid">
    <div class="growth-footer-brand">
      <a class="growth-footer-name" href="/">Matteo Arellano</a>
      <p>
        Technical Growth Partner working across expansion, commercial analysis,
        product, acquisition, data and automation.
      </p>
      <div class="growth-footer-socials">
        <a href="mailto:matteo.visibility@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/matteoarellano" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>

    <div class="growth-footer-notes">
      <span class="growth-footer-label">Field Notes</span>
      <div class="growth-footer-note-list">
        {fieldNotes.map((entry) => (
          <a href={`/journal/${entry.id}/`}>
            <strong>{entry.data.title}</strong>
            <span>{entry.data.description}</span>
          </a>
        ))}
      </div>
      <a class="growth-footer-all-notes" href="/journal/">View all Field Notes →</a>
    </div>

    <nav class="growth-footer-nav" aria-label="Footer navigation">
      <span class="growth-footer-label">Explore</span>
      <a href="/services/">Services</a>
      <a href="/achievements/#recommendations">Recommendations</a>
      <a href="/about/">About</a>
      <a href="https://lab.matteoarellano.com/" target="_blank" rel="noreferrer">Lab & experiments</a>
      <a href="/privacy-policy/">Privacy</a>
    </nav>
  </div>

  <div class="container growth-footer-bottom">
    <span>© {new Date().getFullYear()} Matteo Arellano</span>
    <span>Business problems first. Tools second.</span>
  </div>
</footer>
