---
/**
 * One service landing page in English, Spanish or Dutch. Words come from
 * src/data/services.ts and its translations (see servicesI18n.ts).
 * Layout: evidence-led hero, outcomes, fit, scope, proof, method, FAQ, booking.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import DiscoveryCalendar from "./DiscoveryCalendar.astro";
import { recommendations } from "../data/achievements";
import {
  getServices,
  serviceAlternates,
  engagementFormatsByLang,
  serviceUi,
  type LocalService,
} from "../data/servicesI18n";
import { hreflangLinks, servicesHubPath, homePath, recommendationsLink } from "../data/siteUi";
import "../styles/growth-platform.css";
import "../styles/service.css";

interface Props {
  service: LocalService;
}

const { service } = Astro.props;
const lang = service.lang;
const ui = serviceUi[lang];
const hub = servicesHubPath[lang];
const alternates = serviceAlternates(service.slug);
const isTranslated = lang !== "en";
const site = "https://matteoarellano.com";
const url = `${site}${service.path}`;
const email = "matteo.visibility@gmail.com";

const recommender = recommendations.find((item) => item.id === service.quote.recommendationId);
const otherServices = getServices(lang).filter((item) => item.slug !== service.slug);
const engagementFormats = engagementFormatsByLang[lang];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${url}#service`,
      name: service.name,
      serviceType: service.serviceTypes,
      description: service.metaDescription,
      url,
      inLanguage: lang,
      areaServed: "Worldwide",
      availableLanguage: ["en", "es", "ca", "nl", "pt", "fr"],
      provider: { "@id": `${site}/#person` },
    },
    {
      "@type": "WebPage",
      "@id": `${url}#page`,
      url,
      name: service.metaTitle,
      description: service.metaDescription,
      inLanguage: lang,
      isPartOf: { "@id": `${site}/#website` },
      about: { "@id": `${url}#service` },
      primaryImageOfPage: `${site}${service.hero.ogImage}`,
      breadcrumb: { "@id": `${url}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${url}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: ui.home, item: `${site}${homePath[lang]}` },
        { "@type": "ListItem", position: 2, name: ui.services, item: `${site}${hub}` },
        { "@type": "ListItem", position: 3, name: service.name, item: url },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${url}#faq`,
      mainEntity: service.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonical={url}
  image={service.hero.ogImage}
  lang={lang}
  alternateLanguages={hreflangLinks(alternates)}
>
  <Header lang={lang} alternates={alternates} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="sv">
    <!-- ======================= Hero ======================= -->
    <section class="sv-hero" aria-labelledby="sv-title">
      <picture class="sv-hero-bg" aria-hidden="true">
        <source media="(max-width: 700px)" srcset={service.hero.imagePortrait} />
        <img
          src={`${service.hero.image}-1920.webp`}
          srcset={`${service.hero.image}-768.webp 768w, ${service.hero.image}-1280.webp 1280w, ${service.hero.image}-1920.webp 1920w`}
          sizes="100vw"
          width="1920"
          height="1080"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="sv-shell sv-hero-inner">
        <nav class="sv-crumbs" aria-label={ui.breadcrumb}>
          <a href={hub}>{ui.services}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{service.name}</span>
        </nav>
        <p class="sv-kicker">{service.hero.kicker}</p>
        <h1 id="sv-title">{service.hero.title}</h1>
        <p class="sv-lede">{service.hero.lede}</p>

        <div class="sv-actions">
          <a class="sv-btn sv-btn--primary" href="#availability">{ui.bookCall}</a>
          <a class="sv-btn sv-btn--ghost" href="#evidence">{ui.seeEvidence}</a>
        </div>

        <dl class="sv-stats">
          {
            service.stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ======================= Outcomes ======================= -->
    <section class="sv-section" aria-labelledby="outcomes-title">
      <div class="sv-shell">
        <header class="sv-head">
          <p class="sv-overline">{ui.outcomesOverline}</p>
          <h2 id="outcomes-title">{ui.outcomesTitle}</h2>
        </header>
        <div class="sv-outcomes">
          {
            service.outcomes.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ======================= Fit + how it starts ======================= -->
    <section class="sv-section sv-section--tint" aria-labelledby="fit-title">
      <div class="sv-shell sv-fit">
        <div>
          <p class="sv-overline">{ui.fitOverline}</p>
          <h2 id="fit-title">{ui.fitTitle}</h2>
          <ul class="sv-signals">
            {service.signals.map((signal) => <li>{signal}</li>)}
          </ul>
        </div>
        <aside class="sv-start" aria-labelledby="start-title">
          <h3 id="start-title">{ui.startTitle}</h3>
          <ol>
            {
              ui.steps.map(([lead, copy]) => (
                <li>
                  <strong>{lead}</strong> {copy}
                </li>
              ))
            }
            <li>
              <strong>{ui.firstStep}</strong> {service.firstDeliverable.replace("The first deliverable is ", "It is ")}
            </li>
          </ol>
          <a class="sv-btn sv-btn--primary sv-btn--block" href="#availability">{ui.bookCall}</a>
          <p class="sv-start-alt">
            {ui.emailAlt} <a href={`mailto:${email}`}>{email}</a>
          </p>
        </aside>
      </div>
    </section>

    <!-- ======================= Scope ======================= -->
    <section class="sv-section" aria-labelledby="scope-title">
      <div class="sv-shell">
        <header class="sv-head">
          <p class="sv-overline">{ui.scopeOverline}</p>
          <h2 id="scope-title">{ui.scopeTitle}</h2>
        </header>
        <div class="sv-scope">
          {
            service.scope.map((area) => (
              <article>
                <h3>{area.title}</h3>
                <p>{area.copy}</p>
                <ul>
                  {area.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ======================= Evidence ======================= -->
    <section class="sv-proof on-dark" id="evidence" aria-labelledby="evidence-title">
      <div class="sv-shell">
        <header class="sv-head sv-head--dark">
          <p class="sv-overline">{ui.evidenceOverline}</p>
          <h2 id="evidence-title">{ui.evidenceTitle}</h2>
        </header>

        <div class="sv-proof-grid">
          {
            recommender && (
              <figure class="sv-quote">
                <blockquote lang={isTranslated ? "en" : undefined}>
                  <p>{service.quote.text}</p>
                </blockquote>
                <figcaption>
                  <strong>{recommender.name}</strong>
                  <span lang={isTranslated ? "en" : undefined}>{recommender.headline}</span>
                  {ui.quoteNote && <em class="sv-quote-note">{ui.quoteNote}</em>}
                </figcaption>
                <a href={recommendationsLink[lang]}>{ui.allRecommendations}</a>
              </figure>
            )
          }

          <div class="sv-work">
            <ul>
              {
                service.evidence.map((item) => (
                  <li>
                    <a href={item.href}>
                      <span>{item.type}</span>
                      <strong lang={isTranslated && item.english ? "en" : undefined}>{item.title}</strong>
                    </a>
                  </li>
                ))
              }
            </ul>
            {ui.evidenceNote && <p class="sv-work-note">{ui.evidenceNote}</p>}
            {service.evidenceMore && (
              <a class="sv-work-more" href={service.evidenceMore.href}>
                {service.evidenceMore.label} →
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- ======================= Method ======================= -->
    <section class="sv-section" aria-labelledby="method-title">
      <div class="sv-shell">
        <header class="sv-head">
          <p class="sv-overline">{ui.methodOverline}</p>
          <h2 id="method-title">{ui.methodTitle}</h2>
        </header>
        <ol class="sv-steps">
          {
            service.approach.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{step.title}</h3>
                <p>{step.copy}</p>
              </li>
            ))
          }
        </ol>

        <div class="sv-formats">
          <h3>{ui.formatsTitle}</h3>
          <div>
            {
              engagementFormats.map((format) => (
                <article>
                  <strong>{format.title}</strong>
                  <p>{format.copy}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="sv-tools">
          <h3>{ui.toolsTitle}</h3>
          <ul>
            {service.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ======================= FAQ ======================= -->
    <section class="sv-section sv-section--tint" aria-labelledby="faq-title">
      <div class="sv-shell sv-faq-wrap">
        <header class="sv-head">
          <p class="sv-overline">{ui.faqOverline}</p>
          <h2 id="faq-title">{ui.faqTitle}</h2>
        </header>
        <div class="sv-faq">
          {
            service.faqs.map((faq, index) => (
              <details open={index === 0}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ======================= Book ======================= -->
    <section class="sv-book" aria-label={ui.bookLabel}>
      <div class="sv-shell">
        <div class="sv-book-card">
          <DiscoveryCalendar
            namespace={`service-${service.slug}`}
            eyebrow={ui.calendar.eyebrow}
            title={service.ctaTitle}
            copy={service.ctaCopy}
            note={ui.calendar.note}
            noteDetail={ui.calendar.noteDetail}
            embedLabel={ui.calendar.embedLabel}
          />
          <p class="sv-book-alt">
            {ui.emailAlt} <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ======================= Other services ======================= -->
    <section class="sv-section" aria-labelledby="more-title">
      <div class="sv-shell">
        <header class="sv-head">
          <p class="sv-overline">{ui.othersOverline}</p>
          <h2 id="more-title">{ui.othersTitle}</h2>
        </header>
        <div class="sv-others">
          {
            otherServices.map((item) => (
              <a href={item.path}>
                <span>{item.number}</span>
                <strong>{item.name}</strong>
                <p>{item.short}</p>
              </a>
            ))
          }
        </div>
        <p class="sv-all"><a href={hub}>{ui.allServices}</a></p>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
