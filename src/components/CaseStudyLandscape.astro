---
/**
 * Quiet, abstract mountain landscape used as the backdrop of the
 * payment case-study pages. Pure SVG, decorative only.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={["cs-landscape", className]}
  viewBox="0 0 1440 520"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="cs-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#e4eef7" />
      <stop offset="62%" stop-color="#f3f1ec" />
      <stop offset="100%" stop-color="#f8f4ee" />
    </linearGradient>
    <linearGradient id="cs-fade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="1" />
    </linearGradient>
    <radialGradient id="cs-sun" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#fbe9d3" stop-opacity="0.95" />
      <stop offset="100%" stop-color="#fbe9d3" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="1440" height="520" fill="url(#cs-sky)" />
  <circle cx="1040" cy="300" r="190" fill="url(#cs-sun)" />

  <path
    d="M0 330 L120 280 L210 300 L330 220 L430 270 L560 200 L690 262 L800 230 L930 290 L1060 236 L1180 286 L1300 248 L1440 292 L1440 520 L0 520 Z"
    fill="#d2e0ec"
  />
  <path
    d="M0 380 L150 330 L260 352 L400 300 L520 344 L660 310 L780 350 L900 318 L1040 362 L1180 326 L1320 356 L1440 334 L1440 520 L0 520 Z"
    fill="#bdd1e3"
  />
  <path
    d="M0 430 L180 396 L340 418 L500 386 L660 420 L820 398 L980 430 L1140 404 L1300 426 L1440 410 L1440 520 L0 520 Z"
    fill="#a9c3da"
    opacity="0.9"
  />
  <rect y="380" width="1440" height="140" fill="url(#cs-fade)" />
</svg>
