---
/**
 * The homepage, shared by / (English), /es/ and /nl/.
 * Layout and behaviour live here; all words live in src/data/homeContent.ts.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import { servicesHubPath, recommendationsLink } from "../data/siteUi";
import DiscoveryCalendar from "./DiscoveryCalendar.astro";
import { recommendations } from "../data/achievements";
import { languageLevels } from "../data/languages";
import {
  homeContent,
  homeEmail as email,
  homeWhatsapp,
  homeLanguages,
  type HomeLang,
} from "../data/homeContent";
import "../styles/growth-platform.css";
import "../styles/home.css";

interface Props {
  lang: HomeLang;
}

const { lang } = Astro.props;
const t = homeContent[lang];

const site = "https://matteoarellano.com";
const linkedin = "https://www.linkedin.com/in/matteoarellano";

const languageCount = languageLevels.reduce(
  (sum, level) => sum + level.languages.length,
  0,
);

const knowLinks = t.know.links.map((link) => ({
  ...link,
  title: link.title.replace("{languages}", String(languageCount)),
}));

const featured = recommendations.find((item) => item.id === "oscar-flores");
const featuredQuote = featured?.quote.split("\n\n")[0] ?? "";

const companies = [
  { name: "European Investment Bank", logo: "/images/experience/EIB_BANK.png" },
  { name: "European Investment Fund", logo: "/images/experience/eif.png" },
  { name: "Cargill", logo: "/images/experience/CARGILL_LOGO.webp" },
  { name: "PIA Group Netherlands", logo: "/images/experience/PIA_GROUP_NEDERLAND.avif" },
  { name: "Distribusion Technologies", logo: "/images/experience/DISTRIBUSION_TECHNOLOGIES.png" },
  { name: "WeGoZero", logo: "/images/experience/logo_wegozero.png" },
];

const alternateLanguages = [
  { hreflang: "en", href: `${site}/` },
  { hreflang: "es", href: `${site}/es/` },
  { hreflang: "nl", href: `${site}/nl/` },
  { hreflang: "x-default", href: `${site}/` },
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: t.video.title,
  description: t.video.description,
  inLanguage: lang,
  thumbnailUrl: `${site}${t.video.src.poster}`,
  uploadDate: lang === "en" ? "2026-10-31" : "2026-11-01",
  duration: "PT30S",
  publisher: { "@id": `${site}/#person` },
};

---

<BaseLayout
  title={t.title}
  description={t.description}
  canonical={`${site}${t.path}`}
  lang={lang}
  image="/images/home/og-home.jpg"
  alternateLanguages={alternateLanguages}
>
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

  <header class="hm-top">
    <a class="hm-skip" href="#explore">{t.skip}</a>
    <nav class="hm-nav" aria-label={t.navLabel}>
      {t.nav.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <nav class="hm-lang" aria-label={t.langLabel}>
      {
        homeLanguages.map((language) => (
          <a
            href={language.href}
            hreflang={language.lang}
            lang={language.lang}
            aria-label={t.langLinkLabel(language.lang)}
            aria-current={language.lang === lang ? "page" : undefined}
          >
            {language.label}
          </a>
        ))
      }
    </nav>
  </header>

  <main class="hm">
    <!-- ======================= Hero ======================= -->
    <section class="hm-hero" aria-labelledby="hm-title">
      <picture class="hm-hero-bg" aria-hidden="true">
        <source media="(max-width: 700px)" srcset="/images/home/globe-forest-portrait-900.webp" />
        <img
          src="/images/home/globe-forest-1920.webp"
          srcset="/images/home/globe-forest-768.webp 768w, /images/home/globe-forest-1280.webp 1280w, /images/home/globe-forest-1920.webp 1920w, /images/home/globe-forest-2400.webp 2400w"
          sizes="100vw"
          width="1920"
          height="1080"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="hm-hero-inner">
        <p class="hm-overline">{t.overline}</p>
        <h1 id="hm-title">Matteo Arellano</h1>
        <span class="hm-rule" aria-hidden="true"></span>
        <p class="hm-lede">
          {t.lede[0]}<em>{t.lede[1]}</em>{t.lede[2]}
        </p>

        <div class="hm-actions">
          <a
            class="hm-btn hm-btn--primary"
            href={`mailto:${email}?subject=${encodeURIComponent(t.contact.subject.replace("{label}", t.contact.topics[t.contact.topics.length - 1].label))}`}
            data-contact-open
            aria-haspopup="dialog"
          >
            {t.contact.cta}
          </a>
          <button class="hm-btn hm-btn--video" type="button" data-video-open aria-haspopup="dialog">
            <img src="/images/home/intro-thumb-160.webp" width="36" height="36" alt="" />
            <span>{t.watchIntro}</span>
            {
              t.videoLangBadge && (
                <small class="hm-lang-badge" aria-label={t.videoLangBadge.label}>
                  {t.videoLangBadge.text}
                </small>
              )
            }
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7-4.5z" fill="currentColor"></path></svg>
          </button>
        </div>

        <p class="hm-quick">
          <a href={`mailto:${email}`}>{t.quick.email}</a>
          <span aria-hidden="true">·</span>
          <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href="#explore">{t.quick.explore}</a>
        </p>
      </div>

      <a class="hm-scroll" href="#explore" aria-label={t.scrollLabel}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </section>

    <!-- ======================= Routing ======================= -->
    <section class="hm-explore" id="explore" aria-labelledby="explore-title">
      <div class="hm-shell">
        <header class="hm-head">
          <p class="hm-overline">{t.exploreOverline}</p>
          <h2 id="explore-title">{t.exploreTitle}</h2>
          {t.exploreNote && <p class="hm-head-note">{t.exploreNote}</p>}
        </header>

        <div class="hm-paths">
          <article class="hm-path">
            <img class="hm-path-img" src="/images/home/card-river-800.webp" width="800" height="500" alt="" loading="lazy" decoding="async" />
            <div class="hm-path-body">
              <p class="hm-path-kicker">{t.work.kicker}</p>
              <h3>{t.work.title}</h3>
              <ul>
                {t.work.links.map((link) => (
                  <li>
                    <a href={link.href}>
                      <strong>{link.title}</strong>
                      <span>{link.copy}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a class="hm-path-more" href={servicesHubPath[lang]}>{t.work.more}</a>
            </div>
          </article>

          <article class="hm-path">
            <img class="hm-path-img" src="/images/home/card-iceland-800.webp" width="800" height="500" alt="" loading="lazy" decoding="async" />
            <div class="hm-path-body">
              <p class="hm-path-kicker">{t.know.kicker}</p>
              <h3>{t.know.title}</h3>
              <ul>
                {knowLinks.map((link) => (
                  <li>
                    <a href={link.href}>
                      <strong>{link.title}</strong>
                      <span>{link.copy}</span>
                    </a>
                  </li>
                ))}
                <li>
                  <button type="button" data-video-open aria-haspopup="dialog">
                    <strong>{t.know.videoTitle}</strong>
                    <span>{t.know.videoCopy}</span>
                  </button>
                </li>
              </ul>
              <a class="hm-path-more" href="/achievements/">{t.know.more}</a>
            </div>
          </article>

          <article class="hm-path">
            <img class="hm-path-img" src="/images/case-studies/canal-golden-hour-768.webp" width="768" height="510" alt="" loading="lazy" decoding="async" />
            <div class="hm-path-body">
              <p class="hm-path-kicker">{t.read.kicker}</p>
              <h3>{t.read.title}</h3>
              <ul>
                {t.read.links.map((link) => (
                  <li>
                    <a href={link.href}>
                      <strong>{link.title}</strong>
                      <span>{link.copy}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a class="hm-path-more" href="/blog/">{t.read.more}</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ======================= Proof ======================= -->
    <section class="hm-proof on-dark" aria-labelledby="proof-title">
      <div class="hm-shell">
        <h2 id="proof-title" class="hm-visually-hidden">{t.proofTitle}</h2>
        <div class="hm-proof-grid">
          {
            featured && (
              <figure class="hm-quote">
                <blockquote lang={lang === "en" ? undefined : "en"}>
                  <p>{featuredQuote}</p>
                </blockquote>
                <figcaption>
                  <strong>{featured.name}</strong>
                  <span>{featured.headline}</span>
                  {t.quoteNote && <em class="hm-quote-note">{t.quoteNote}</em>}
                </figcaption>
                <a href={recommendationsLink[lang]}>{t.allRecommendations}</a>
              </figure>
            )
          }

          <dl class="hm-stats">
            {t.stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="hm-logos" aria-label={t.logosLabel}>
          {companies.map((company) => (
            <span title={company.name}>
              <img src={company.logo} alt={company.name} loading="lazy" decoding="async" />
              {company.name === "WeGoZero" && <small aria-hidden="true">WeGoZero</small>}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================= Book ======================= -->
    <section class="hm-book" aria-label={t.bookLabel}>
      <div class="hm-shell">
        <div class="hm-book-card">
          <DiscoveryCalendar {...t.calendar} />
          <p class="hm-book-alt">
            {t.emailAlt} <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  <!-- ======================= Contact dialog ======================= -->
  <dialog
    class="hm-contact"
    aria-labelledby="hm-contact-title"
    data-email={email}
    data-whatsapp={homeWhatsapp}
    data-message={t.contact.message}
    data-subject={t.contact.subject}
  >
    <form method="dialog" class="hm-contact-card">
      <button class="hm-contact-close" type="submit" aria-label={t.contact.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
      <h2 id="hm-contact-title">{t.contact.title}</h2>
      <p class="hm-contact-copy">{t.contact.copy}</p>

      <fieldset class="hm-contact-topics">
        <legend class="hm-visually-hidden">{t.contact.topicsLabel}</legend>
        {
          t.contact.topics.map((topic, index) => (
            <label>
              <input
                type="radio"
                name="topic"
                value={topic.id}
                data-label={topic.label}
                data-phrase={topic.phrase}
              />
              <span>{topic.label}</span>
            </label>
          ))
        }
      </fieldset>

      <label class="hm-contact-detail">
        <span>{t.contact.detailLabel}</span>
        <textarea name="detail" rows="2" maxlength="400" placeholder={t.contact.detailPlaceholder}></textarea>
      </label>

      <div class="hm-contact-send">
        <a class="hm-contact-btn hm-contact-btn--wa" href={`https://wa.me/${homeWhatsapp}`} target="_blank" rel="noopener noreferrer" data-send="whatsapp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a9.7 9.7 0 0 0-8.3 14.7L2.4 22l5.4-1.4A9.8 9.8 0 1 0 12 2Zm0 17.7a7.7 7.7 0 0 1-3.9-1.1l-.3-.2-3.2.8.9-3.1-.2-.3A7.8 7.8 0 1 1 12 19.7Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.3 6.3 0 0 1-3.1-2.7c-.2-.3 0-.4.1-.5l.6-.7c.1-.2.2-.4.1-.6l-.7-1.7c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3.1 5 4.2 3 .9 3 .6 3.5.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .2-1.1-.1-.1-.2-.2-.4-.3Z"></path></svg>
          {t.contact.whatsapp}
        </a>
        <a class="hm-contact-btn hm-contact-btn--mail" href={`mailto:${email}`} data-send="email">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4z M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg>
          {t.contact.email}
        </a>
      </div>

      <a class="hm-contact-call" href="#availability" data-contact-call>{t.contact.call}</a>
    </form>
  </dialog>

  <!-- ======================= Video dialog ======================= -->
  <dialog class="hm-video" aria-labelledby="hm-video-title">
    <div class="hm-video-frame">
      <h2 id="hm-video-title" class="hm-visually-hidden">{t.video.title}</h2>
      <video
        controls
        playsinline
        preload="none"
        controlslist="nodownload noplaybackrate noremoteplayback"
        disablepictureinpicture
        disableremoteplayback
        poster={t.video.src.poster}
        data-hls={t.video.src.hls}
      ></video>
      <button class="hm-video-close" type="button" data-video-close aria-label={t.video.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <details class="hm-video-text">
      <summary>{t.video.readAsText}</summary>
      <p>{t.video.transcript(languageCount)}</p>
    </details>
  </dialog>

  <script>
    /* ---------- Contact dialog: a prefilled WhatsApp or email message ---------- */
    const contact = document.querySelector<HTMLDialogElement>(".hm-contact");

    function contactText() {
      if (!contact) return { message: "", subject: "" };
      const chosen =
        contact.querySelector<HTMLInputElement>('input[name="topic"]:checked') ??
        Array.from(contact.querySelectorAll<HTMLInputElement>('input[name="topic"]')).pop();
      const detail = contact.querySelector<HTMLTextAreaElement>("textarea")?.value.trim() ?? "";
      const message =
        (contact.dataset.message ?? "").replace("{topic}", chosen?.dataset.phrase ?? "") + (detail ? `\n\n${detail}` : "");
      const subject = (contact.dataset.subject ?? "").replace("{label}", chosen?.dataset.label ?? "");
      return { message, subject };
    }

    function refreshLinks() {
      if (!contact) return;
      const { message, subject } = contactText();
      const wa = contact.querySelector<HTMLAnchorElement>('[data-send="whatsapp"]');
      const mail = contact.querySelector<HTMLAnchorElement>('[data-send="email"]');
      if (wa) wa.href = `https://wa.me/${contact.dataset.whatsapp}?text=${encodeURIComponent(message)}`;
      if (mail) {
        mail.href = `mailto:${contact.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}`;
      }
    }

    document.querySelectorAll<HTMLElement>("[data-contact-open]").forEach((button) =>
      button.addEventListener("click", (event) => {
        if (!contact) return;
        event.preventDefault();
        refreshLinks();
        contact.showModal();
      }),
    );
    contact?.addEventListener("input", refreshLinks);
    contact?.addEventListener("click", (event) => {
      if (event.target === contact) contact.close();
    });
    contact?.querySelector("[data-contact-call]")?.addEventListener("click", () => contact.close());

    /* ---------- Video: streamed in segments, never as one downloadable file ---------- */
    type HlsPlayer = { loadSource(src: string): void; attachMedia(media: HTMLMediaElement): void };
    type HlsClass = { new (config?: object): HlsPlayer; isSupported(): boolean };

    const dialog = document.querySelector<HTMLDialogElement>(".hm-video");
    const video = dialog?.querySelector<HTMLVideoElement>("video");
    let hlsLoading: Promise<HlsClass | null> | null = null;

    // Load the small streaming library only when someone shows interest in the video.
    function loadHls() {
      hlsLoading ??= new Promise<HlsClass | null>((resolve) => {
        const existing = (window as unknown as { Hls?: HlsClass }).Hls;
        if (existing) return resolve(existing);
        const script = document.createElement("script");
        script.src = "/vendor/hls/hls.light.min.js";
        script.async = true;
        script.onload = () => resolve((window as unknown as { Hls?: HlsClass }).Hls ?? null);
        script.onerror = () => resolve(null);
        document.head.append(script);
      });
      return hlsLoading;
    }

    async function attachStream() {
      if (!video || video.dataset.attached) return;
      video.dataset.attached = "true";
      const src = video.dataset.hls ?? "";
      const Hls = await loadHls();
      if (Hls?.isSupported()) {
        const player = new Hls({ capLevelToPlayerSize: true });
        player.loadSource(src);
        player.attachMedia(video);
      } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
        video.src = src;
      }
    }

    async function openVideo() {
      if (!dialog || !video) return;
      dialog.showModal();
      await attachStream();
      video.play().catch(() => {
        /* The browser blocked playback; the controls stay available. */
      });
    }

    function closeVideo() {
      dialog?.close();
    }

    document.querySelectorAll<HTMLElement>("[data-video-open]").forEach((button) => {
      button.addEventListener("click", openVideo);
      // Warm up the player on hover or touch, so playback starts straight away.
      button.addEventListener("pointerenter", loadHls, { once: true });
      button.addEventListener("touchstart", loadHls, { once: true, passive: true });
    });
    document.querySelector("[data-video-close]")?.addEventListener("click", closeVideo);

    // No "Save video as…" menu on the player.
    video?.addEventListener("contextmenu", (event) => event.preventDefault());

    // Close when clicking the dimmed area around the video.
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) closeVideo();
    });

    // Pause whenever the dialog closes, including with the Escape key.
    dialog?.addEventListener("close", () => video?.pause());
  </script>
</BaseLayout>
