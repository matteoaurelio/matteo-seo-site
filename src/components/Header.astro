---
const navLinks = [
  { href: "/about/", label: "About" },
  { href: "/#services", label: "Services" },
  { href: "/#tools", label: "Tools" },
  { href: "/#faq", label: "FAQ" },
  { href: "/blog/", label: "Blog" },
];

const aboutLinks = [
  {
    href: "/about/",
    label: "About Matteo Arellano",
  },
  {
    href: "/#process",
    label: "How I work",
  },
  {
    href: "/achievements/",
    label: "Achievements, recommendations & reviews",
  },
  {
    href: "https://lab.matteoarellano.com/",
    label: "Lab",
  },
];

const serviceLinks = [
  {
    href: "/#services",
    label: "Services overview",
  },
  {
    href: "/services/product-copy-landing-pages/",
    label: "Product copy and landing pages",
  },
  {
    href: "/services/large-scale-data-analysis/",
    label: "Large-scale data analysis",
  },
  {
    href: "/services/google-ads/",
    label: "Google Ads",
  },
];

const localServicesLinks = [
  {
    href: "/services/plumbing-hvac-revenue-leak-discovery/",
    label: "Plumbing & HVAC Revenue Leak Discovery",
  },
];

const currentPath = Astro.url.pathname;

const currentLanguage = currentPath.startsWith("/es/")
  ? "ES"
  : currentPath.startsWith("/nl/")
    ? "NL"
    : "EN";

const languageLinks = [
  { href: "/", label: "EN", name: "English" },
  { href: "/es/", label: "ES", name: "Español" },
  { href: "/nl/", label: "NL", name: "Nederlands" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Matteo Arellano homepage">
      <span class="brand-mark">MA</span>

      <span class="brand-copy">
        <strong>Matteo Arellano</strong>
        <small>Technical SEO & AI Visibility</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navLinks.map((link) => {
          if (link.label === "About") {
            return (
              <div class="nav-dropdown">
                <a class="nav-dropdown-trigger" href={link.href}>
                  {link.label}

                  <span aria-hidden="true">▾</span>
                </a>

                <div
                  class="nav-dropdown-menu"
                  aria-label="About Matteo Arellano submenu"
                >
                  {aboutLinks.map((aboutLink) => (
                    <a href={aboutLink.href}>{aboutLink.label}</a>
                  ))}
                </div>
              </div>
            );
          }

          if (link.label === "Services") {
            return (
              <div class="nav-dropdown">
                <a class="nav-dropdown-trigger" href={link.href}>
                  {link.label}

                  <span aria-hidden="true">▾</span>
                </a>

                <div class="nav-dropdown-menu" aria-label="Services submenu">
                  {serviceLinks.map((service) => (
                    <a href={service.href}>{service.label}</a>
                  ))}

                  <details class="panel-dropdown">
                    <summary class="panel-dropdown-summary">
                      <span class="panel-dropdown-label">
                        Local Services Ads
                      </span>

                      <span class="panel-dropdown-icon" aria-hidden="true">
                        <svg viewBox="0 0 20 20" focusable="false">
                          <path
                            d="M5 7.5L10 12.5L15 7.5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    </summary>

                    <div
                      class="panel-subnav"
                      aria-label="Local Services Ads submenu"
                    >
                      {localServicesLinks.map((service) => (
                        <a href={service.href}>{service.label}</a>
                      ))}
                    </div>
                  </details>
                </div>
              </div>
            );
          }

          return <a href={link.href}>{link.label}</a>;
        })
      }
    </nav>

    <div
      class="desktop-language language-switcher"
      aria-label="Language selector"
    >
      <span class="language-label">Language</span>

      <div class="language-options">
        {
          languageLinks.map((language) => (
            <a
              href={language.href}
              class:list={[
                "language-link",
                currentLanguage === language.label && "is-active",
              ]}
              aria-label={`View site in ${language.name}`}
              aria-current={
                currentLanguage === language.label ? "page" : undefined
              }
            >
              {language.label}
            </a>
          ))
        }
      </div>
    </div>

    <a class="nav-audit header-cta" href="/free-visibility-check/#calendar">
      Book free SEO check
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      aria-label="Open navigation menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-panel" id="nav-panel">
      <nav class="panel-nav" aria-label="Collapsed navigation">
        {
          navLinks.map((link) => {
            if (link.label === "About") {
              return (
                <details class="panel-dropdown">
                  <summary class="panel-dropdown-summary">
                    <span class="panel-dropdown-label">{link.label}</span>

                    <span class="panel-dropdown-icon" aria-hidden="true">
                      <svg viewBox="0 0 20 20" focusable="false">
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  </summary>

                  <div
                    class="panel-subnav"
                    aria-label="About Matteo Arellano submenu"
                  >
                    {aboutLinks.map((aboutLink) => (
                      <a href={aboutLink.href}>{aboutLink.label}</a>
                    ))}
                  </div>
                </details>
              );
            }

            if (link.label === "Services") {
              return (
                <details class="panel-dropdown">
                  <summary class="panel-dropdown-summary">
                    <span class="panel-dropdown-label">{link.label}</span>

                    <span class="panel-dropdown-icon" aria-hidden="true">
                      <svg viewBox="0 0 20 20" focusable="false">
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  </summary>

                  <div class="panel-subnav" aria-label="Services submenu">
                    {serviceLinks.map((service) => (
                      <a href={service.href}>{service.label}</a>
                    ))}

                    <details class="panel-dropdown">
                      <summary class="panel-dropdown-summary">
                        <span class="panel-dropdown-label">
                          Local Services Ads
                        </span>

                        <span class="panel-dropdown-icon" aria-hidden="true">
                          <svg viewBox="0 0 20 20" focusable="false">
                            <path
                              d="M5 7.5L10 12.5L15 7.5"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2.2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </span>
                      </summary>

                      <div
                        class="panel-subnav"
                        aria-label="Local Services Ads submenu"
                      >
                        {localServicesLinks.map((service) => (
                          <a href={service.href}>{service.label}</a>
                        ))}
                      </div>
                    </details>
                  </div>
                </details>
              );
            }

            return <a href={link.href}>{link.label}</a>;
          })
        }
      </nav>

      <div
        class="panel-language language-switcher"
        aria-label="Language selector"
      >
        <span class="language-label">Language</span>

        <div class="language-options">
          {
            languageLinks.map((language) => (
              <a
                href={language.href}
                class:list={[
                  "language-link",
                  currentLanguage === language.label && "is-active",
                ]}
                aria-label={`View site in ${language.name}`}
                aria-current={
                  currentLanguage === language.label ? "page" : undefined
                }
              >
                {language.label}
              </a>
            ))
          }
        </div>
      </div>

      <a class="nav-audit panel-audit" href="/free-visibility-check/#calendar">
        Book free SEO check
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector(".nav-toggle");
  const panel = document.querySelector("#nav-panel");

  function closePanel() {
    if (!toggle || !panel) return;

    toggle.setAttribute("aria-expanded", "false");
    panel.classList.remove("is-open");
    document.body.classList.remove("nav-open");

    panel.querySelectorAll("details").forEach((details) => {
      details.removeAttribute("open");
    });
  }

  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";

      toggle.setAttribute("aria-expanded", String(!isOpen));
      panel.classList.toggle("is-open", !isOpen);
      document.body.classList.toggle("nav-open", !isOpen);

      if (isOpen) {
        panel.querySelectorAll("details").forEach((details) => {
          details.removeAttribute("open");
        });
      }
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closePanel);
    });
  }
</script>
