---
const serviceLinks = [
  {
    href: "/services/expansion-partnerships/",
    label: "Expansion & Partnerships",
  },
  {
    href: "/services/insights-commercial-analysis/",
    label: "Insights & Commercial Analysis",
  },
  {
    href: "/services/product-conversion/",
    label: "Product & Conversion",
  },
  {
    href: "/services/acquisition-visibility/",
    label: "Acquisition & Visibility",
  },
  {
    href: "/services/data-automation/",
    label: "Data & Automation",
  },
];

const currentPath = Astro.url.pathname;
const currentLanguage = currentPath.startsWith("/es/")
  ? "ES"
  : currentPath.startsWith("/nl/")
    ? "NL"
    : "EN";

const languageLinks = [
  { href: "/", label: "EN", name: "English" },
  { href: "/es/", label: "ES", name: "Español" },
  { href: "/nl/", label: "NL", name: "Nederlands" },
];

const talkHref = currentPath.startsWith("/services/") ? "#availability" : "/#availability";
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Matteo Arellano homepage">
      <span class="brand-mark">MA</span>
      <span class="brand-copy">
        <strong>Matteo Arellano</strong>
        <small>Technical Growth Partner</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <div class="nav-dropdown">
        <a class="nav-dropdown-trigger" href="/services/">
          Services <span aria-hidden="true">▾</span>
        </a>

        <div class="nav-dropdown-menu" aria-label="Services submenu">
          {serviceLinks.map((service) => (
            <a href={service.href}>{service.label}</a>
          ))}
          <a class="nav-menu-all" href="/services/">All services →</a>
        </div>
      </div>

      <a href="/insights/">Insights</a>
      <a href="/achievements/#recommendations">Recommendations</a>
      <a href="/about/">About</a>
    </nav>

    <div class="desktop-language language-switcher" aria-label="Language selector">
      <span class="language-label">Language</span>
      <div class="language-options">
        {languageLinks.map((language) => (
          <a
            href={language.href}
            class:list={["language-link", currentLanguage === language.label && "is-active"]}
            aria-label={`View site in ${language.name}`}
            aria-current={currentLanguage === language.label ? "page" : undefined}
          >
            {language.label}
          </a>
        ))}
      </div>
    </div>

    <a class="nav-audit header-cta" href={talkHref}>Let's talk</a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      aria-label="Open navigation menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-panel" id="nav-panel">
      <nav class="panel-nav" aria-label="Mobile navigation">
        <details class="panel-dropdown">
          <summary class="panel-dropdown-summary">
            <span class="panel-dropdown-label">Services</span>
            <span class="panel-dropdown-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false">
                <path
                  d="M5 7.5L10 12.5L15 7.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </summary>

          <div class="panel-subnav" aria-label="Services submenu">
            {serviceLinks.map((service) => (
              <a href={service.href}>{service.label}</a>
            ))}
            <a href="/services/">All services →</a>
          </div>
        </details>

        <a href="/insights/">Insights</a>
        <a href="/achievements/#recommendations">Recommendations</a>
        <a href="/about/">About</a>
      </nav>

      <div class="panel-language language-switcher" aria-label="Language selector">
        <span class="language-label">Language</span>
        <div class="language-options">
          {languageLinks.map((language) => (
            <a
              href={language.href}
              class:list={["language-link", currentLanguage === language.label && "is-active"]}
              aria-label={`View site in ${language.name}`}
              aria-current={currentLanguage === language.label ? "page" : undefined}
            >
              {language.label}
            </a>
          ))}
        </div>
      </div>

      <a class="nav-audit panel-audit" href={talkHref}>Let's talk</a>
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector(".nav-toggle");
  const panel = document.querySelector("#nav-panel");

  function closePanel() {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", "false");
    panel.classList.remove("is-open");
    document.body.classList.remove("nav-open");
    panel.querySelectorAll("details").forEach((details) => {
      details.removeAttribute("open");
    });
  }

  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      panel.classList.toggle("is-open", !isOpen);
      document.body.classList.toggle("nav-open", !isOpen);

      if (isOpen) {
        panel.querySelectorAll("details").forEach((details) => {
          details.removeAttribute("open");
        });
      }
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closePanel);
    });
  }
</script>
