---
/**
 * Site header in English, Spanish or Dutch. Pass `alternates` when the page
 * exists in other languages, so the language switcher keeps the reader on
 * the same page; otherwise it links to each language's homepage.
 */
import { getServices, pagesWithCalendar } from "../data/servicesI18n";
import {
  siteUi,
  languageLinks,
  homePath,
  aboutPath,
  servicesHubPath,
  recommendationsLink,
  type Lang,
} from "../data/siteUi";

interface Props {
  lang?: Lang;
  alternates?: Partial<Record<Lang, string>>;
}

const { lang = "en", alternates = {} } = Astro.props;
const ui = siteUi[lang];
const hub = servicesHubPath[lang];

const serviceLinks = getServices(lang).map((service) => ({
  href: service.path,
  label: service.name,
}));

const switcher = languageLinks.map((language) => ({
  ...language,
  href: alternates[language.lang] ?? homePath[language.lang],
}));

const currentPath = Astro.url.pathname;

// Pages with their own booking calendar link to it; every other page links
// to the calendar on the homepage in the same language.
const talkHref = pagesWithCalendar.includes(currentPath)
  ? "#availability"
  : `${homePath[lang]}#availability`;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={homePath[lang]} aria-label={ui.brandAria}>
      <span class="brand-mark">MA</span>
      <span class="brand-copy">
        <strong>Matteo Arellano</strong>
        <small>{ui.brandTag}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={ui.primaryNav}>
      <div class="nav-dropdown">
        <a class="nav-dropdown-trigger" href={hub}>
          {ui.services} <span aria-hidden="true">▾</span>
        </a>

        <div class="nav-dropdown-menu" aria-label={ui.servicesMenu}>
          {serviceLinks.map((service) => <a href={service.href}>{service.label}</a>)}
          <a class="nav-menu-all" href={hub}>{ui.allServices}</a>
        </div>
      </div>

      <a href="/insights/">{ui.insights}</a>
      <a href={recommendationsLink[lang]}>{ui.recommendations}</a>
      <a href={aboutPath[lang]}>{ui.about}</a>
    </nav>

    <div class="desktop-language language-switcher" aria-label={ui.languageSelector}>
      <span class="language-label">{ui.language}</span>
      <div class="language-options">
        {
          switcher.map((language) => (
            <a
              href={language.href}
              hreflang={language.lang}
              lang={language.lang}
              class:list={["language-link", lang === language.lang && "is-active"]}
              aria-label={ui.viewIn(language.lang)}
              aria-current={lang === language.lang ? "page" : undefined}
            >
              {language.label}
            </a>
          ))
        }
      </div>
    </div>

    <a class="nav-audit header-cta" href={talkHref}>{ui.talk}</a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      aria-label={ui.openMenu}
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-panel" id="nav-panel">
      <nav class="panel-nav" aria-label={ui.mobileNav}>
        <details class="panel-dropdown">
          <summary class="panel-dropdown-summary">
            <span class="panel-dropdown-label">{ui.services}</span>
            <span class="panel-dropdown-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false">
                <path
                  d="M5 7.5L10 12.5L15 7.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </summary>

          <div class="panel-subnav" aria-label={ui.servicesMenu}>
            {serviceLinks.map((service) => <a href={service.href}>{service.label}</a>)}
            <a href={hub}>{ui.allServices}</a>
          </div>
        </details>

        <a href="/insights/">{ui.insights}</a>
        <a href={recommendationsLink[lang]}>{ui.recommendations}</a>
        <a href={aboutPath[lang]}>{ui.about}</a>
      </nav>

      <div class="panel-language language-switcher" aria-label={ui.languageSelector}>
        <span class="language-label">{ui.language}</span>
        <div class="language-options">
          {
            switcher.map((language) => (
              <a
                href={language.href}
                hreflang={language.lang}
                lang={language.lang}
                class:list={["language-link", lang === language.lang && "is-active"]}
                aria-label={ui.viewIn(language.lang)}
                aria-current={lang === language.lang ? "page" : undefined}
              >
                {language.label}
              </a>
            ))
          }
        </div>
      </div>

      <a class="nav-audit panel-audit" href={talkHref}>{ui.talk}</a>
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector(".nav-toggle");
  const panel = document.querySelector("#nav-panel");

  function closePanel() {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", "false");
    panel.classList.remove("is-open");
    document.body.classList.remove("nav-open");
    panel.querySelectorAll("details").forEach((details) => {
      details.removeAttribute("open");
    });
  }

  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      panel.classList.toggle("is-open", !isOpen);
      document.body.classList.toggle("nav-open", !isOpen);

      if (isOpen) {
        panel.querySelectorAll("details").forEach((details) => {
          details.removeAttribute("open");
        });
      }
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closePanel);
    });
  }
</script>
