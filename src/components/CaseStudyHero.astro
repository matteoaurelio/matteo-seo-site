---
/**
 * Header for the case-study pages: a faded, calm photo with the title on
 * top. The photo is decorative (empty alt text) and is served in three
 * compressed WebP sizes: `${image}-768.webp`, `-1280.webp` and `-1920.webp`.
 * Payment case studies use the Lofoten coast; product research case studies
 * use the canal photo.
 */
interface Props {
  crumbLabel: string;
  crumbHref: string;
  title: string;
  titleId: string;
  variant?: "hub" | "article";
  /** Path prefix of the WebP set, without the size suffix. */
  image?: string;
  /** Intrinsic size of the 1920 px image. */
  imageHeight?: number;
}

const {
  crumbLabel,
  crumbHref,
  title,
  titleId,
  variant = "hub",
  image = "/images/case-studies/lofoten-coast",
  imageHeight = 1081,
} = Astro.props;
const base = image;
---

<section class:list={["cs-hero", variant === "article" && "cs-hero--article"]} aria-labelledby={titleId}>
  <div class="cs-hero-media" aria-hidden="true">
    <img
      src={`${base}-1280.webp`}
      srcset={`${base}-768.webp 768w, ${base}-1280.webp 1280w, ${base}-1920.webp 1920w`}
      sizes="100vw"
      width="1920"
      height={imageHeight}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="cs-hero-inner">
    <a class="cs-crumb" href={crumbHref}>{crumbLabel}</a>
    <h1 id={titleId}>{title}</h1>
    <span class="cs-rule" aria-hidden="true"></span>
    <div class="cs-pill"><slot /></div>
  </div>
</section>
